# Build settings shared by every machine. Machine-specific overrides go in
# .bazelrc.user (git-ignored); container cache paths are in tools/docker/container.bazelrc.

common --enable_platform_specific_config

build --cxxopt=-std=c++17 --host_cxxopt=-std=c++17
build --cxxopt=-Wall

# CUDA: one entry per GPU architecture listed in docs/machines.md.
build --@rules_cuda//cuda:archs=sm_89,sm_120
build --@rules_cuda//cuda:compiler=nvcc

# hololink receive path: GPUDirect (GPU VRAM) by default; hololink falls back to
# pinned host memory at runtime on GPUs without DMA-BUF support.
build --define=hololink_gpu_vram=on

# Targets that need the DA322/cameras or Lattice Radiant never build by default.
build --build_tag_filters=-requires-hw,-requires-radiant
test --test_tag_filters=-requires-hw,-requires-radiant
test --test_output=errors
test --test_env=HOLOSCAN_LIB_PATH=/opt/nvidia/holoscan/lib
test --test_env=NVIDIA_DRIVER_CAPABILITIES

# `--config=nogpu` for machines/CI without an NVIDIA GPU.
build:nogpu --build_tag_filters=-requires-hw,-requires-radiant,-requires-gpu
test:nogpu --test_tag_filters=-requires-hw,-requires-radiant,-requires-gpu

try-import %workspace%/.bazelrc.user
