# Tauro DA322 pin constraints (LFCPNX-100-9CBG256I).
# Sources: DA322 User Manual v1.6 (docs/hardware/da322.md) for J1A..J1D, I2C, CAM_EN, CAM_MCLK, J2, J4/J5,
# clocks; the DA326 reference design (@hsb_fpga fpga_cpnx.pdc) for SERDES, SFP_TX_DIS, control I2C,
# QSPI flash, RESET_N and the I/O types. Items marked VERIFY are unconfirmed on the DA322.

# Reset (pulled-up input; the reference board has a push button here)
ldc_set_location -site {H1} [get_ports RESET_N]
ldc_set_port -iobuf {PULLMODE=UP IO_TYPE=LVCMOS33} [get_ports RESET_N]

# 10G Ethernet SERDES + reference clock (Y4, 161.1328125 MHz LVDS)
ldc_set_location -site {D10} [get_ports ETH_REFCLK_P]
ldc_set_location -site {E10} [get_ports ETH_REFCLK_N]
ldc_set_location -site {C8}  [get_ports ETH_RXD_P]
ldc_set_location -site {B7}  [get_ports ETH_RXD_N]
ldc_set_location -site {A9}  [get_ports ETH_TXD_P]
ldc_set_location -site {A8}  [get_ports ETH_TXD_N]
# VERIFY on DA322: SFP TX_DISABLE ball taken from the DA326 reference
ldc_set_location -site {F9}  [get_ports SFP_TX_DIS]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports SFP_TX_DIS]

# MIPI CSI-2 ports. Radiant flattens the [3:0][3:0] data ports: DATA index = 4*camera + FPGA lane.
# FPGA lane order follows the DA326 reference for J1D (proven there): lane 0 = connector D2 pins,
# lane 1 = D1, lane 2 = D0, lane 3 = D3; the same pattern is applied to J1A/J1B/J1C (VERIFY: swapped
# lanes show up as scrambled images with correct CRCs).

# camera 0 = J1A (manual table)
ldc_set_location -site {P8} [get_ports {MIPI_CAM_CLK_P[0]}]
ldc_set_location -site {R8} [get_ports {MIPI_CAM_CLK_N[0]}]
ldc_set_location -site {P6} [get_ports {MIPI_CAM_DATA_P[0]}]
ldc_set_location -site {R6} [get_ports {MIPI_CAM_DATA_N[0]}]
ldc_set_location -site {T6} [get_ports {MIPI_CAM_DATA_P[1]}]
ldc_set_location -site {T5} [get_ports {MIPI_CAM_DATA_N[1]}]
ldc_set_location -site {T8} [get_ports {MIPI_CAM_DATA_P[2]}]
ldc_set_location -site {T7} [get_ports {MIPI_CAM_DATA_N[2]}]
ldc_set_location -site {M6} [get_ports {MIPI_CAM_DATA_P[3]}]
ldc_set_location -site {N6} [get_ports {MIPI_CAM_DATA_N[3]}]

# camera 1 = J1B (manual table). VERIFY: the DA326 reference has the clock on L3/L2 and a data lane on
# N2/P2 for its second port — the reverse of the manual.
ldc_set_location -site {N2} [get_ports {MIPI_CAM_CLK_P[1]}]
ldc_set_location -site {P2} [get_ports {MIPI_CAM_CLK_N[1]}]
ldc_set_location -site {L3} [get_ports {MIPI_CAM_DATA_P[4]}]
ldc_set_location -site {L2} [get_ports {MIPI_CAM_DATA_N[4]}]
ldc_set_location -site {M2} [get_ports {MIPI_CAM_DATA_P[5]}]
ldc_set_location -site {M1} [get_ports {MIPI_CAM_DATA_N[5]}]
ldc_set_location -site {P1} [get_ports {MIPI_CAM_DATA_P[6]}]
ldc_set_location -site {N1} [get_ports {MIPI_CAM_DATA_N[6]}]
ldc_set_location -site {L4} [get_ports {MIPI_CAM_DATA_P[7]}]
ldc_set_location -site {M4} [get_ports {MIPI_CAM_DATA_N[7]}]

# camera 2 = J1C (manual table)
ldc_set_location -site {R12} [get_ports {MIPI_CAM_CLK_P[2]}]
ldc_set_location -site {T12} [get_ports {MIPI_CAM_CLK_N[2]}]
ldc_set_location -site {R14} [get_ports {MIPI_CAM_DATA_P[8]}]
ldc_set_location -site {R13} [get_ports {MIPI_CAM_DATA_N[8]}]
ldc_set_location -site {N12} [get_ports {MIPI_CAM_DATA_P[9]}]
ldc_set_location -site {P12} [get_ports {MIPI_CAM_DATA_N[9]}]
ldc_set_location -site {N11} [get_ports {MIPI_CAM_DATA_P[10]}]
ldc_set_location -site {M11} [get_ports {MIPI_CAM_DATA_N[10]}]
ldc_set_location -site {T14} [get_ports {MIPI_CAM_DATA_P[11]}]
ldc_set_location -site {T13} [get_ports {MIPI_CAM_DATA_N[11]}]

# camera 3 = J1D (manual table; identical to the DA326 reference camera 0, including lane order)
ldc_set_location -site {L12} [get_ports {MIPI_CAM_CLK_P[3]}]
ldc_set_location -site {K12} [get_ports {MIPI_CAM_CLK_N[3]}]
ldc_set_location -site {K13} [get_ports {MIPI_CAM_DATA_P[12]}]
ldc_set_location -site {L13} [get_ports {MIPI_CAM_DATA_N[12]}]
ldc_set_location -site {K11} [get_ports {MIPI_CAM_DATA_P[13]}]
ldc_set_location -site {L11} [get_ports {MIPI_CAM_DATA_N[13]}]
ldc_set_location -site {L14} [get_ports {MIPI_CAM_DATA_P[14]}]
ldc_set_location -site {K14} [get_ports {MIPI_CAM_DATA_N[14]}]
ldc_set_location -site {K16} [get_ports {MIPI_CAM_DATA_P[15]}]
ldc_set_location -site {L16} [get_ports {MIPI_CAM_DATA_N[15]}]

# D-PHY I/O types (as in the reference: P side MIPI_DPHY, N side LVCMOS12H)
ldc_set_port -iobuf {IO_TYPE=MIPI_DPHY} [get_ports {MIPI_CAM_CLK_P[*]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS12H} [get_ports {MIPI_CAM_CLK_N[*]}]
ldc_set_port -iobuf {IO_TYPE=MIPI_DPHY} [get_ports {MIPI_CAM_DATA_P[*]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS12H} [get_ports {MIPI_CAM_DATA_N[*]}]

# I2C: control/EEPROM bus (VERIFY on DA322: from the DA326 reference) and the four camera buses (manual)
ldc_set_location -site {H7}  [get_ports CTRL_I2C_SDA]
ldc_set_location -site {H6}  [get_ports CTRL_I2C_SCL]
ldc_set_location -site {H9}  [get_ports {CAM_I2C_SDA[0]}]
ldc_set_location -site {H10} [get_ports {CAM_I2C_SCL[0]}]
ldc_set_location -site {G4}  [get_ports {CAM_I2C_SDA[1]}]
ldc_set_location -site {G3}  [get_ports {CAM_I2C_SCL[1]}]
ldc_set_location -site {H13} [get_ports {CAM_I2C_SDA[2]}]
ldc_set_location -site {H14} [get_ports {CAM_I2C_SCL[2]}]
ldc_set_location -site {D15} [get_ports {CAM_I2C_SDA[3]}]
ldc_set_location -site {D16} [get_ports {CAM_I2C_SCL[3]}]
ldc_set_port -iobuf {OPENDRAIN=ON} [get_ports CTRL_I2C_SDA]
ldc_set_port -iobuf {OPENDRAIN=ON} [get_ports CTRL_I2C_SCL]
ldc_set_port -iobuf {OPENDRAIN=ON} [get_ports {CAM_I2C_SDA[*]}]
ldc_set_port -iobuf {OPENDRAIN=ON} [get_ports {CAM_I2C_SCL[*]}]

# Camera enable (connector pin 17) and reference clock (pin 18, 2.8 V level shifted on the board)
ldc_set_location -site {F7} [get_ports {CAM_EN[0]}]
ldc_set_location -site {F6} [get_ports {CAM_EN[1]}]
ldc_set_location -site {E4} [get_ports {CAM_EN[2]}]
ldc_set_location -site {E3} [get_ports {CAM_EN[3]}]
ldc_set_location -site {H3} [get_ports {CAM_MCLK[0]}]
ldc_set_location -site {G2} [get_ports {CAM_MCLK[1]}]
ldc_set_location -site {J7} [get_ports {CAM_MCLK[2]}]
ldc_set_location -site {J5} [get_ports {CAM_MCLK[3]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {CAM_EN[*]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {CAM_MCLK[*]}]

# QSPI configuration flash (VERIFY on DA322: from the DA326 reference; the vendor OTA path programs it)
ldc_set_location -site {E5} [get_ports FLASH_SPI_MCSN]
ldc_set_location -site {E7} [get_ports FLASH_SPI_MSCK]
ldc_set_location -site {D5} [get_ports {FLASH_SPI_SDIO[0]}]
ldc_set_location -site {C2} [get_ports {FLASH_SPI_SDIO[1]}]
ldc_set_location -site {C1} [get_ports {FLASH_SPI_SDIO[2]}]
ldc_set_location -site {D4} [get_ports {FLASH_SPI_SDIO[3]}]

# MFP headers: GPIO[10:0] = J4 GPIO0..GPIO10, GPIO[11] = J5 GPIO11 (manual tables)
ldc_set_location -site {J9}  [get_ports {GPIO[0]}]
ldc_set_location -site {J8}  [get_ports {GPIO[1]}]
ldc_set_location -site {J4}  [get_ports {GPIO[2]}]
ldc_set_location -site {J3}  [get_ports {GPIO[3]}]
ldc_set_location -site {H4}  [get_ports {GPIO[4]}]
ldc_set_location -site {H2}  [get_ports {GPIO[5]}]
ldc_set_location -site {G5}  [get_ports {GPIO[6]}]
ldc_set_location -site {G6}  [get_ports {GPIO[7]}]
ldc_set_location -site {F2}  [get_ports {GPIO[8]}]
ldc_set_location -site {F3}  [get_ports {GPIO[9]}]
ldc_set_location -site {E6}  [get_ports {GPIO[10]}]
ldc_set_location -site {F11} [get_ports {GPIO[11]}]

# Bank voltages and configuration (from the reference)
ldc_set_sysconfig {CONFIGIO_VOLTAGE_BANK0=3.3 CONFIGIO_VOLTAGE_BANK1=3.3}
ldc_set_vcc -bank 0 3.3
ldc_set_vcc -bank 1 3.3
ldc_set_vcc -bank 2 3.3
ldc_set_vcc -bank 6 3.3
ldc_set_vcc -bank 7 3.3
ldc_set_sysconfig {JTAG_PORT=ENABLE CONFIGIO_VOLTAGE_BANK1=3.3 CONFIGIO_VOLTAGE_BANK0=3.3 PROGRAMN_PORT=ENABLE CONFIG_SECURE=OFF BOOTMODE=DUAL MASTER_SPI_PORT=DISABLE}
