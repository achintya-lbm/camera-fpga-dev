# -*- mode: bazel -*-
# hololink 2.7.0 (+ our DA322/compat and NVRTC patches) built from source. Mirrors the
# CMake targets under src/hololink/{core,common,sensors,operators,emulation}; Python
# bindings, tests, examples, the hololink_module framework and the tools directory are
# not built. Include root is `src` (`#include <hololink/core/hololink.hpp>`).
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

COPTS = [
    "-Wno-unused-parameter",
    "-Wno-deprecated-declarations",
]

# hololink::core — control plane (ECB/BOOTP), DataChannel, I2C/SPI/GPIO, metadata,
# packetizer programs, reactor. (The MPSB sensor code of 2.5.0-PB6 is gone upstream.)
# data_channel.hpp includes common/cuda_helper.hpp (header-only CUDA RAII types), which in
# turn includes core/nullable_pointer.hpp, so that header belongs to core here.
cc_library(
    name = "core",
    srcs = glob(["src/hololink/core/*.cpp"]),
    hdrs = glob(["src/hololink/core/*.hpp"]) + ["src/hololink/common/cuda_helper.hpp"],
    copts = COPTS,
    defines = ["FMT_HEADER_ONLY=1"],
    includes = ["src"],
    linkopts = ["-lpthread"],
    deps = [
        "@cuda",  # data_channel.hpp: <cuda.h>; cuda_helper.hpp: <vector_types.h>
        "@fmt",
        "@nvtx3",  # nvtx_trace.hpp
    ],
)

# hololink::sensor (Leopard I2C expander helper) and the camera sensor base classes.
cc_library(
    name = "sensor",
    srcs = ["src/hololink/sensors/li_i2c_expander.cpp"],
    hdrs = [
        "src/hololink/sensors/li_i2c_expander.hpp",
        "src/hololink/sensors/sensor.hpp",
    ],
    copts = COPTS,
    deps = [":core"],
)

cc_library(
    name = "camera_sensor",
    srcs = [
        "src/hololink/sensors/camera/camera_mode.cpp",
        "src/hololink/sensors/camera/camera_sensor.cpp",
    ],
    hdrs = [
        "src/hololink/sensors/camera/camera_mode.hpp",
        "src/hololink/sensors/camera/camera_sensor.hpp",
    ],
    copts = COPTS,
    deps = [":sensor"],
)

# Upstream reference driver (kept as the template our IMX676 driver follows).
cc_library(
    name = "native_imx274_camera_sensor",
    srcs = [
        "src/hololink/sensors/camera/imx274/imx274_mode.cpp",
        "src/hololink/sensors/camera/imx274/native_imx274_sensor.cpp",
    ],
    hdrs = glob(["src/hololink/sensors/camera/imx274/*.hpp"]),
    copts = COPTS,
    deps = [":camera_sensor"],
)

# hololink::common — NVRTC kernel launcher, CLI arg helper, ibverbs device listing,
# Holoviz/ImGui renderer helper. HAS_IBVERBS enables infiniband_devices() (tools.cpp),
# as HOLOLINK_BUILD_ROCE does in CMake.
cc_library(
    name = "common",
    srcs = glob(["src/hololink/common/*.cpp"]),
    # cuda_error.hpp (cuFFT/NVRTC error helpers) is only used by the signal-processing
    # operators we do not build.
    hdrs = glob(
        ["src/hololink/common/*.hpp"],
        exclude = ["src/hololink/common/cuda_error.hpp"],
    ),
    copts = COPTS,
    local_defines = ["HAS_IBVERBS=1"],
    deps = [
        ":core",
        "@cuda",
        "@cuda//:cuda_runtime",
        "@cuda//:nvrtc",
        "@cuda//:nvrtc_builtins",  # dlopen()ed by libnvrtc when CsiToBayerOp JIT-compiles
        "@holoscan_sdk//:holoscan",
        "@holoscan_sdk//:viz",
        "@imgui",
        "@nvtx3",
        "@rdma_core//:ibverbs",
    ],
)

cc_library(
    name = "base_receiver_op",
    srcs = ["src/hololink/operators/base_receiver_op.cpp"],
    hdrs = ["src/hololink/operators/base_receiver_op.hpp"],
    copts = COPTS,
    deps = [
        ":common",
        ":sensor",
        "@cuda",
        "@holoscan_sdk//:holoscan",
    ],
)

# Plain-UDP receiver. HOLOLINK_HAVE_IBV_OPCODE (set by CMake for RoCE-enabled builds)
# makes it decode the RoCE opcode names from <infiniband/opcode.h>.
cc_library(
    name = "linux_receiver",
    srcs = ["src/hololink/operators/linux_receiver/linux_receiver.cpp"],
    hdrs = ["src/hololink/operators/linux_receiver/linux_receiver.hpp"],
    copts = COPTS,
    local_defines = ["HOLOLINK_HAVE_IBV_OPCODE=1"],
    deps = [
        ":base_receiver_op",
        ":core",
        "@cuda",
        "@rdma_core//:ibverbs_headers",
    ],
)

cc_library(
    name = "linux_receiver_op",
    srcs = ["src/hololink/operators/linux_receiver/linux_receiver_op.cpp"],
    hdrs = ["src/hololink/operators/linux_receiver/linux_receiver_op.hpp"],
    copts = COPTS,
    deps = [
        ":base_receiver_op",
        ":core",
        ":linux_receiver",
        "@cuda",
    ],
)

# RoCE v2 receiver (ConnectX). Links the host's libibverbs.so.1.
cc_library(
    name = "roce_receiver",
    srcs = [
        "src/hololink/operators/roce_receiver/roce_receiver.cpp",
        "src/hololink/operators/roce_receiver/roce_receiver_op.cpp",
    ],
    hdrs = glob(["src/hololink/operators/roce_receiver/*.hpp"]),
    copts = COPTS,
    deps = [
        ":base_receiver_op",
        ":core",
        "@cuda",
        "@rdma_core//:ibverbs",
    ],
)

cc_library(
    name = "csi_to_bayer",
    srcs = ["src/hololink/operators/csi_to_bayer/csi_to_bayer.cpp"],
    hdrs = ["src/hololink/operators/csi_to_bayer/csi_to_bayer.hpp"],
    copts = COPTS,
    deps = [
        ":common",
        "@holoscan_sdk//:holoscan",
    ],
)

cc_library(
    name = "image_processor",
    srcs = ["src/hololink/operators/image_processor/image_processor.cpp"],
    hdrs = ["src/hololink/operators/image_processor/image_processor.hpp"],
    copts = COPTS,
    deps = [
        ":core",
        ":csi_to_bayer",
        "@holoscan_sdk//:holoscan",
    ],
)

cc_library(
    name = "packed_format_converter",
    srcs = ["src/hololink/operators/packed_format_converter/packed_format_converter.cpp"],
    hdrs = ["src/hololink/operators/packed_format_converter/packed_format_converter.hpp"],
    copts = COPTS,
    deps = [
        ":common",
        "@holoscan_sdk//:holoscan",
    ],
)

# ---------------------------------------------------------------------------
# HSB emulator: a software Hololink device (BOOTP/ECB control plane, I2C peripherals,
# RoCEv2-format UDP and COE data planes). Used for no-FPGA tests (apps/emu_source).
# Upstream splits it into emulation_common (src/common), emulation_host (src/linux)
# and the roce/coe transport libraries; here one target with the Linux platform.
# SEPARATE_FRAMEMETADATA_PACKET=0 is cmake/targets/linux.cmake's default (frame
# metadata embedded in the last payload packet, like the FPGA).
# ---------------------------------------------------------------------------
EMULATION = "src/hololink/emulation"

cc_library(
    name = "emulation",
    srcs = glob([
        EMULATION + "/src/common/*.cpp",
        EMULATION + "/src/linux/*.cpp",
    ]),
    hdrs = glob([
        EMULATION + "/*.hpp",
        EMULATION + "/src/common/*.hpp",
        EMULATION + "/src/linux/*.hpp",
    ]),
    copts = COPTS + ["-Wno-missing-field-initializers"],
    # Order matters (as in upstream's target_include_directories): the platform directory
    # comes first so that `#include "net.hpp"` from src/common picks src/linux/net.hpp, which
    # layers the platform types over the public emulation/net.hpp.
    includes = [
        EMULATION + "/src/linux",
        EMULATION + "/src/common",
        EMULATION + "/src",
        EMULATION,
        "src/hololink",
        "src",
    ],
    local_defines = ["SEPARATE_FRAMEMETADATA_PACKET=0"],
    deps = [
        ":core",
        "@cuda//:cuda_runtime",  # DataPlane::send(DLTensor) bounces GPU tensors through host memory
        "@dlpack",
        "@zlib",  # RoCEv2 transmitter iCRC
    ],
)

# Upstream's emulated sensors (IMX274, VB1940, test pattern), for reference/tests.
cc_library(
    name = "emulation_sensors",
    srcs = glob([EMULATION + "/sensors/*.cpp"]),
    hdrs = glob([EMULATION + "/sensors/*.hpp"]),
    copts = COPTS,
    deps = [":emulation"],
)
