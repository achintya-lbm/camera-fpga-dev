Let HOLOLINK_NVRTC_INCLUDE_PATHS (colon separated) override the hard-coded /usr/local/cuda
include directories used when NVRTC JIT-compiles the operator kernels, so hermetic builds can
point at the CUDA headers they ship.

diff --git a/src/hololink/common/cuda_helper.cpp b/src/hololink/common/cuda_helper.cpp
index fbcc7ad..12f51ae 100644
--- a/src/hololink/common/cuda_helper.cpp
+++ b/src/hololink/common/cuda_helper.cpp
@@ -17,6 +17,7 @@
 
 #include "cuda_helper.hpp"
 
+#include <cstdlib>
 #include <memory>
 
 #include <nvrtc.h>
@@ -52,8 +53,29 @@ CudaFunctionLauncher::CudaFunctionLauncher(const char* source,
     for (auto&& option : options) {
         compile_options.push_back(option.c_str());
     }
-    compile_options.push_back("--include-path=/usr/local/cuda/include");
-    compile_options.push_back("--include-path=/usr/local/cuda/include/cccl");
+    // CUDA headers for the JIT-compiled kernels: HOLOLINK_NVRTC_INCLUDE_PATHS (colon separated)
+    // overrides the default toolkit location, e.g. for hermetic builds without /usr/local/cuda.
+    std::vector<std::string> include_options;
+    if (const char* env_paths = std::getenv("HOLOLINK_NVRTC_INCLUDE_PATHS"); env_paths && *env_paths) {
+        std::string paths(env_paths);
+        size_t start = 0;
+        while (start <= paths.size()) {
+            size_t end = paths.find(':', start);
+            if (end == std::string::npos) {
+                end = paths.size();
+            }
+            if (end > start) {
+                include_options.push_back("--include-path=" + paths.substr(start, end - start));
+            }
+            start = end + 1;
+        }
+    } else {
+        include_options.push_back("--include-path=/usr/local/cuda/include");
+        include_options.push_back("--include-path=/usr/local/cuda/include/cccl");
+    }
+    for (auto&& option : include_options) {
+        compile_options.push_back(option.c_str());
+    }
     if (nvrtcCompileProgram(prog, compile_options.size(), compile_options.data()) != NVRTC_SUCCESS) {
         // Obtain compilation log from the program.
         size_t logSize;
