+import argparse
+import logging
+import os
+import time
+
+import holoscan
+
+import hololink as hololink_module
+
+import boards
+
+# dictionary for print beautification
+DIR_OUT = 0
+DIR_IN = 1
+pin_dir = {DIR_OUT: "output", DIR_IN: "input"}
+
+# GPIO states
+LOW = 0
+HIGH = 1
+
+# GPIO mapping
+GPIO_PHY_MDIO          = 0
+GPIO_PHY_MDC           = 1
+GPIO_CAM0_PWR_EN_L     = 2
+GPIO_CAM1_PWR_EN_L     = 3
+GPIO_CAM2_PWR_EN_L     = 4
+GPIO_CAM3_PWR_EN_L     = 5
+GPIO_I2C_MUX           = 6
+
+GPIO_PIN_MAP = {
+    boards.BOARD_NAME_TT_DA320: {
+        GPIO_PHY_MDIO      : 0,
+        GPIO_PHY_MDC       : 1,
+        GPIO_CAM0_PWR_EN_L : 2,
+        GPIO_I2C_MUX       : 3,
+    },
+    boards.BOARD_NAME_TT_DA322: {
+        GPIO_CAM0_PWR_EN_L : 0,
+        GPIO_CAM1_PWR_EN_L : 1,
+        GPIO_CAM2_PWR_EN_L : 2,
+        GPIO_CAM3_PWR_EN_L : 3,
+    },
+    boards.BOARD_NAME_TT_DA326: {
+        GPIO_CAM0_PWR_EN_L : 0,
+    }
+}
+
+
+def set_gpio(_GPIO, pin, direction, value):
+    _GPIO.set_direction(pin, _GPIO.OUT if direction == DIR_OUT else _GPIO.IN)
+    if direction == DIR_OUT:
+        _GPIO.set_value(pin, _GPIO.HIGH if value == HIGH else _GPIO.LOW)
+        logging.info(f"SET - pin:{pin}, direction:{pin_dir[direction]},value:{value}")
+    else:
+        logging.info(f"SET - pin:{pin}, direction:{pin_dir[direction]}")
+
+def get_gpio(_GPIO, pin):
+    direction = _GPIO.get_direction(pin)
+    value = _GPIO.get_value(pin)
+    logging.info(f"GET - pin:{pin}, direction:{pin_dir[direction]},value:{value}")
+
+def main():
+    parser = argparse.ArgumentParser()
+
+    parser.add_argument(
+        "pin",
+        type=int,
+        help="GPIO pin",
+    )
+    parser.add_argument(
+        "--set",
+        choices=("in", "low", "high"),
+        default=None,
+        help="Set GPIO value",
+    )
+    parser.add_argument(
+        "--get",
+        action="store_true",
+        help="Get GPIO value",
+    )
+    parser.add_argument(
+        "--hololink",
+        default="192.168.0.2",
+        help="IP address of Hololink board",
+    )
+    parser.add_argument(
+        "--reset",
+        action="store_true",
+        help="Reset the hololink before action",
+    )
+    parser.add_argument(
+        "--log-level",
+        type=int,
+        default=20,
+        help="Logging level to display",
+    )
+
+    args = parser.parse_args()
+    hololink_module.logging_level(args.log_level)
+    logging.info("Initializing.")
+
+    # Get a handle to the Hololink device
+    channel_metadata = hololink_module.Enumerator.find_channel(channel_ip=args.hololink)
+    hololink_channel = hololink_module.DataChannel(channel_metadata)
+
+    hololink = hololink_channel.hololink()
+    hololink.start()
+    if args.reset:
+        hololink.reset()
+    _GPIO = hololink.get_gpio(channel_metadata)
+    if args.set is not None:
+        set_gpio(_GPIO, args.pin, DIR_IN if args.set == "in" else DIR_OUT, LOW if args.set == "low" else HIGH)
+    if args.get:
+        val = get_gpio(_GPIO, args.pin)
+    hololink.stop()
+
+
+if __name__ == "__main__":
+    main()
