diff --git a/examples/boards.py b/examples/boards.py
new file mode 100644
index 0000000..116e858
--- /dev/null
+++ b/examples/boards.py
@@ -0,0 +1,73 @@
+from dataclasses import dataclass
+import hololink as hololink_module
+from types import MappingProxyType
+
+BOARD_NAME_TT_DA320 = "TauroTech DA320"
+
+BOARD_NAME_TT_DA322 = "TauroTech DA322"
+
+BOARD_NAME_TT_DA326 = "TauroTech DA326"
+
+@dataclass(frozen=True)
+class Board:
+    name: str
+    reg_data_format: int = 0x70000004
+    mipi_ip_core_base: int = 0x30000000
+    reg_mipi_lane_cnt: int = (0x0A * 4)
+    i2c_count: int = 1
+    data_type_map: MappingProxyType = MappingProxyType ({
+        hololink_module.sensors.csi.PixelFormat.RAW_8:  0x2a,
+        hololink_module.sensors.csi.PixelFormat.RAW_10: 0x2b,
+        hololink_module.sensors.csi.PixelFormat.RAW_12: 0x2c,
+        "rgb888": 0x24,
+    })
+
+BOARDS = {
+    BOARD_NAME_TT_DA320: Board(
+        BOARD_NAME_TT_DA320,
+        i2c_count = 2,
+    ),
+    BOARD_NAME_TT_DA322: Board(
+        BOARD_NAME_TT_DA322,
+        i2c_count = 4,
+    ),
+    BOARD_NAME_TT_DA326: Board(
+        BOARD_NAME_TT_DA326,
+        i2c_count = 1
+    ),
+}
+
+def configure_fpga_datatype(hololink_channel, board_name, mipi_id, pixel_format):
+    """Configure the right pixel format in FPGA"""
+    board = BOARDS.get(board_name)
+    if board is None:
+        logging.error(f"Unsupported board: {board_name}")
+        return
+    reg = board.reg_data_format
+    val = board.data_type_map.get(pixel_format)
+    if reg is None or val is None:
+        logging.error(f"Pixel format {pixel_format} not supported on {board_name}")
+        return
+    hololink = hololink_channel.hololink()
+    current_config = hololink.read_uint32(reg)
+    offset = (8 * mipi_id)
+    mask = ~(0xff << offset)
+    val = val << offset
+    config = (current_config & mask) | val
+    hololink.write_uint32(reg, config)
+
+def configure_fpga_mipi_lanes(hololink_channel, board_name, mipi_id, num_lanes):
+    # Configure MIPI lane mode
+    board = BOARDS.get(board_name)
+    if board is None:
+        logging.error(f"Unsupported board: {board_name}")
+        return
+    reg_base = board.mipi_ip_core_base
+    reg_offset = board.reg_mipi_lane_cnt
+    val = ((num_lanes - 1) << 1)
+    if reg_base is None or val is None:
+        logging.error(f"MIPI lanes {num_lanes} not supported on {board_name}")
+        return
+    hololink = hololink_channel.hololink()
+    reg = reg_base | (mipi_id << 12) | reg_offset
+    hololink.write_uint32(reg, val)
diff --git a/examples/fusa_coe_ar0234_player.py b/examples/fusa_coe_ar0234_player.py
