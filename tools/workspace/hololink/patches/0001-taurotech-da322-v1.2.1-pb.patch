+
+imx_frame_format = []
+imx_frame_format.insert(
+    ArducamB0353_Mode.ARDUCAM_B0353_MODE_1920X1200_60FPS.value,
+    frame_format(1920, 1200, 60, hololink.sensors.csi.PixelFormat.RAW_10),
+)
+
+imx_frame_format.insert(
+    ArducamB0353_Mode.ARDUCAM_B0353_MODE_1920X1080_60FPS.value,
+    frame_format(1920, 1080, 60, hololink.sensors.csi.PixelFormat.RAW_10),
+)
+
+imx_frame_format.insert(
+    ArducamB0353_Mode.ARDUCAM_B0353_MODE_1280X720_120FPS.value,
+    frame_format(1280, 720, 120, hololink.sensors.csi.PixelFormat.RAW_10),
+)
+
+# values are on hex number system to be consistent with rest of the list
+ARDUCAM_B0353_TABLE_WAIT_MS = "arducam-b0353-table-wait-ms"
+ARDUCAM_B0353_WAIT_MS = 0x01
+
+arducam_b0353_start = [
+        (MODE_SELECT_REG, ARDUCAM_MODE_STREAMING),
