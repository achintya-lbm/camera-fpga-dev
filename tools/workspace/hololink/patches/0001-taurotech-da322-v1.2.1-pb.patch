+// Boston Dynamics, Inc. Confidential Information.
+// Copyright 2025. All Rights Reserved.
+#include <cstdint>
+#include <hololink/core/hololink.hpp>
+#include <memory>
+#include <vector>
+
+extern "C" {
+#include "vl53l8cx_api.h"
+}
+
+/**
+ * Creates the DtofCtrl class to manage the DToF sensor independent of the caller.
+ * Currently returns DtofFrame and supports parsing a byte vector into a DtofFrame.
+ * Will be refactored later.
+ */
+namespace hololink::core {
+
+struct DtofFrame {
+    VL53L8CX_ResultsData results;
+};
+
+/**
+ * Manages the state and operations for a VL53L8CX DToF sensor.
+ * This class encapsulates the sensor's configuration and provides methods
+ * for initialization, starting/stopping ranging, and capturing frames.
+ * Current implementation of get_frame returns a DtofFrame, to be refactored
+ * when DMA via FPGA is available.
+ */
+class DtofCtrl {
+ public:
+    /**
+     * Constructs a DtofCtrl instance. Stores shared ptr for i2c and sets debug level
+     */
+    DtofCtrl(std::shared_ptr<hololink::Hololink::I2c> i2c, bool debug);
+
+    /**
+     * Initializes the DToF sensor hardware and firmware.
+     */
+    bool init();
+
+    /**
+     * Starts the ranging operation on the sensor.
+     */
+    bool start();
+
+    /**
+     * Stops the ranging operation on the sensor.
+     */
+    bool stop();
+
+    /**
+     * Waits for a new frame from the sensor and updates the internal frame buffer.
+     * This function should always be called before get_frame() to ensure fresh data.
+     */
+    bool wait_for_next_frame();
+
+    /**
+     * Gets the most recently captured DToF frame.
+     */
+    const DtofFrame& get_frame();
+
+    /**
+     * Parses the provided raw data into a DtofFrame object. To be used by DMA logic.
+     */
+    DtofFrame parse_frame(const std::vector<uint8_t>& raw_data);
+
+ private:
+    std::shared_ptr<hololink::Hololink::I2c> m_i2c;
+    VL53L8CX_Configuration m_dtof_dev;
+    DtofFrame m_cur_dtof_frame;
+    bool m_debug;
+};
+
+}  // namespace hololink::core
diff --git a/src/hololink/core/mpsb/dtof/platform.cpp b/src/hololink/core/mpsb/dtof/platform.cpp
new file mode 100644
index 0000000..d4ca8cd
--- /dev/null
+++ b/src/hololink/core/mpsb/dtof/platform.cpp
@@ -0,0 +1,177 @@
+// Boston Dynamics, Inc. Confidential Information.
+// Copyright 2025. All Rights Reserved.
+#include "platform.h"
+// #include <fmt/core.h>
+#include <string.h>
+#include <unistd.h>
+#include <chrono>
+#include <cstdint>
+#include <hololink/core/hololink.hpp>
+#include <hololink/core/serializer.hpp>
+#include <vector>
+
+const uint8_t hololink_max_buf_size = 98;  // Max Hololink Serializer backend buffer size
+static bool i2c_reg_write_read_debug = false;
+
+extern "C" {
+
+void set_debug_state(bool debug_en) { i2c_reg_write_read_debug = debug_en; }
+
+uint8_t VL53L8CX_WrByte(VL53L8CX_Platform* p_platform, uint16_t reg_addr, uint8_t val) {
+    auto i2c = reinterpret_cast<hololink::Hololink::I2c*>(p_platform->hololink_i2c);
+    if (!i2c) {
+        return NO_I2C;
+    }
+    if (i2c_reg_write_read_debug) {
+        printf("Writing byte %02X to reg %04X at addr %02X. \n", val, reg_addr,
+                   p_platform->address);
+    }
+    std::vector<uint8_t> write_bytes(3);
+    hololink::core::Serializer serializer(write_bytes.data(), write_bytes.size());
+    serializer.append_uint16_be(reg_addr);
+    serializer.append_uint8(val);
+    i2c->i2c_transaction(p_platform->address, write_bytes, 0);
+    return SUCCESS;
+}
+
+uint8_t Ser_WrByte(VL53L8CX_Platform* p_platform, uint16_t reg_addr, uint8_t val) {
+    auto i2c = reinterpret_cast<hololink::Hololink::I2c*>(p_platform->hololink_i2c);
+    if (!i2c) {
+        return NO_I2C;
+    }
+    if (i2c_reg_write_read_debug) {
+        printf("Writing byte %02X to ser reg %04X at addr %02X. \n", val, reg_addr,
+                   p_platform->address);
+    }
+    std::vector<uint8_t> write_bytes(3);
+    hololink::core::Serializer serializer(write_bytes.data(), write_bytes.size());
+    serializer.append_uint16_be(reg_addr);
+    serializer.append_uint8(val);
+    i2c->i2c_transaction(p_platform->ser_addr, write_bytes, 0);
+    return SUCCESS;
+}
+
+uint8_t VL53L8CX_RdByte(VL53L8CX_Platform* p_platform, uint16_t reg_addr, uint8_t* p_val) {
+    auto i2c = reinterpret_cast<hololink::Hololink::I2c*>(p_platform->hololink_i2c);
+    if (!i2c) {
+        return NO_I2C;
+    }
+    std::vector<uint8_t> write_bytes(2);
+    hololink::core::Serializer serializer(write_bytes.data(), write_bytes.size());
+    serializer.append_uint16_be(reg_addr);
+    std::vector<uint8_t> read_bytes = i2c->i2c_transaction(p_platform->address, write_bytes, 1);
+    *p_val = read_bytes[0];
+    if (i2c_reg_write_read_debug) {
+        printf("Read byte %02X from reg %04X at addr %02X. \n", *p_val, reg_addr,
+                   p_platform->address);
+    }
+    return SUCCESS;
+}
+
+uint8_t VL53L8CX_WrMulti(VL53L8CX_Platform* p_platform, uint16_t reg_addr, uint8_t* p_vals,
+                         uint32_t size) {
+    auto i2c = reinterpret_cast<hololink::Hololink::I2c*>(p_platform->hololink_i2c);
+    if (!i2c) {
+        return NO_I2C;
+    }
+    const uint32_t max_chunk_size = hololink_max_buf_size - 2;  // leaving 2 bytes for address
+    uint32_t bytes_written = 0;
+
+    while (bytes_written < size) {
+        uint32_t chunk_size = std::min(size - bytes_written, max_chunk_size);
+        uint16_t current_reg_addr = reg_addr + bytes_written;
+
+        if (i2c_reg_write_read_debug) {
+            std::string bytes_str;
+            for (uint32_t i = 0; i < chunk_size; ++i) {
+                char buf[5];
+                sprintf(buf, "%02X ", p_vals[bytes_written + i]);
+                bytes_str += buf;
+                // bytes_str += fmt::format("%02X ", p_vals[bytes_written + i]);
+            }
+            printf("Writing byte string to reg %04X at addr %02X. Data: [ %s]\n",
+                       current_reg_addr, p_platform->address, bytes_str.c_str());
+        }
+
+        std::vector<uint8_t> write_bytes(2 + chunk_size);
+        hololink::core::Serializer serializer(write_bytes.data(), write_bytes.size());
+        serializer.append_uint16_be(current_reg_addr);
+        serializer.append_buffer(p_vals + bytes_written, chunk_size);
+        i2c->i2c_transaction(p_platform->address, write_bytes, 0);
+
+        bytes_written += chunk_size;
+    }
+    return SUCCESS;
+}
+
+uint8_t VL53L8CX_RdMulti(VL53L8CX_Platform* p_platform, uint16_t reg_addr, uint8_t* p_vals,
+                         uint32_t size) {
+    auto i2c = reinterpret_cast<hololink::Hololink::I2c*>(p_platform->hololink_i2c);
+    if (!i2c) {
+        return NO_I2C;
+    }
+    const uint32_t max_chunk_size = hololink_max_buf_size;
+    uint32_t bytes_read = 0;
+    if (i2c_reg_write_read_debug) {
+        printf("Read byte string from reg %02X at addr %02X of length %08X. \n", reg_addr,
+                   p_platform->address, size);
+    }
+
+    while (bytes_read < size) {
+        uint32_t chunk_size = std::min(size - bytes_read, max_chunk_size);
+        uint16_t current_reg_addr = reg_addr + bytes_read;
+
+        std::vector<uint8_t> write_bytes(2);
+        hololink::core::Serializer serializer(write_bytes.data(), write_bytes.size());
+        serializer.append_uint16_be(current_reg_addr);
+
+        std::vector<uint8_t> read_chunk =
+            i2c->i2c_transaction(p_platform->address, write_bytes, chunk_size);
+        if (read_chunk.size() != chunk_size) {
+            return MISMATCHED_READ_SIZE;
+        }
+        memcpy(p_vals + bytes_read, read_chunk.data(), chunk_size);
+
+        if (i2c_reg_write_read_debug) {
+            std::string bytes_str;
+            for (uint32_t i = 0; i < chunk_size; ++i) {
+                char buf[5];
+                sprintf(buf, "%02X ", p_vals[bytes_read + i]);
+                bytes_str += buf;
+            }
+            printf("Read byte string from reg %04X at addr %02X. Data: [ %s]\n",
+                       current_reg_addr, p_platform->address, bytes_str.c_str());
+        }
+
+        bytes_read += chunk_size;
+    }
+    return SUCCESS;
+}
+
+uint8_t VL53L8CX_Reset_Sensor(VL53L8CX_Platform* p_platform) {
+    auto i2c = reinterpret_cast<hololink::Hololink::I2c*>(p_platform->hololink_i2c);
+    if (!i2c) {
+        return NO_I2C;
+    }
+    Ser_WrByte(p_platform, 0x02E5, 0x80);
+    Ser_WrByte(p_platform, 0x02E5, 0x90);
+    VL53L8CX_WaitMs(p_platform, 500);
+    Ser_WrByte(p_platform, 0x02E5, 0x80);
+    VL53L8CX_WaitMs(p_platform, 500);
+    return SUCCESS;
+}
+
+void VL53L8CX_SwapBuffer(uint8_t* buffer, uint16_t size) {
+    uint32_t i, tmp;
+    for (i = 0; i < size; i = i + 4) {
+        tmp = (buffer[i] << 24) | (buffer[i + 1] << 16) | (buffer[i + 2] << 8) | (buffer[i + 3]);
+        memcpy(&(buffer[i]), &tmp, 4);
+    }
+}
+
+uint8_t VL53L8CX_WaitMs(VL53L8CX_Platform* p_platform, uint32_t TimeMs) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(TimeMs));
+    return SUCCESS;
+}
+
+}  // extern "C"
