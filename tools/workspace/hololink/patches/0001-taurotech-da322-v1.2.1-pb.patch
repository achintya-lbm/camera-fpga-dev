--- /dev/null
+++ b/python/hololink/sensors/utils.py
@@ -0,0 +1,47 @@
+import time
+import threading
+
+class DelayedWork:
+    def __init__(self, callback):
+        self.callback = callback
+        self._timer = None
+        self._lock = threading.Lock()
+        self._running = False
+
+    def schedule(self, delay_sec):
+        with self._lock:
+            self._cancel_no_wait()
+            self._timer = threading.Timer(delay_sec, self._run)
+            self._timer.start()
+
+    def _run(self):
+        with self._lock:
+            self._running = True
+        try:
+            self.callback()
+        finally:
+            with self._lock:
+                self._running = False
+                self._timer = None
+
+    def cancel_sync(self):
+        """Equivalent to linux kernel cancel_delayed_work_sync."""
+        with self._lock:
+            # t = self._timer
+            running = self._running
+            self._cancel_no_wait()
+
+        if running:
+            # Wait for current callback to finish
+            while True:
+                with self._lock:
+                    if not self._running:
+                        break
+                time.sleep(0.001)
+
+        return True
+
+    def _cancel_no_wait(self):
+        if self._timer:
+            self._timer.cancel()
+            self._timer = None
