+
+import logging
+
+import hololink as hololink_module
+
+from . import imx477_mode
+
+# Camera info
+DRIVER_NAME = "IMX477"
+
+# Camera I2C address.
+CAM_I2C_ADDRESS = 0x1A
+
+I2C_RETRIES = 5
+
+class Imx477:
+    def __init__(
+        self,
+        hololink_channel,
+        i2c_bus=hololink_module.CAM_I2C_BUS,
+        i2c_id=0,
+        exposure=0xFF00,
+    ):
+        self._hololink = hololink_channel.hololink()
+        self._i2c_bus = hololink_module.CAM_I2C_BUS + i2c_id
+        self._mode = imx477_mode.imx_frame_format[imx477_mode.Imx477_Mode.IMX477_MODE_1920X1080.value]
+        self._i2c = self._hololink.get_i2c(self._i2c_bus)
+        self._exposure = exposure
+
+    def setup_clock(self):
+        # set the clock driver.
+        logging.debug("setup_clock")
+        self._hololink.setup_clock(
+            hololink_module.renesas_bajoran_lite_ts1.device_configuration()
+        )
+
+    def configure(self):
+        """ Read Chip id"""
+        logging.info("Configuring IMX477 on I2C bus %d" % self._i2c_bus)
+        chip_id = self.get_register(imx477_mode.IMX477_CHIP_ID_REG)
+        if chip_id != imx477_mode.IMX477_CHIP_ID:
+            raise RuntimeError(
+                "IMX477 not found on I2C bus %d. Read chip id 0x%X, expected 0x%X"
+                % (self._i2c_bus, chip_id, imx477_mode.IMX477_CHIP_ID)
+            )
+        else:
+            logging.info(
+                "IMX477 found on I2C bus %d. Read chip id 0x%X"
+                % (self._i2c_bus, chip_id)
+            )
+        for reg, val in imx477_mode.imx477_mode_common_regs:
+            self.set_register(reg, val, size=1)
+
+        for reg, val in self._mode.freq_regs:
+            self.set_register(reg, val, size=1)
+
+    def start(self):
+        """Start Streaming"""
+        logging.info("Start IMX477 streaming")
+
+        if self._mode is None:
+            logging.error("Cannot start IMX477 streaming. Mode is not set.")
+            return
+
+        for reg, val in self._mode.regs:
+            self.set_register(reg, val, size=1)
+
+        # Set on-sensor DPC.
+        self.set_register(imx477_mode.DPC_1_REG, imx477_mode.DPC_ON, size=1)
+        self.set_register(imx477_mode.DPC_2_REG, imx477_mode.DPC_ON, size=1)
+
+        self.set_register(imx477_mode.FRAME_LENGTH_REG, 0x895, size=2)
+
+        self.set_register(0x3100, 0x0, size=1)
+        self.set_register(0x342, 0x31C4, size=2)
+        self.set_register(0x202, 0x41, size=2)
+        self.set_register(0x204, 0x0, size=2)
+        self.set_register(0x20E, 0x100, size=2)
+        self.set_register(0x101, 0x0, size=1)
+
+        self.set_register(imx477_mode.MODE_SELECT_REG, imx477_mode.MODE_STREAMING, size=1)
+
+        # Streaming should start at this point
+
+        self.set_exposure_reg(self._exposure)
+
+    def stop(self):
+        """Stop Streaming"""
+        logging.info("Start IMX477 streaming")
+        self.set_register(0x100, 0x0)
+        self.set_register(0x4B81, 0x0)
+
+    def get_register(self, register, size=2):
+        logging.debug("get_register(register=%d(0x%X), size=%d)" % (register, register, size))
+        write_bytes = bytearray(100)
+        serializer = hololink_module.Serializer(write_bytes)
+        serializer.append_uint16_be(register)
+        read_byte_count = size
+        reply = self._i2c.i2c_transaction(
+            CAM_I2C_ADDRESS, write_bytes[: serializer.length()], read_byte_count
+        )
+        deserializer = hololink_module.Deserializer(reply)
+        r = 0
+        for i in range(size):
+            r |= deserializer.next_uint8() << ((size - i - 1) * 8)
+        logging.debug(
+            "get_register(register=%d(0x%X))=%d(0x%X)" % (register, register, r, r)
+        )
+        return r
+
+    def set_register(self, register, value, size=1, timeout=None):
+        logging.debug(
+            "set_register(register=%d(0x%X), value=%d(0x%X), size=%d)"
+            % (register, register, value, value, size)
+        )
+        write_bytes = bytearray(100)
+        serializer = hololink_module.Serializer(write_bytes)
+        serializer.append_uint16_be(register)
+        for i in range(size):
+            serializer.append_uint8((value >> ((size - i - 1) * 8)) & 0xFF)
+        read_byte_count = 0
+        self._i2c.i2c_transaction(
+            CAM_I2C_ADDRESS,
+            write_bytes[: serializer.length()],
+            read_byte_count,
+            timeout=timeout,
+        )
+
+    def set_mode(self, imx477_mode_set):
+        if imx477_mode_set.value < len(imx477_mode.Imx477_Mode):
+            self._mode = imx477_mode.imx_frame_format[imx477_mode_set.value]
+            self._height = self._mode.height
+            self._width = self._mode.width
+            self._pixel_format = self._mode.pixel_format
+        else:
+            logging.error("Incorrect mode for IMX477")
+            self._mode = None
+
+    def configure_converter(self, converter):
+        # where do we find the first received byte?
+        start_byte = converter.receiver_start_byte()
+        transmitted_line_bytes = converter.transmitted_line_bytes(
+            self._pixel_format, self._width
+        )
+        received_line_bytes = converter.received_line_bytes(transmitted_line_bytes)
+        converter.configure(
+            start_byte,
+            received_line_bytes,
+            self._width,
+            self._height,
+            self._pixel_format,
+        )
+
+    def pixel_format(self):
+        return self._pixel_format
+
+    def bayer_format(self):
+        return hololink_module.sensors.csi.BayerFormat.RGGB
+        # return hololink_module.sensors.csi.BayerFormat.BGGR
+
+    def set_analog_gain(self, value=0x33F):
+        """This function sets MSB (2 bits) and LSB (8 bits) of analog gain value registers 0x204 and 0x205 respectively"""
+        if value >= 1024 or value < 0:
+            logging.warn(f"AG value {value} should be in range 0 to 1023")
+            self.set_register(0x204, 0x3)
+            self.set_register(0x205, 0x3F)
+        else:
+            self.set_register(0x204, (value >> 8) & 3)
+            self.set_register(0x205, value & 0xFF)
+
+    def set_exposure_reg(self, value=0x05):
+        """
+        IMX477 has the minimum limit of 5 to be set for the exposure.
+        """
+        if value < 0x05:
+            logging.warn(f"Exposure value {value} is lower than the minimum.")
+            value = 0x05
+        self.set_register(imx477_mode.EXPOSURE_REG, value, size=2)
+
+    def set_digital_gain_reg(self, value=0x40):
+        if value < 0x40:
+            value = 0x40
+        elif value > 0xFFFF:
+            value = 0xFFFF
+        self.set_register(imx477_mode.DIGITAL_GAIN_REG, value)
+
+    def test_pattern(self):
+        self.set_register(imx477_mode.TEST_PATTERN_REG, imx477_mode.TEST_PATTERN_COLOR_BARS, size=2)
