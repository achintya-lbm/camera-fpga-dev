+import logging
+import time
+
+import hololink as hololink_module
+
+from . import arducam_b0353_mode
+
+ARDUCAM_B0353_I2C_ADDR = 0x0C
+
+class ArducamB0353():
+    def __init__(
+        self,
+        hololink_channel,
+        i2c_bus=hololink_module.CAM_I2C_BUS,
+        i2c_id=0,
+        skip_i2c=False,
+    ):
+        self._i2c_bus = i2c_bus + i2c_id
+        self._i2c_addr = ARDUCAM_B0353_I2C_ADDR
+        self._hololink = hololink_channel.hololink()
+        self.skip_i2c = skip_i2c
+        self.supported_formats = None
+        self._i2c = self._hololink.get_i2c(self._i2c_bus)
+
+    def setup_clock(self):
+        # set the clock driver.
+        logging.debug("setup_clock")
+        self._hololink.setup_clock(
+            hololink_module.renesas_bajoran_lite_ts1.device_configuration()
+        )
+
+    def get_register(self, register):
+        if self.skip_i2c:
+            logging.debug("Skip i2c")
+            return
+        #logging.debug("get_register(register=%d(0x%X))" % (register, register))
+        write_bytes = bytearray(100)
+        serializer = hololink_module.Serializer(write_bytes)
+        serializer.append_uint16_be(register)
+        read_byte_count = 4
+        reply = self._i2c.i2c_transaction(
+            self._i2c_addr, write_bytes[: serializer.length()], read_byte_count
+        )
+        deserializer = hololink_module.Deserializer(reply)
+        r = deserializer.next_uint32_be()
+        logging.debug(
+            "get_register(i2c_addr=%d(0x%X), register=%d(0x%X),value=%d(0x%X))" % (self._i2c_addr, self._i2c_addr, register, register, r, r)
+        )
+        return r
+
+    def set_register(self, register, value, timeout=None):
+        if self.skip_i2c:
+            logging.debug("Skip i2c")
+            return
+        logging.debug(
+            "set_register(i2c address=%d(0x%X), register=%d(0x%X), value=%d(0x%X))"
+                % (self._i2c_addr, self._i2c_addr, register, register, value, value)
+        )
+        write_bytes = bytearray(100)
+        serializer = hololink_module.Serializer(write_bytes)
+        serializer.append_uint16_be(register)
+        serializer.append_uint32_be(value)
+        read_byte_count = 0
+        self._i2c.i2c_transaction(
+            self._i2c_addr,
+            write_bytes[: serializer.length()],
+            read_byte_count,
+            timeout=timeout,
+        )
+
+    def _is_raw(self, pixel_format):
+        return pixel_format >= 0x28 and pixel_format <= 0x2D
+
+    def _bayer_to_pixel_format(self, bayer_order):
+        formats = {
+            arducam_b0353_mode.bayer_order.BAYER_ORDER_BGGR.value : hololink_module.sensors.csi.BayerFormat.BGGR,
+            arducam_b0353_mode.bayer_order.BAYER_ORDER_GBRG.value : hololink_module.sensors.csi.BayerFormat.GBRG,
+            arducam_b0353_mode.bayer_order.BAYER_ORDER_GRBG.value : hololink_module.sensors.csi.BayerFormat.GRBG,
+            arducam_b0353_mode.bayer_order.BAYER_ORDER_RGGB.value : hololink_module.sensors.csi.BayerFormat.RGGB,
+        }
+        return formats[bayer_order]
+
+    def _data_type_to_pixel_format(self, data_type, bayer_order):
+        if self._is_raw(data_type):
+            return self._bayer_to_pixel_format(bayer_order)
+        logging.warn("Unexpected bayer format: %d" % data_type)
+        return 0
+
+    def _enum_resolution(self):
+        res = []
+        num_resolution = self._get_length_of_set(arducam_b0353_mode.RESOLUTION_INDEX_REG, arducam_b0353_mode.FORMAT_WIDTH_REG)
+        if num_resolution < 0:
+            logging.error("enum_resolution: Failed to get length of set")
+            return None
+        index = 0
+        while True:
+            self.set_register(arducam_b0353_mode.RESOLUTION_INDEX_REG, index)
+            width = self.get_register(arducam_b0353_mode.FORMAT_WIDTH_REG)
+            height = self.get_register(arducam_b0353_mode.FORMAT_HEIGHT_REG)
+            if width == arducam_b0353_mode.NO_DATA_AVAILABLE or height == arducam_b0353_mode.NO_DATA_AVAILABLE:
+                logging.debug("enum_resolution: Ended at index %d" % index)
+                break
+            frame_fmt = arducam_b0353_mode.frame_format(width=width, height=height, framerate=0, pixel_format=0)
+            res.append(frame_fmt)
+            index += 1
+        self.set_register(arducam_b0353_mode.RESOLUTION_INDEX_REG, 0)
+        return res
+
+    def _enum_pixformat(self):
+        res = []
+        num_pixformat = self._get_length_of_set(arducam_b0353_mode.PIXFORMAT_INDEX_REG, arducam_b0353_mode.PIXFORMAT_TYPE_REG)
+        if num_pixformat < 0:
+            logging.error("enum_pixformat: Failed to get length of set")
+            return None
+        index = 0
+        while True:
+            self.set_register(arducam_b0353_mode.PIXFORMAT_INDEX_REG, index)
+            pixfmt_type = self.get_register(arducam_b0353_mode.PIXFORMAT_TYPE_REG)
+            if pixfmt_type == arducam_b0353_mode.NO_DATA_AVAILABLE:
+                logging.debug("enum_pixformat: Ended at index %d" % index)
+                break
+            bayer_order = self.get_register(arducam_b0353_mode.PIXFORMAT_ORDER_REG)
+            frame_fmts = self._enum_resolution()
+            for frame_fmt in frame_fmts:
+                # frame_fmt.pixel_format = self._data_type_to_pixel_format(pixfmt_type, bayer_order)
+                frame_fmt.pixel_format = hololink_module.sensors.csi.PixelFormat.RAW_10
+                # There is no way of getting info about frame rates from the registers, but the documentation lists these:
+                # * 1920x1200＠60fps
+                # * 1920x1080@60fps
+                # * 1280x720@120fps
+                frame_fmt.framerate = 60 if frame_fmt.width == 1920 else 120
+            res.extend(frame_fmts)
+            index += 1
+        self.set_register(arducam_b0353_mode.PIXFORMAT_INDEX_REG, 0)
+        return res
+
+    def get_supported_formats(self):
+        dev_id = self.get_register(arducam_b0353_mode.DEVICE_ID_REG)
+        if dev_id != arducam_b0353_mode.DEVICE_ID:
+            logging.error("Reading device id register failed. Expected 0x%X, got 0x%X" % (arducam_b0353_mode.DEVICE_ID, dev_id))
+            raise RuntimeError("Failed to read device ID register")
+        logging.info("Device ID: 0x%X" % dev_id)
+        firmware_version = self.get_register(arducam_b0353_mode.DEVICE_VERSION_REG)
+        logging.info("Firmware version: 0x%X" % firmware_version)
+        frame_fmts = self._enum_pixformat()
+        if frame_fmts is None:
+            logging.error("Failed to get supported frame formats")
+        return frame_fmts
+
+    def wait_for_free(self, interval=1):
+        count = 0
+        while count < (1000 / interval):
+            val = self.get_register(arducam_b0353_mode.SYSTEM_IDLE_REG)
+            if val == 0:
+                break
+            time.sleep(interval / 1000.0)
+            count += 1
+        logging.debug("wait_for_free: Ended after %d iterations." % count)
+
+    def start(self):
+        """Start Streaming"""
+        self._running = True
+        for reg, val in arducam_b0353_mode.arducam_b0353_start:
+            self.set_register(reg, val)
+            time.sleep(1/1000)
+        self.wait_for_free(4)
+
+    def stop(self):
+        """Stop Streaming"""
+        for reg, val in arducam_b0353_mode.arducam_b0353_stop:
+            self.set_register(reg, val)
+            time.sleep(1/1000)
+        self._running = False
+
+    def get_version(self):
+        return self.get_register(arducam_b0353_mode.DEVICE_VERSION_REG)
+
+    def _get_length_of_set(self, idx_reg, val_reg):
+        index = 0
+        while True:
+            self.set_register(idx_reg, index)
+            val = self.get_register(val_reg)
+            if val == arducam_b0353_mode.NO_DATA_AVAILABLE:
+                break
+            index += 1
+        self.set_register(idx_reg, 0)
+        return index
+
+    def set_mode(self, arducam_b0353_mode_set):
+        if arducam_b0353_mode_set.value < len(arducam_b0353_mode.ArducamB0353_Mode):
+            self._mode = arducam_b0353_mode_set
+            mode = arducam_b0353_mode.imx_frame_format[self._mode.value]
+            self._height = mode.height
+            self._width = mode.width
+            self._pixel_format = mode.pixel_format
+        else:
+            logging.error("Incorrect mode for Arducam B0353")
+            self._mode = -1
+
+    def configure_mode(self, arducam_b0353_mode_set):
+        if arducam_b0353_mode_set.value >= len(arducam_b0353_mode.ArducamB0353_Mode):
+            logging.error(f"{arducam_b0353_mode_set} mode is not present.")
+            return False
+        mode = arducam_b0353_mode.imx_frame_format[arducam_b0353_mode_set.value]
+        for i, fmt in enumerate(self.supported_formats):
+            if (fmt.height == mode.height
+                    and fmt.width == mode.width
+                    and fmt.pixel_format == mode.pixel_format):
+                # Set index
+                self.set_register(arducam_b0353_mode.PIXFORMAT_INDEX_REG, 0) # TODO: refactor hard-coded value
+                self.set_register(arducam_b0353_mode.RESOLUTION_INDEX_REG, i)
+                self.set_mode(arducam_b0353_mode_set)
+                break
+        else: # Exited without 'break'
+            logging.error("Incorrect mode for Arducam B0353")
+            self._mode = -1
+            return False
+        return True
+
+    def configure_converter(self, converter):
+        logging.debug(f"configure_converter:width={self._width},height={self._height},bpp={self._pixel_format}")
+        assert self._pixel_format == hololink_module.sensors.csi.PixelFormat.RAW_10
+
+        start_byte = converter.receiver_start_byte()
+        transmitted_line_bytes = converter.transmitted_line_bytes(
+            self._pixel_format, self._width
+        )
+        received_line_bytes = converter.received_line_bytes(transmitted_line_bytes)
+
+        converter.configure(
+            start_byte,
+            received_line_bytes,
+            self._width,
+            self._height,
+            self._pixel_format,
+        )
+
+    def configure(self, arducam_b0353_mode_set):
+        self.supported_formats = self.get_supported_formats()
+        if self.supported_formats is None:
+            logging.error("Probe failed. Aborting configuration")
+            return
+        # configure the camera based on the mode
+        self.configure_camera(arducam_b0353_mode_set)
+
+    def pixel_format(self):
+        return self._pixel_format
+
+    def bayer_format(self):
+        return hololink_module.sensors.csi.BayerFormat.GRBG
+
+    def configure_camera(self, arducam_b0353_mode_set):
+        if not self.configure_mode(arducam_b0353_mode_set):
+            logging.error("Failed to set mode. Aborting camera configuration")
+            return
+
+    def set_exposure_reg(self, value=0x0640):
+        """
+        Arducam B0353 has the minimum limit of 4 to be set for the exposure.
+        """
+        if value < 0x0004:
+            logging.warn(f"Exposure value {value} is lower than the minimum.")
+            value = 0x0004
+        elif value > 0xFFFF:
+            logging.warn(f"Exposure value {value} is higher than the maximum.")
+            value = 0xFFFF
+        self.set_register(arducam_b0353_mode.EXPOSURE_REG, value)
