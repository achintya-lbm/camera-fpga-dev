+# C-style structures for direct memory mapping using ctypes
+class TotalPktHeader(ctypes.Structure):
+    _pack_ = 1
+    _fields_ = [("magic_num", ctypes.c_uint8 * 2),
+                ("data_format", ctypes.c_uint8),
+                ("header_crc", ctypes.c_uint8),
+                ("length", ctypes.c_uint32)]
