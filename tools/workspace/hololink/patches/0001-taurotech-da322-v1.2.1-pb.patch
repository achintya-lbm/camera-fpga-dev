new file mode 100644
index 0000000..a7ae4f6
--- /dev/null
+++ b/python/hololink/sensors/tc358743/tc358743.py
@@ -0,0 +1,1185 @@
+"""
+SPDX-FileCopyrightText: Copyright (c) 2023-2024 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+SPDX-License-Identifier: Apache-2.0
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+"""
+
+import math
+import logging
+import time
+import threading
+
+import hololink as hololink_module
+
+from . import tc358743_mode
+from . import tc358743_reg
+
+# HDMI-to-CSI bridge
+# Bridge info
+DRIVER_NAME = "TC358743"
+VERSION = 1
+
+# Bridge I2C address.
+BRDG_I2C_ADDRESS = 0xF
+
+class DelayedWork:
+    def __init__(self, callback):
+        self.callback = callback
+        self._timer = None
+        self._lock = threading.Lock()
+        self._running = False
+
+    def schedule(self, delay_sec):
+        with self._lock:
+            self._cancel_no_wait()
+            self._timer = threading.Timer(delay_sec, self._run)
+            self._timer.start()
+
+    def _run(self):
+        with self._lock:
+            self._running = True
+        try:
+            self.callback()
+        finally:
+            with self._lock:
+                self._running = False
+                self._timer = None
+
+    def cancel_sync(self):
+        """Equivalent to linux kernel cancel_delayed_work_sync."""
+        with self._lock:
+            # t = self._timer
+            running = self._running
+            self._cancel_no_wait()
+
+        if running:
+            # Wait for current callback to finish
+            while True:
+                with self._lock:
+                    if not self._running:
+                        break
+                time.sleep(0.001)
+
+        return True
+
+    def _cancel_no_wait(self):
+        if self._timer:
+            self._timer.cancel()
+            self._timer = None
+
+class TC358743Bridge:
+    def __init__(
+        self,
+        hololink_channel,
+        i2c_bus=hololink_module.CAM_I2C_BUS,
+        expander_configuration=0,
+        i2c_id=0,
+        skip_i2c=False,
+    ):
+        self._i2c_id = i2c_id
+        self._i2c_bus = i2c_bus + self._i2c_id
+        self._hololink = hololink_channel.hololink()
+        self._which = expander_configuration
+        self.skip_i2c = skip_i2c
+        self._tx_5v_enabled = False
+        self._refclk_hz = 27000000  # 27 MHz
+        self._pll_prd = int(self._refclk_hz / 6_000_000)
+        self._i2c = self._hololink.get_i2c(self._i2c_bus)
+
+        self.confctl_mutex = threading.Lock()
+        self.run_isr_mutex = threading.Lock()
+
+        self._width = 0
+        self._height = 0
+        self._framerate = tc358743_mode.FPS_INVALID
+        self.run_isr = True
+
+        def work_i2c_poll():
+            while True:
+                with self.run_isr_mutex:
+                    if self.run_isr is False:
+                        return
+                time.sleep(tc358743_mode.POLL_INTERVAL_MS / 1000)
+                self.get_info()
+                self.isr()
+
+        self.isr_thread = threading.Thread(target=work_i2c_poll)
+
+        def enable_hotplug():
+            logging.debug("Called enable_hotplug:")
+            self._i2c_wr8_and_or(tc358743_reg.HPD_CTL, ~tc358743_reg.MASK_HPD_OUT0, tc358743_reg.MASK_HPD_OUT0)
+
+        self._delayed_work_hotplug = DelayedWork(enable_hotplug)
+
+    def setup_clock(self):
+        # set the clock driver.
+        logging.debug("setup_clock")
+        self._hololink.setup_clock(
+            hololink_module.renesas_bajoran_lite_ts1.device_configuration()
+        )
+
+    def configure(self):
+        version = self.get_version()
+        logging.info("version=%s" % (version,))
+        assert version == VERSION
+
+        # configure the bridge based on the mode
+        self.configure_bridge()
+        self.s_dv_timings()
+
+    def start(self):
+        """Start Streaming"""
+        self._running = True
+        # tc358743_set_fmt
+        self.enable_stream(enable=False)
+        self.set_pll()
+        self.set_csi()
+        self.set_csi_color_space()
+        self.get_info()
+        self.s_dv_timings()
+
+        self.enable_stream(enable=True)
+
+    def stop(self):
+        """Stop Streaming"""
+        with self.run_isr_mutex:
+            self.run_isr = False
+        self.isr_thread.join()
+        self.enable_stream(enable=False)
+        self._running = False
+
+    def get_version(self):
+        return VERSION
+
+    def get_register(self, register, size):
+        if self.skip_i2c:
+            logging.debug("Skip i2c")
+            return
+        write_bytes = bytearray(100)
+        serializer = hololink_module.Serializer(write_bytes)
+        serializer.append_uint16_be(register)
+        read_byte_count = size
+        reply = self._i2c.i2c_transaction(
+            BRDG_I2C_ADDRESS, write_bytes[: serializer.length()], read_byte_count
+        )
+        deserializer = hololink_module.Deserializer(reply)
+        r = 0
+        for i in range(size):
+            r |= deserializer.next_uint8() << (i * 8)
+        logging.debug(
+            "get_register(i2c address=%d(0x%X), register=%d(0x%X), value=%d(0x%X), bytes=%d)" % (BRDG_I2C_ADDRESS, BRDG_I2C_ADDRESS, register, register, r, r, size)
+        )
+        return r
+
+    def set_register(self, register, value, size, timeout=None):
+        if self.skip_i2c:
+            logging.debug("Skip i2c")
+            return
+        if isinstance(value, bytearray):
+            value_hex = " ".join(f"0x{b:02X}" for b in value)
+            logging.debug(
+                f"set_register(i2c address={BRDG_I2C_ADDRESS} (0x{BRDG_I2C_ADDRESS:02X}), "
+                f"register=0x{register:04X}, value=[{value_hex}], bytes={size})"
+            )
+        else:
+            logging.debug(
+                "set_register(i2c address=%d(0x%X), register=%d(0x%X), value=%d(0x%X), bytes=%d)"
+                % (BRDG_I2C_ADDRESS, BRDG_I2C_ADDRESS, register, register, value, value, size)
+            )
+        write_bytes = bytearray(200)
+        serializer = hololink_module.Serializer(write_bytes)
+        serializer.append_uint16_be(register)
+        for i in range(size):
+            if isinstance(value, bytearray):
+                serializer.append_uint8(value[i]) # Little endian
+            else:
+                serializer.append_uint8((value >> (i * 8)) & 0xFF)
+        read_byte_count = 0
+        self._i2c.i2c_transaction(
+            BRDG_I2C_ADDRESS,
+            write_bytes[: serializer.length()],
+            read_byte_count,
+            timeout=timeout,
+        )
+
+    def configure_bridge(self):
+        if self.update_controls():
+            raise RuntimeError("HDMI TX 5V not detected!")
+
+        self.confctl_mutex = threading.Lock()
+
+        self.initial_setup()
+        self.s_dv_timings()
+        self.set_csi_color_space()
+        self.init_interrupts()
+
+        self.enable_interrupts(self.tx_5v_power_present())
+
+        irq_mask = 0x300
+        self.set_register(tc358743_reg.INTMASK, ~irq_mask & 0xFFFF, size=2)
+
+        self.isr_thread.start()
+        logging.debug("ISR handler thread started")
+
+        # Write edid
+        edid = tc358743_mode.TOSHH2C_DEFAULT_EDID
+        if edid is None:
+            logging.error("EDID data is not available for this mode.")
+        else:
+            edid = [edid[i:i+2] for i in range(0, len(edid), 2)]
+            edid = bytearray([int(c, 16) for c in edid])
+            self.s_edid(edid)
+
+        self.get_info()
+        while self._framerate == tc358743_mode.FPS_INVALID:
+            time.sleep(0.1)
+
+    def is_hdmi(self):
+        return self.get_register(tc358743_reg.SYS_STATUS, size=1) & tc358743_reg.MASK_S_HDMI
+
+    def tx_5v_power_present(self):
+        return self.get_register(tc358743_reg.SYS_STATUS, size=1) & tc358743_reg.MASK_S_DDC5V
+
+    def enable_interrupts(self, cable_connected):
+        logging.debug(f"enable_interrupts(cable_connected={cable_connected})")
+
+        if cable_connected:
+            self.set_register(tc358743_reg.SYS_INTM, ~(tc358743_reg.MASK_M_DDC | tc358743_reg.MASK_M_DVI_DET | tc358743_reg.MASK_M_HDMI_DET) & 0xff, size=1)
+            self.set_register(tc358743_reg.CLK_INTM, ~tc358743_reg.MASK_M_IN_DE_CHG & 0xff, size=1)
+            self.set_register(tc358743_reg.CBIT_INTM, ~(tc358743_reg.MASK_M_CBIT_FS | tc358743_reg.MASK_M_AF_LOCK | tc358743_reg.MASK_M_AF_UNLOCK) & 0xff, size=1)
+            self.set_register(tc358743_reg.AUDIO_INTM, ~tc358743_reg.MASK_M_BUFINIT_END & 0xff, size=1)
+            self.set_register(tc358743_reg.MISC_INTM, ~tc358743_reg.MASK_M_SYNC_CHG & 0xff, size=1)
+        else:
+            self.set_register(tc358743_reg.SYS_INTM, ~tc358743_reg.MASK_M_DDC & 0xff, size=1)
+            self.set_register(tc358743_reg.CLK_INTM, 0xff, size=1)
+            self.set_register(tc358743_reg.CBIT_INTM, 0xff, size=1)
+            self.set_register(tc358743_reg.AUDIO_INTM, 0xff, size=1)
+            self.set_register(tc358743_reg.MISC_INTM, 0xff, size=1)
+
+    def get_info(self):
+        width = ((self.get_register(tc358743_reg.DE_WIDTH_H_HI, size=1) & 0x1f) << 8) \
+            + self.get_register(tc358743_reg.DE_WIDTH_H_LO, size=1)
+        height = ((self.get_register(tc358743_reg.DE_WIDTH_V_HI, size=1) & 0x1f) << 8) \
+            + self.get_register(tc358743_reg.DE_WIDTH_V_LO, size=1)
+        frame_width = ((self.get_register(tc358743_reg.H_SIZE_HI, size=1) & 0x1f) << 8) \
+            + self.get_register(tc358743_reg.H_SIZE_LO, size=1)
+        frame_height = ((self.get_register(tc358743_reg.V_SIZE_HI, size=1) & 0x3f) << 8) \
+            + self.get_register(tc358743_reg.V_SIZE_LO, size=1) / 2
+
+        frame_interval = ((self.get_register(tc358743_reg.FV_CNT_HI, size=1) & 0x3) << 8) \
+            + self.get_register(tc358743_reg.FV_CNT_LO, size=1)
+        fps = round(10000 / frame_interval) if (frame_interval > 0) else tc358743_mode.FPS_INVALID
+
+        self._width = width
+        self._height = height
+        self._pixelclock = width * height * fps
+        self._framerate = fps
+
+        logging.info(f"TC358743 Timings: Active Area (DE) = {width}x{height}, \n"
+             f"Total Frame Size = {frame_width}x{frame_height} lines. FPS = {fps}")
+
+    def get_frame_size(self):
+        return self._width * self._height * 3 # BGR24
+
+    def pixel_format(self):
+        return self._pixel_format
+
+    def get_active_lane_count(self):
+        return self._csi_lanes_in_use
+
+    def detect_tx_5v(self):
+        """Detect if the HDMI TX 5V is present"""
+        power_status = self.get_register(tc358743_reg.SYS_STATUS, size=1) & tc358743_reg.MASK_S_DDC5V
+        if (power_status & 0x01) != 0:
+            self._tx_5v_enabled = True
+        else:
+            self._tx_5v_enabled = False
+        return 0
+
+    def _i2c_wr16_and_or(self, reg, mask, val):
+        r = self.get_register(reg, size=2)
+        r = (r & mask) | val
+        self.set_register(reg, r, size=2)
+
+    def _i2c_wr8_and_or(self, reg, mask, val):
+        r = self.get_register(reg, size=1)
+        r = (r & mask) | val
+        self.set_register(reg, r, size=1)
+
+
+    def enable_stream(self, enable):
+        """Enable or disable video streaming"""
+        logging.debug(f"enable_stream(enable={enable})")
+
+        if enable:
+            """ It is critical for CSI receiver to see lane transition LP11->HS.
+                Set to non-continuous mode to enable clock lane LP11 state. """
+
+            self.set_register(tc358743_reg.TXOPTIONCNTRL, 0, size=4)
+            # Set to continuous mode to trigger LP11->HS transition
+            self.set_register(tc358743_reg.TXOPTIONCNTRL, tc358743_reg.MASK_CONTCLKMODE, size=4)
+            # Unmute video
+            self.set_register(tc358743_reg.VI_MUTE, tc358743_reg.MASK_AUTO_MUTE, size=1)
+        else:
+            """ Mute video so that all data lanes go to LSP11 state.
+                No data is output to tc358743_reg.CSI Tx block."""
+            self.set_register(tc358743_reg.VI_MUTE, tc358743_reg.MASK_AUTO_MUTE | tc358743_reg.MASK_VI_MUTE, size=1)
+
+        with self.confctl_mutex:
+            self._i2c_wr16_and_or(tc358743_reg.CONFCTL, ~(tc358743_reg.MASK_VBUFEN | tc358743_reg.MASK_ABUFEN), \
+                                  (tc358743_reg.MASK_VBUFEN | tc358743_reg.MASK_ABUFEN) if enable else 0)
+
+    def s_dv_timings(self):
+        # Skipped v4l specific steps
+        self.enable_stream(False)
+        self.set_pll()
+        self.set_csi()
+
+    def set_csi_color_space(self):
+        logging.debug("RGB 888 24-bit")
+        self._i2c_wr8_and_or(tc358743_reg.VOUT_SET2, ~(tc358743_reg.MASK_SEL422 | tc358743_reg.MASK_VOUT_422FIL_100) & 0xff, 0x00)
+        self._i2c_wr8_and_or(tc358743_reg.VI_REP, ~tc358743_reg.MASK_VOUT_COLOR_SEL & 0xff, tc358743_reg.MASK_VOUT_COLOR_RGB_FULL)
+
+        with self.confctl_mutex:
+            self._i2c_wr16_and_or(tc358743_reg.CONFCTL, ~tc358743_reg.MASK_YCBCRFMT, 0)
+
+    def init_interrupts(self):
+        """ Clear interrupt status registers """
+        for i in range(tc358743_reg.SYS_INT, tc358743_reg.KEY_INT + 1):
+            self.set_register(i, 0xff, size=1)
+
+        self.set_register(tc358743_reg.INTSTATUS, 0xffff, size=2)
+
+    def num_csi_lanes_needed(self):
+        bits_pr_pixel = 24
+        fps = round(self._pixelclock / (self._width * self._height)) if (self._width * self._height) else 0
+        logging.debug(f"num_csi_lanes_needed: FPS = {fps}")
+        bps = self._width * self._height * fps * bits_pr_pixel
+        bps_pr_lane = (self._refclk_hz / self._pll_prd) * self._pll_fbd
+
+        return math.ceil(bps / bps_pr_lane)
+
+    def set_csi(self):
+        lanes = self.num_csi_lanes_needed()
+
+        logging.debug(f"set_csi(lanes={lanes})")
+
+        self._csi_lanes_in_use = lanes
+
+        self.reset(tc358743_reg.MASK_CTXRST)
+
+        if lanes < 1:
+            self.set_register(tc358743_reg.CLW_CNTRL, tc358743_reg.MASK_CLW_LANEDISABLE, size=4)
+        if lanes < 1:
+            self.set_register(tc358743_reg.D0W_CNTRL, tc358743_reg.MASK_D0W_LANEDISABLE, size=4)
+        if lanes < 2:
+            self.set_register(tc358743_reg.D1W_CNTRL, tc358743_reg.MASK_D1W_LANEDISABLE, size=4)
+        if lanes < 3:
+            self.set_register(tc358743_reg.D2W_CNTRL, tc358743_reg.MASK_D2W_LANEDISABLE, size=4)
+        if lanes < 4:
+            self.set_register(tc358743_reg.D3W_CNTRL, tc358743_reg.MASK_D3W_LANEDISABLE, size=4)
+
+
+        self._lineinitcnt    = 0x00001b58
+        self._lptxtimecnt    = 0x00000007
+        self._tclk_headercnt = 0x00002806
+        self._tclk_trailcnt  = 0x00000000
+        self._ths_headercnt  = 0x00000806
+        self._twakeup        = 0x00004268
+        self._tclk_postcnt   = 0x00000008
+        self._ths_trailcnt   = 0x00000005
+        self._hstxvregcnt    = 0x00000000
+
+        self.set_register(tc358743_reg.LINEINITCNT, self._lineinitcnt, size=4)
+        self.set_register(tc358743_reg.LPTXTIMECNT, self._lptxtimecnt, size=4)
+        self.set_register(tc358743_reg.TCLK_HEADERCNT, self._tclk_headercnt, size=4)
+        self.set_register(tc358743_reg.TCLK_TRAILCNT, self._tclk_trailcnt, size=4)
+        self.set_register(tc358743_reg.THS_HEADERCNT, self._ths_headercnt, size=4)
+        self.set_register(tc358743_reg.TWAKEUP, self._twakeup, size=4)
+        self.set_register(tc358743_reg.TCLK_POSTCNT, self._tclk_postcnt, size=4)
+        self.set_register(tc358743_reg.THS_TRAILCNT, self._ths_trailcnt, size=4)
+        self.set_register(tc358743_reg.HSTXVREGCNT, self._hstxvregcnt, size=4)
+
+        self.set_register(tc358743_reg.HSTXVREGEN, \
+                (tc358743_reg.MASK_CLM_HSTXVREGEN if (lanes > 0) else 0x0) | \
+                (tc358743_reg.MASK_D0M_HSTXVREGEN if (lanes > 0) else 0x0) | \
+                (tc358743_reg.MASK_D1M_HSTXVREGEN if (lanes > 1) else 0x0) | \
+                (tc358743_reg.MASK_D2M_HSTXVREGEN if (lanes > 2) else 0x0) | \
+                (tc358743_reg.MASK_D3M_HSTXVREGEN if (lanes > 3) else 0x0), size=4)
+
+
+        self.set_register(tc358743_reg.TXOPTIONCNTRL, (0 if tc358743_mode.USE_CSI2_NONCONTINUOUS_CLOCK else tc358743_reg.MASK_CONTCLKMODE), size=4)
+        self.set_register(tc358743_reg.STARTCNTRL, tc358743_reg.MASK_START, size=4)
+        self.set_register(tc358743_reg.CSI_START, tc358743_reg.MASK_STRT, size=4)
+
+        self.set_register(tc358743_reg.CSI_CONFW, tc358743_reg.MASK_MODE_SET | \
+                tc358743_reg.MASK_ADDRESS_CSI_CONTROL | \
+                tc358743_reg.MASK_CSI_MODE | \
+                tc358743_reg.MASK_TXHSMD | \
+                (tc358743_reg.MASK_NOL_4 if (lanes == 4) else \
+                tc358743_reg.MASK_NOL_3 if (lanes == 3) else \
