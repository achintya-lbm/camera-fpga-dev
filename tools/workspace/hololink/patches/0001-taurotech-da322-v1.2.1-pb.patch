+        (MAX9295E_SER_ADDR_A, 0x0002, 0x33),  # Enable Video Transmit for Pipes X and Y
+
+        [MAX96716A_DESER_ADDR, 0x0040, 0x16], # I2C Fast-mode speed (400Kbps)
+        
+        # --- ISP Reset Sequence ---
+        (MAX9295E_SER_ADDR_A, 0x02D3, 0x80),  # Set GPIO7A: RES_1M (Reset Low)
+        (MAX9295E_SER_ADDR_A, MPSB_TABLE_WAIT_MS, 50),
+        (MAX9295E_SER_ADDR_A, 0x02D3, 0x90),  # Set GPIO7A: RES_1M | GpioOut1 (Reset High)
+        (MAX9295E_SER_ADDR_A, MPSB_TABLE_WAIT_MS, 500),
+        
+        # --- Radar and dToF Reset Sequence ---
+        (MAX9295E_SER_ADDR_A, 0x02C7, 0x80),           # Radar reset low
+        (MAX9295E_SER_ADDR_A, MPSB_TABLE_WAIT_MS, 50), 
+        (MAX9295E_SER_ADDR_A, 0x02C7, 0x90),           # Radar reset high
+        (MAX9295E_SER_ADDR_A, MPSB_TABLE_WAIT_MS, 50),
+        (MAX9295E_SER_ADDR_A, 0x02E5, 0x80),           # dToF reset low
+        (MAX9295E_SER_ADDR_A, 0x02E5, 0x90),           # dToF reset high
+        (MAX9295E_SER_ADDR_A, 0x02E5, 0x80),           # dToF reset low
+        (MAX9295E_SER_ADDR_A, MPSB_TABLE_WAIT_MS, 50),
