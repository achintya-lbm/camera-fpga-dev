+"""
+
+from collections import OrderedDict, namedtuple
+from enum import Enum
+
+import hololink
+
+# values are on hex number system to be consistent with rest of the list
+SPI_SENSOR_SELECT = "spi-table-select"
+SPI_WAIT_MS = 0x01
+SPI_WAIT_MS_START = 0xC8
+
+# MAXxxx SERDES I2C address
+SER_ADDR_DEF = 0x40 # MAX96717 default i2c address
+SER_ADDR = 0x43 # MAX96717
+DES_ADDR = 0x28 # MAX96716A
+
+class GmslLink(Enum):
+    LINK_A = 0
+    LINK_B = 1
+
+GMSL_LINK = GmslLink.LINK_B
+def set_gmsl_link(link):
+    if link.value < len(GmslLink):
+        global GMSL_LINK
+        GMSL_LINK = link
+    else:
+        raise ValueError("Incorrect GMSL link")
+
+def set_ser_i2c_address(addr):
+    if addr is None:
+        return
+    global SER_ADDR
+    SER_ADDR = addr
+
+def set_des_i2c_address(addr):
+    if addr is None:
+        return
+    global DES_ADDR
+    DES_ADDR = addr
+
+SPI_CLK_DELAY_VAL = 0x06
+
+def set_spi_clock_delay(val):
+    if val is None:
+        return
+    global SPI_CLK_DELAY_VAL
+    SPI_CLK_DELAY_VAL = val
+
+def get_max_serdes_spi():
+    return [
+        # reassign I2C address
+        (DES_ADDR,0x0F00,0x01) if GMSL_LINK == GmslLink.LINK_A # Isolate Link A
+        else (DES_ADDR,0x0F00,0x02), # Isolate Link B
+        ("","sleep",0.1),
+        (SER_ADDR_DEF,0x0,(SER_ADDR<<1)),
+        (DES_ADDR,0x0F00,0x03),
+        (DES_ADDR,0x0010,0x03), # Enable reverse splitter mode
+        #disable UART pass-through on Des
+        (DES_ADDR,0x0003,0x43),
+        #enable reverse splitter mode
+        (DES_ADDR,0x0010,0x03),
+        (DES_ADDR,0x0170,0x09),
+        (DES_ADDR,0x0176,0x03),
+        (DES_ADDR,0x0177,0x00),
+        #(DES_ADDR,0x0177,0x20), # Use alternate RO
+        (DES_ADDR,0x0162,0x00) if GMSL_LINK == GmslLink.LINK_A # Link A stream
+        else (DES_ADDR,0x0162,0x08), # Link B stream
+        #setup serializer clk
+        (SER_ADDR,0x0173,0x06),
+        (SER_ADDR,0x0174,SPI_CLK_DELAY_VAL),
+        (SER_ADDR,0x0175,SPI_CLK_DELAY_VAL),
+        (SER_ADDR,0x0176,0x0C),
+        (SER_ADDR,0x0172,0x00),
+        #to ignore the SPI ID
+        (SER_ADDR,0x0170,0x0B),
+        ## SPI ID = 0x00, use 0xA0 command
+        #(SER_ADDR,0x0170,0x03),
+        ## SPI ID = 0x01, use 0xA1 command
+        #(SER_ADDR,0x0170,0x53),
+    ]
+
+class Spi_Mode(Enum):
+    SPI_MODE_1 = 0
+    Unknown = 1
+
+frame_format = namedtuple(
+    "FrameFormat", ["width", "height", "framerate", "pixel_format"]
+)
+
+imx_frame_format = []
+imx_frame_format.insert(
+    Spi_Mode.SPI_MODE_1.value,
+    frame_format(1920, 1200, 60, hololink.sensors.csi.PixelFormat.RAW_10),
+)
