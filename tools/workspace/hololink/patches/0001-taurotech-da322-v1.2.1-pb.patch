+    def set_hdmi_phy(self):
+        self._i2c_wr8_and_or(tc358743_reg.PHY_EN, ~tc358743_reg.MASK_ENABLE_PHY, 0x0)
+        self.set_register(tc358743_reg.PHY_CTL1, tc358743_reg.SET_PHY_AUTO_RST1_US(1600) | tc358743_reg.SET_FREQ_RANGE_MODE_CYCLES(1), size=1)
+        hdmi_phy_auto_reset_tmds_detected = False
+        hdmi_phy_auto_reset_tmds_in_range = False
+        phy_auto_reset_tmds_valid = False
+        self._i2c_wr8_and_or(tc358743_reg.PHY_CTL2, ~tc358743_reg.MASK_PHY_AUTO_RSTn,
+                (tc358743_reg.MASK_PHY_AUTO_RST2 if hdmi_phy_auto_reset_tmds_detected else 0) |
+                (tc358743_reg.MASK_PHY_AUTO_RST3 if hdmi_phy_auto_reset_tmds_in_range else 0) |
+                (tc358743_reg.MASK_PHY_AUTO_RST4 if phy_auto_reset_tmds_valid else 0))
+
+        hdmi_detection_delay = 0x0
+        hdmi_phy_a = 0x0
+        hdmi_phy_auto_reset_vsync_out_of_range = False
+
+        self.set_register(tc358743_reg.PHY_BIAS, 0x40, size=1)
+        self.set_register(tc358743_reg.PHY_CSQ, tc358743_reg.SET_CSQ_CNT_LEVEL(0x0a), size=1)
+        self.set_register(tc358743_reg.AVM_CTL, 45, size=1)
+        self._i2c_wr8_and_or(tc358743_reg.HDMI_DET, ~tc358743_reg.MASK_HDMI_DET_V, hdmi_detection_delay << 4)
+
+        self._i2c_wr8_and_or(tc358743_reg.HV_RST, ~(tc358743_reg.MASK_H_PI_RST | tc358743_reg.MASK_V_PI_RST), \
+                            (hdmi_phy_a | tc358743_reg.MASK_V_PI_RST if hdmi_phy_auto_reset_vsync_out_of_range else 0))
+
+        self._i2c_wr8_and_or(tc358743_reg.PHY_EN, ~tc358743_reg.MASK_ENABLE_PHY, tc358743_reg.MASK_ENABLE_PHY)
+
+    def reset(self, mask):
+        """Reset the bridge"""
+        sysctl = self.get_register(tc358743_reg.SYSCTL, size=2)
+        self.set_register(tc358743_reg.SYSCTL, sysctl | mask, size=2)
+        self.set_register(tc358743_reg.SYSCTL, sysctl & ~mask, size=2)
+
+    def sleep_mode(self, enable):
+        """Put the bridge into sleep mode"""
+        self._i2c_wr16_and_or(tc358743_reg.SYSCTL, ~tc358743_reg.MASK_SLEEP, tc358743_reg.MASK_SLEEP if enable else 0);
+
+    def set_ref_clk(self):
+        """Set the reference clock"""
+        self._refclk_hz = 27_000_000  # 27 MHz
+        sys_freq = self._refclk_hz // 10_000
+        self.set_register(tc358743_reg.SYS_FREQ0, sys_freq & 0x00FF, size=1)
+        self.set_register(tc358743_reg.SYS_FREQ1, (sys_freq & 0xFF00) >> 8, size=1)
+        self._i2c_wr8_and_or(tc358743_reg.PHY_CTL0, ~tc358743_reg.MASK_PHY_SYSCLK_IND, tc358743_reg.MASK_PHY_SYSCLK_IND if (self._refclk_hz == 42000000) else 0x0)
+
+        fh_min = self._refclk_hz // 100_000
+        self.set_register(tc358743_reg.FH_MIN0, fh_min & 0x00ff, size=1)
+        self.set_register(tc358743_reg.FH_MIN1, (fh_min & 0xff00) >> 8, size=1)
+
+        fh_max = (fh_min * 66) // 10
+        self.set_register(tc358743_reg.FH_MAX0, fh_max & 0x00ff, size=1)
+        self.set_register(tc358743_reg.FH_MAX1, (fh_max & 0xff00) >> 8, size=1)
+
+        lockdet_ref = self._refclk_hz // 100
+        self.set_register(tc358743_reg.LOCKDET_REF0, lockdet_ref & 0x0000ff, size=1)
+        self.set_register(tc358743_reg.LOCKDET_REF1, (lockdet_ref & 0x00ff00) >> 8, size=1)
+        self.set_register(tc358743_reg.LOCKDET_REF2, (lockdet_ref & 0x0f0000) >> 16, size=1)
+
+        self._i2c_wr8_and_or(tc358743_reg.NCO_F0_MOD, ~tc358743_reg.MASK_NCO_F0_MOD, tc358743_reg.MASK_NCO_F0_MOD_27MHZ if (self._refclk_hz == 27000000) else 0x0)
+
+        #
+        # Trial and error suggests that the default register value
+        # of 656 is for a 42 MHz reference clock. Use that to derive
+        # a new value based on the actual reference clock.
+        #
+        cec_freq = int((656 * sys_freq) / 4200)
+        self.set_register(tc358743_reg.CECHCLK, cec_freq, size=2)
+        self.set_register(tc358743_reg.CECLCLK, cec_freq, size=2)
+
+
+    def disable_edid(self):
+        logging.debug("Called disable_edid:")
+
+        self._delayed_work_hotplug.cancel_sync()
+
+        # DDC access to EDID is also disabled when hotplug is disabled. See
+        # register DDC_CTL
+        self._i2c_wr8_and_or(tc358743_reg.HPD_CTL, ~tc358743_reg.MASK_HPD_OUT0, 0x0)
+
+    def enable_edid(self):
+        logging.debug("Called enable_edid:")
+
+        if self._edid_blocks_written == 0:
+            logging.debug("enable_edid: no EDID -> no hotplug")
+            self.detect_tx_5v()
+            return
+
+        logging.debug("enable_edid:")
+
+        # Enable hotplug after 100 ms. DDC access to EDID is also enabled when
+        # hotplug is enabled. See register DDC_CTL
+        self._delayed_work_hotplug.schedule(100 / 1000)
+
+        self.enable_interrupts(True)
+        self.detect_tx_5v()
+
+    def s_edid(self, edid):
+        """Set the EDID data
+
+        @param edid  array of bytes representing EDID content
+        """
+        logging.debug("s_edid called")
+
+        self.disable_edid()
+
+        self.set_register(tc358743_reg.EDID_LEN1, len(edid) & 0xff, size=1)
+        self.set_register(tc358743_reg.EDID_LEN2, len(edid) >> 8, size=1)
+
+        if len(edid) == 0:
+            self._edid_blocks_written = 0
+            return
+
+        addr = tc358743_reg.EDID_RAM
+        for b in edid:
+            self.set_register(addr, b, size=1)
+            addr += 1
+
+        self._edid_blocks_written = len(edid) // tc358743_mode.EDID_BLOCK_SIZE
+
+        if self.tx_5v_power_present():
+            self.enable_edid()
+
+        return
+
+    def g_edid(self, size=256):
+        logging.debug("g_edid called")
+        return self.get_register(tc358743_reg.EDID_RAM, size=size)
+
+    def hdmi_cbit_int_handler(self, handled):
+        cbit_int_mask = self.get_register(tc358743_reg.CBIT_INTM, size=1)
+        cbit_int = self.get_register(tc358743_reg.CBIT_INT, size=1) & ~cbit_int_mask
+
+        self.set_register(tc358743_reg.CBIT_INT, cbit_int, size=1)
+
+        logging.debug("%s: CBIT_INT = 0x%02x" % ("hdmi_cbit_int_handler", cbit_int))
+
+        if cbit_int & tc358743_reg.MASK_I_CBIT_FS:
+            logging.debug("%s: Audio sample rate changed\n" % ("hdmi_cbit_int_handler"))
+            self.s_ctrl_audio_sampling_rate()
+
+            cbit_int &= ~tc358743_reg.MASK_I_CBIT_FS
+            if (handled):
+                handled = True
+
+        if cbit_int & (tc358743_reg.MASK_I_AF_LOCK | tc358743_reg.MASK_I_AF_UNLOCK):
+            logging.debug("%s: Audio present changed\n" % ("hdmi_cbit_int_handler"))
+            self.s_ctrl_audio_present()
+
+            cbit_int &= ~(tc358743_reg.MASK_I_AF_LOCK | tc358743_reg.MASK_I_AF_UNLOCK)
+            if handled:
+                handled = True
+
+        if cbit_int:
+            logging.error("%s: Unhandled CBIT_INT interrupts: 0x%02x" % ("hdmi_cbit_int_handler", cbit_int))
+
+    def hdmi_clk_int_handler(self, handled):
+        clk_int_mask = self.get_register(tc358743_reg.CLK_INTM, size=1)
+        clk_int = self.get_register(tc358743_reg.CLK_INT, size=1) & ~clk_int_mask
+
+        # Bit 7 and bit 6 are set even when they are masked
+        self.set_register(tc358743_reg.CLK_INT, clk_int | 0x80 | tc358743_reg.MASK_I_OUT_H_CHG, size=1)
+
+        logging.debug("%s: CLK_INT = 0x%02x" % ("hdmi_clk_int_handler", clk_int))
+
+        if clk_int & (tc358743_reg.MASK_I_IN_DE_CHG):
+            logging.debug("%s: DE size or position has changed\n" % ("hdmi_clk_int_handler"))
+
+            """ If the source switch to a new resolution with the same pixel
+                frequency as the existing (e.g. 1080p25 -> 720p50), the
+                I_SYNC_CHG interrupt is not always triggered, while the
+                I_IN_DE_CHG interrupt seems to work fine. Format change
+                notifications are only sent when the signal is stable to
+                reduce the number of notifications. """
+            if not self.no_signal() and not self.no_sync():
+                self.format_change()
+
+            clk_int &= ~(tc358743_reg.MASK_I_IN_DE_CHG)
+            if handled:
+                handled = True
+
+        if clk_int:
+            logging.error("%s: Unhandled CLK_INT interrupts: 0x%02x" % ("hdmi_clk_int_handler", clk_int))
+
+
+    def s_ctrl_audio_sampling_rate(self):
+        # Ignore audio
+        pass
+
+    def s_ctrl_audio_present(self):
+        self.audio_present()
+
+    def hdmi_audio_int_handler(self, handled):
+        audio_int_mask = self.get_register(tc358743_reg.AUDIO_INTM, size=1)
+        audio_int = self.get_register(tc358743_reg.AUDIO_INT, size=1) & ~audio_int_mask
+
+        self.set_register(tc358743_reg.AUDIO_INT, audio_int, size=1)
+
+        logging.debug("%s: AUDIO_INT = 0x%02x" % ("hdmi_sys_int_handler", audio_int))
+
+        self.s_ctrl_audio_sampling_rate()
+        self.s_ctrl_audio_present()
+
+    def csi_err_int_handler(self, handled):
+        logging.error("%s: CSI_ERR = 0x%08x" % ("csi_err_int_handler", self.get_register(tc358743_reg.CSI_ERR, size=4)))
+        self.set_register(tc358743_reg.CSI_INT_CLR, tc358743_reg.MASK_ICRER, size=4)
+
+    def hdmi_misc_int_handler(self, handled):
+        misc_int_mask = self.get_register(tc358743_reg.MISC_INTM, size=1)
+        misc_int = self.get_register(tc358743_reg.MISC_INT, size=1) & ~misc_int_mask
+
+        self.set_register(tc358743_reg.MISC_INT, misc_int, size=1)
+
+        logging.debug("%s: MISC_INT = 0x%02x" % ("hdmi_misc_int_handler", misc_int))
+
+        if (misc_int & tc358743_reg.MASK_I_SYNC_CHG):
+            # Reset the HDMI PHY to try to trigger proper lock on the
+            # incoming video format. Erase BKSV to prevent that old keys
+            # are used when a new source is connected.
+            if (self.no_sync() or self.no_signal()):
+               self.reset_phy()
+               self.erase_bksv()
+
+            self.format_change()
+
+            misc_int &= ~tc358743_reg.MASK_I_SYNC_CHG
+            handled = True
+
+        if misc_int:
+            logging.error("%s: Unhandled MISC_INT interrupts: 0x%02x" % ("hdmi_misc_int_handler", misc_int))
+
+    def format_change(self):
+
+        if self.no_signal() or self.no_sync():
+            logging.debug("Format change: No signal")
+            self.enable_stream(False)
+        else:
+            self.get_info()
+            #if (!v4l2_match_dv_timings(&state->timings, &timings, 0, false))
+            self.enable_stream(False)
+            logging.info("Format changed")
+
+        self.enable_stream(True)
+
+    def hdmi_sys_int_handler(self, handled):
+        sys_int_mask = self.get_register(tc358743_reg.SYS_INTM, size=1)
+        sys_int = self.get_register(tc358743_reg.SYS_INT, size=1) & ~sys_int_mask
+
+        self.set_register(tc358743_reg.SYS_INT, sys_int, size=1)
+
+        logging.debug("%s: SYS_INT = 0x%02x" % ("hdmi_sys_int_handler", sys_int))
+
+        if (sys_int & tc358743_reg.MASK_I_DDC):
+            tx_5v = self.tx_5v_power_present()
+
+            logging.debug("%s: Tx 5V power present: %s" % ("hdmi_sys_int_handler", "yes" if tx_5v else "no"))
+
+            if (tx_5v):
+                self.enable_edid()
+            else:
+                self.enable_interrupts(False)
+                self.disable_edid()
+                self.erase_bksv()
+                self.update_controls()
+
+            sys_int &= ~tc358743_reg.MASK_I_DDC
+            handled = True
+
+        if (sys_int & tc358743_reg.MASK_I_DVI):
+            logging.debug("HDMI->DVI change detected")
+
+            # Reset the HDMI PHY to try to trigger proper lock on the
+            # incoming video format. Erase BKSV to prevent that old keys
+            # are used when a new source is connected.
+            if (self.no_sync() or self.no_signal()):
+               self.reset_phy()
+               self.erase_bksv()
+
+            sys_int &= ~tc358743_reg.MASK_I_DVI
+            handled = True
+
+        if (sys_int & tc358743_reg.MASK_I_HDMI):
+            logging.debug("DVI->HDMI change detected")
+
+            # Register is reset in DVI mode (REF_01, c. 6.6.41)
+            self.set_register(tc358743_reg.ANA_CTL,
+                tc358743_reg.MASK_APPL_PCSX_NORMAL | tc358743_reg.MASK_ANALOG_ON, size=1)
+
+            sys_int &= ~tc358743_reg.MASK_I_HDMI
+            handled = True
+
+        if sys_int:
+            logging.error("%s: Unhandled SYS_INT interrupts: 0x%02x" % ("hdmi_sys_int_handler", sys_int))
+
+    def no_signal(self):
+        return not (self.get_register(tc358743_reg.SYS_STATUS, size=1) & tc358743_reg.MASK_S_TMDS)
+
+    def no_sync(self):
+        return not (self.get_register(tc358743_reg.SYS_STATUS, size=1) & tc358743_reg.MASK_S_SYNC)
+
+    def audio_present(self):
+        return (self.get_register(tc358743_reg.AU_STATUS0, size=1) & tc358743_reg.MASK_S_A_SAMPLE)
+
+    def reset_phy(self):
+        logging.debug("reset_phy:")
+        self._i2c_wr8_and_or(tc358743_reg.PHY_RST, ~tc358743_reg.MASK_RESET_CTRL, 0)
+        self._i2c_wr8_and_or(tc358743_reg.PHY_RST, ~tc358743_reg.MASK_RESET_CTRL, tc358743_reg.MASK_RESET_CTRL)
+
+    def erase_bksv(self):
+        for i in range(5):
+            self.set_register(tc358743_reg.BKSV + i, 0, size=1)
+
+    def update_controls(self):
+        return self.detect_tx_5v()
+
+    def isr(self, handled=None):
+        intstatus = self.get_register(tc358743_reg.INTSTATUS, size=2)
+        logging.debug("IntStatus = 0x%04x" % intstatus)
+
+        if (intstatus & tc358743_reg.MASK_HDMI_INT):
+            hdmi_int0 = self.get_register(tc358743_reg.HDMI_INT0, size=1)
+            hdmi_int1 = self.get_register(tc358743_reg.HDMI_INT1, size=1)
+            logging.debug("hdmi_int 0=0x%X 1=0x%X" % (hdmi_int0, hdmi_int1))
+
+            if (hdmi_int0 & tc358743_reg.MASK_I_MISC):
+                self.hdmi_misc_int_handler(handled)
+            if (hdmi_int1 & tc358743_reg.MASK_I_CBIT):
+                self.hdmi_cbit_int_handler(handled)
+            if (hdmi_int1 & tc358743_reg.MASK_I_CLK):
+                self.hdmi_clk_int_handler(handled)
+            if (hdmi_int1 & tc358743_reg.MASK_I_SYS):
+                self.hdmi_sys_int_handler(handled)
+            if (hdmi_int1 & tc358743_reg.MASK_I_AUD):
+                self.hdmi_audio_int_handler(handled)
+
+            self.set_register(tc358743_reg.INTSTATUS, tc358743_reg.MASK_HDMI_INT, size=2)
+            intstatus &= ~tc358743_reg.MASK_HDMI_INT
+
+        if (intstatus & tc358743_reg.MASK_CSI_INT):
+            csi_int = self.get_register(tc358743_reg.CSI_INT, size=4)
+            if (csi_int & tc358743_reg.MASK_INTER):
+                self.csi_err_int_handler(handled)
+            self.set_register(tc358743_reg.INTSTATUS, tc358743_reg.MASK_CSI_INT, size=2)
+
+        intstatus = self.get_register(tc358743_reg.INTSTATUS, size=2)
+        if intstatus:
+            logging.debug("Unhandled IntStatus interrupts: 0x%02x" % intstatus)
+
