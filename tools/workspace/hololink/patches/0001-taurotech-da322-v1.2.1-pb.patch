+                ("platform", ctypes.c_uint32),
+                ("frame_number", ctypes.c_uint32),
+                ("time_cpu_cycles", ctypes.c_uint32),
+                ("num_detected_obj", ctypes.c_uint32),
+                ("num_tlvs", ctypes.c_uint32),
