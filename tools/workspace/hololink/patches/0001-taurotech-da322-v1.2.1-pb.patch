+                s.power_measured[1] = t[1].cast<uint16_t>();
+                s.power_measured[2] = t[2].cast<uint16_t>();
+                s.power_measured[3] = t[3].cast<uint16_t>();
+            })
+        .def_property(
+            "temp_reading",
+            [](const StatsInformation& s) {
+                return py::make_tuple(s.temp_reading[0], s.temp_reading[1], s.temp_reading[2], s.temp_reading[3]);
+            },
+            [](StatsInformation& s, py::tuple t) {
+                if (t.size() != 4)
+                    throw std::runtime_error("Input tuple must have 4 elements");
+                s.temp_reading[0] = t[0].cast<int16_t>();
+                s.temp_reading[1] = t[1].cast<int16_t>();
+                s.temp_reading[2] = t[2].cast<int16_t>();
+                s.temp_reading[3] = t[3].cast<int16_t>();
+            });
+
+    py::class_<RadarFrame>(m, "RadarFrame")
+        .def(py::init<>())
+        .def_readwrite("header", &RadarFrame::header)
+        .def_readwrite("point_cloud", &RadarFrame::point_cloud)
+        .def_readwrite("range_profile", &RadarFrame::range_profile)
+        .def_readwrite("stats", &RadarFrame::stats);
+
+    py::enum_<TlvType>(m, "TlvType")
+        .value("kPointCloud", TlvType::kPointCloud)
+        .value("kRangeProfile", TlvType::kRangeProfile)
+        .value("kStatsInfo", TlvType::kStatsInfo)
+        .export_values();
 
+    py::class_<RadarCtrl, std::shared_ptr<RadarCtrl>>(m, "RadarCtrl")
+        .def(py::init<std::shared_ptr<hololink::Hololink::I2c>, std::shared_ptr<hololink::Hololink::Spi>, std::shared_ptr<hololink::Hololink::GPIO>, bool>(),
+            "i2c"_a, "spi"_a, "gpio"_a, "debug"_a = true)
+        .def("init_radar", &RadarCtrl::init_radar, "Initializes the Radar sensor hardware.")
+        .def("start_radar", &RadarCtrl::start_radar, "Starts the radar ranging operation.")
+        .def("stop_radar", &RadarCtrl::stop_radar, "Stops the radar ranging operation.")
+        .def("get_radar_frame", &RadarCtrl::get_radar_frame,
+            py::return_value_policy::copy, // Ensures Python gets a copy, or None
+            "Gets the most recently captured Radar frame. Returns None on failure.");
+*/
     m.def("local_mac", &local_mac);
 
     m.def("local_ip_and_mac", &local_ip_and_mac, "destination_ip"_a, "port"_a);
