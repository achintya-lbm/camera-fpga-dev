+class RadarParserOperator(holoscan.core.Operator):
+    """Custom Holoscan operator to parse and print radar data."""
+
+    def __init__(self, fragment, *args, **kwargs):
+        super().__init__(fragment, *args, **kwargs)
+
+    def setup(self, spec: holoscan.core.OperatorSpec):
+        spec.input("receiver_in")
+
+    def compute(self, op_input, op_output, context):
+        message = op_input.receive("receiver_in")
+        if message is None:
+            return
+
+        data_tensor = message.get("")
+        if data_tensor is None:
+            logging.warning("Received message without tensor.")
+            return
+
+        raw_data = cp.asarray(data_tensor, dtype=cp.uint8).get()
+
+        header_size = ctypes.sizeof(TotalPktHeader)
+        if len(raw_data) < header_size:
+            logging.warning("Received data is smaller than a total packet header.")
+            return
+
+        try:
+            # not fully validated this copies correctly, might need to change
+            pkt_header = TotalPktHeader.from_buffer_copy(raw_data)
+
+            if list(pkt_header.magic_num) != SPI_HD_MAGIC_NUM:
+                logging.error(f"Header magic number mismatch. Actual: {list(pkt_header.magic_num)}, Expected: {SPI_HD_MAGIC_NUM}")
+                return
+
+            payload_len = pkt_header.length
+            payload_start = header_size
+            payload_end = payload_start + payload_len
+
+            if len(raw_data) < payload_end:
+                logging.error(f"Incomplete payload. Expected {payload_len} bytes, received {len(raw_data) - payload_start}.")
+                return
+
+            frame_data = raw_data[payload_start:payload_end]
+
+            calc_crc = calculate_crc8(frame_data, init_val=0x00)
+            if calc_crc != pkt_header.header_crc:
+                logging.error(f"Payload CRC check failed. Calculated: {calc_crc}, Expected: {pkt_header.header_crc}")
+                return
+
+            # execution may get stuck here, may need to double check sizes in FrameHeader/how data is grabbed from frame_data
+            frame_header_size = ctypes.sizeof(FrameHeader)
+            if len(frame_data) < frame_header_size:
+                logging.warning("Payload is smaller than a frame header.")
+                return
+
+            frame_header = FrameHeader.from_buffer_copy(frame_data)
+
+            if list(frame_header.magic_word) != FRAME_MAGIC_WORD:
+                logging.error(f"Frame header magic word mismatch. Actual: {list(frame_header.magic_word)}, Expected: {FRAME_MAGIC_WORD}")
+                return
+
+            radar_frame = self.parse_radar_frame(frame_header, frame_data)
+            print_radar_frame(radar_frame)
+
+        except Exception as e:
+            logging.error(f"Error parsing radar frame: {e}")
+
+    def parse_radar_frame(self, frame_header, frame_data):
+        radar_frame = RadarFrame()
+        radar_frame.header = frame_header
+
+        idx = ctypes.sizeof(FrameHeader)
+
+        for _ in range(frame_header.num_tlvs):
+            if idx + 8 > len(frame_data):
+                logging.error("Not enough data for TLV header.")
+                break
+
+            # not 100% sure this extracts the tlv_type and len correctly
+            tlv_type, tlv_len = struct.unpack_from('<II', frame_data, idx)
+            idx += 8
+
+            if idx + tlv_len > len(frame_data):
+                logging.error(f"TLV claims length of {tlv_len} but only {len(frame_data) - idx} bytes remain.")
+                break
+
+            try:
+                tlv_enum = TlvType(tlv_type)
+                if tlv_enum == TlvType.POINT_CLOUD:
+                    point_cloud = PointCloud()
+                    pc_idx = idx
+                    point_cloud.pc_header = PointCloudHeader.from_buffer_copy(frame_data, pc_idx)
+                    pc_idx += ctypes.sizeof(PointCloudHeader)
+
+                    num_pts = frame_header.num_detected_obj
+                    for _ in range(num_pts):
+                         if pc_idx + ctypes.sizeof(PointCloudData) > idx + tlv_len:
+                             break
+                         pt = PointCloudData.from_buffer_copy(frame_data, pc_idx)
+                         point_cloud.points.append(pt)
+                         pc_idx += ctypes.sizeof(PointCloudData)
+                    radar_frame.point_cloud = point_cloud
+
+                elif tlv_enum == TlvType.RANGE_PROFILE:
+                    num_elements = tlv_len // 2 # uint16_t
+                    profile_format = f'<{num_elements}H'
+                    radar_frame.range_profile = struct.unpack_from(profile_format, frame_data, idx)
+
+                elif tlv_enum == TlvType.STATS_INFO:
+                    if tlv_len < ctypes.sizeof(StatsInformation):
+                        break
+                    radar_frame.stats = StatsInformation.from_buffer_copy(frame_data, idx)
+
+            except ValueError:
+                logging.warning(f"Ignoring unknown TLV of type {tlv_type}")
+
+            idx += tlv_len
+
+        return radar_frame
+
+class HoloscanApplication(holoscan.core.Application):
+
+    def __init__(
+        self,
+        headless,
+        cuda_context,
+        cuda_device_ordinal,
+        hololink_channel_radar,
+        radar, 
+        frame_limit,
+    ):
+        logging.info("__init__")
+        super().__init__()
+        self._headless = headless
+        self._cuda_context = cuda_context
+        self._cuda_device_ordinal = cuda_device_ordinal
+        self._hololink_channel_radar = hololink_channel_radar
+        self._radar = radar
+        self._frame_limit = frame_limit
+        
+    def compose(self):
+        logging.info("compose")
+
+        # not entirely sure this actually will only run for n frames, may be better to just not specify a frame limit
+        if self._frame_limit:
+            self._ok_radar = holoscan.conditions.CountCondition(self, name="ok_radar", count=self._frame_limit)
+        else:
+            self._ok_radar = holoscan.conditions.BooleanCondition(self, name="ok_radar", enable_tick=True)
+        condition_radar = self._ok_radar
+
+        frame_context = self._cuda_context
+        receiver_operator_radar = hololink_module.operators.LinuxReceiverOperator(
+            self,
+            condition_radar,
+            name="receiver_radar",
+            frame_size=1200,
+            frame_context=frame_context,
+            hololink_channel=self._hololink_channel_radar,
+            device=self._radar,
+        )
+
+        parser_op = RadarParserOperator(self, name="radar_parser")
+        
+        self.add_flow(receiver_operator_radar, parser_op, {("output", "receiver_in")})
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--headless", action="store_true", help="Run in headless mode")
+    parser.add_argument(
+        "--frame-limit",
+        type=int,
+        default=None,
+        help="Exit after receiving this many frames",
+    )
+    parser.add_argument(
+        "--hololink",
+        default="192.168.0.2",
+        help="IP address of Hololink board",
+    )
+    # log level of 1 shows info and debug prints
+    parser.add_argument(
+        "--log-level",
+        type=int,
+        default=1,
+        help="Logging level to display",
+    )
+
+    args = parser.parse_args()
+    hololink_module.logging_level(args.log_level) #args.log_level)
+    logging.info("Initializing.")
+    # Get a handle to the GPU
+    (cu_result,) = cuda.cuInit(0)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+    cu_device_ordinal = 0
+    cu_result, cu_device = cuda.cuDeviceGet(cu_device_ordinal)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+    cu_result, cu_context = cuda.cuDevicePrimaryCtxRetain(cu_device)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+    # Get a handle to the Hololink device
+    channel_metadata = hololink_module.Enumerator.find_channel(channel_ip=args.hololink)
+    logging.info(f"{channel_metadata=}")
+
+    hololink_module.DataChannel.use_sensor(channel_metadata, 2)
+    
+    hololink_channel_radar = hololink_module.DataChannel(channel_metadata)
+
+    hololink = hololink_channel_radar.hololink()
+
+    # using MpsbCam for now since radar in theory doesn't need any specific elements in mpsb
+    radar_dev = mpsb.mpsb.MpsbCam(
+        hololink_channel_radar,
+        )
+
+    application = HoloscanApplication(
+        args.headless,
+        cu_context,
+        cu_device_ordinal,
+        hololink_channel_radar,
+        radar_dev,
+        args.frame_limit,
+    )
+
+    # Run it.
+    hololink = hololink_channel_radar.hololink()
+    #assert hololink is hololink_channel_right.hololink()
+    hololink.start()
+    hololink.reset()
+    
+    radar_dev.setup_clock()
+    camera_mode = mpsb.mpsb_mode.Mpsb_Mode.MODE_1920X1080_30FPS
+    radar_dev.configure(camera_mode)
+
+    time.sleep(2)
+
+    radar_dev.configure_gpio_fwd()
+
+    application.run()
+    hololink.stop()
+
+    (cu_result,) = cuda.cuDevicePrimaryCtxRelease(cu_device)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+
+
+if __name__ == "__main__":
+    main()
