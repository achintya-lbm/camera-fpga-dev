+        self._fullscreen = fullscreen
+        self._cuda_context = cuda_context
+        self._cuda_device_ordinal = cuda_device_ordinal
+        self._hololink_channel_list = hololink_channel_list
+        self._camera_list = camera_list
+        self._camera_mode = camera_mode
+        self._frame_limit = frame_limit
+        self._camera_count = len(camera_list)
+        self._configure_fpga = configure_fpga
+        assert self._camera_count == CAMERA_COUNT, f"Expected {CAMERA_COUNT} cameras for quad stream"
+        # These are HSDK controls-- because we have quad
+        # camera paths going into the same visualizer, don't
+        # raise an error when each path present metadata
+        # with the same names.  Because we don't use that metadata,
+        # it's easiest to just ignore new items with the same
+        # names as existing items.
+        self.is_metadata_enabled = True
+        self.metadata_policy = holoscan.core.MetadataPolicy.REJECT
+
+    def compose(self):
+        logging.info("compose")
+        for sensor_id in range(self._camera_count):
+            if self._frame_limit:
+                self._count = holoscan.conditions.CountCondition(
+                    self,
+                    name=f"count_{sensor_id}",
+                    count=self._frame_limit,
+                )
+                condition = self._count
+            else:
+                self._ok = holoscan.conditions.BooleanCondition(
+                    self, name=f"ok_{sensor_id}", enable_tick=True
+                )
+                condition = self._ok
+            self._camera_list[sensor_id].set_mode(self._camera_mode)
+
+        csi_to_bayer_pool_list = []
+
+        csi_to_bayer_block_size = (
+            self._camera_list[0]._width
+            * ctypes.sizeof(ctypes.c_uint16)
+            * self._camera_list[0]._height
+        )
+
+        for sensor_id in range(self._camera_count):
+            # Create a dedicated pool for each stream
+            pool = holoscan.resources.BlockMemoryPool(
+                self,
+                name=f"csi_to_bayer_pool_{sensor_id}",
+                # storage_type of 1 is device memory
+                storage_type=1,
+                block_size=csi_to_bayer_block_size,
+                num_blocks=6,
+            )
+            csi_to_bayer_pool_list.append(pool)
+
+        csi_to_bayer_operator_list = []
+        for sensor_id in range(self._camera_count):
+            csi_to_bayer_operator = hololink_module.operators.CsiToBayerOp(
+                self,
+                name=f"csi_to_bayer_{sensor_id}",
+                allocator=csi_to_bayer_pool_list[sensor_id], # Use the dedicated pool
+                cuda_device_ordinal=self._cuda_device_ordinal,
+                out_tensor_name=f"cam_{sensor_id}",
+            )
+            self._camera_list[sensor_id].configure_converter(csi_to_bayer_operator)
+            csi_to_bayer_operator_list.append(csi_to_bayer_operator)
+
+        if self._configure_fpga is not None:
+            self._configure_fpga()
+
+        frame_size = csi_to_bayer_operator.get_csi_length()
+        frame_context = self._cuda_context
+
+        receiver_operator_list = []
+        for sensor_id in range(self._camera_count):
+            receiver_operator = hololink_module.operators.LinuxReceiverOperator(
+                self,
+                condition,
+                name=f"receiver_{sensor_id}",
+                frame_size=frame_size,
+                frame_context=frame_context,
+                hololink_channel=self._hololink_channel_list[sensor_id],
+                device=self._camera_list[sensor_id],
+            )
+            receiver_operator_list.append(receiver_operator)
+
+        profiler_list = []
+        for sensor_id in range(self._camera_count):
+            profiler = InstrumentedTimeProfiler(
+                self,
+                name=f"profiler_{sensor_id}",
+            )
+            profiler_list.append(profiler)
+
+        image_processor_operator_list = []
+        for sensor_id in range(self._camera_count):
+            pixel_format = self._camera_list[sensor_id].pixel_format()
+            bayer_format = self._camera_list[sensor_id].bayer_format()
+            image_processor_operator = hololink_module.operators.ImageProcessorOp(
+                self,
+                name=f"image_processor_{sensor_id}",
+                optical_black=100,
+                bayer_format=bayer_format.value,
+                pixel_format=pixel_format.value,
+            )
+            image_processor_operator_list.append(image_processor_operator)
+
+        rgba_components_per_pixel = 4
+        demosaic_pool_list = []
+
+        demosaic_block_size = (
+            self._camera_list[0]._width
+            * rgba_components_per_pixel
+            * ctypes.sizeof(ctypes.c_uint16)
+            * self._camera_list[0]._height
+        )
+
+        # Create a pool for each stream
+        for sensor_id in range(self._camera_count):
+            pool = holoscan.resources.BlockMemoryPool(
+                self,
+                name=f"demosaic_pool_{sensor_id}",
+                # storage_type of 1 is device memory
+                storage_type=1,
+                block_size=demosaic_block_size,
+                num_blocks=6,
+            )
+            demosaic_pool_list.append(pool)
+
+        demosaic_list = []
+        for sensor_id in range(self._camera_count):
+            demosaic = holoscan.operators.BayerDemosaicOp(
+                self,
+                name=f"demosaic_{sensor_id}",
+                pool=demosaic_pool_list[sensor_id],
+                generate_alpha=True,
+                alpha_value=65535,
+                bayer_grid_pos=bayer_format.value,
+                interpolation_mode=0,
+                in_tensor_name=f"cam_{sensor_id}",
+                out_tensor_name=f"cam_{sensor_id}",
+            )
+            demosaic_list.append(demosaic)
+
+        # Create 2x2 layout for CAMERA_COUNT streams
+        spec_list = []
+        spec_view_list = []
+        for sensor_id in range(self._camera_count):
+            spec = holoscan.operators.HolovizOp.InputSpec(
+                f"cam_{sensor_id}", holoscan.operators.HolovizOp.InputType.COLOR
+            )
+            spec_view = holoscan.operators.HolovizOp.InputSpec.View()
+
+            cols = 2
+            rows = 2
+            col = sensor_id % cols
+            row = sensor_id // cols
+            spec_view.offset_x = col * (1.0 / cols)
+            spec_view.offset_y = row * (1.0 / rows)
+            spec_view.width = 0.5
+            spec_view.height = 0.5
+            spec.views = [spec_view]
+
+            spec_list.append(spec)
+            spec_view_list.append(spec_view)
+
+        visualizer = holoscan.operators.HolovizOp(
+            self,
+            name="holoviz",
+            fullscreen=self._fullscreen,
+            headless=self._headless,
+            tensors=spec_list,
+        )
+        #
+        for sensor_id in range(self._camera_count):
+            self.add_flow(receiver_operator_list[sensor_id], profiler_list[sensor_id], {("output", "input")})
+            self.add_flow(profiler_list[sensor_id], csi_to_bayer_operator_list[sensor_id], {("output", "input")})
+            self.add_flow(
+                csi_to_bayer_operator_list[sensor_id], image_processor_operator_list[sensor_id], {("output", "input")}
+            )
+            self.add_flow(image_processor_operator_list[sensor_id], demosaic_list[sensor_id], {("output", "receiver")})
+            self.add_flow(demosaic_list[sensor_id], visualizer, {("transmitter", "receivers")})
+
+
+def main():
+    global CAMERA_COUNT
+    parser = argparse.ArgumentParser()
+    modes = hololink_module.sensors.imx219.imx219_mode.Imx219_Mode
+    get_modes = lambda: [mode for mode in modes if mode is not modes.UNKNOWN]
+    mode_choices = [mode.value for mode in get_modes()]
+    mode_help = " ".join([f"{mode.value}:{mode.name}" for mode in get_modes()])
+    parser.add_argument(
+        "--camera-count",
+        type=int,
+        choices=[1, 2, 3, 4],
+        default=4,
+        help="Camera count"
+    )
+    parser.add_argument(
+        "--camera-mode",
+        type=int,
+        choices=mode_choices,
+        default=mode_choices[0],
+        help=mode_help,
+    )
+    parser.add_argument("--headless", action="store_true", help="Run in headless mode")
+    parser.add_argument(
+        "--fullscreen", action="store_true", help="Run in fullscreen mode"
+    )
+    parser.add_argument(
+        "--frame-limit",
+        type=int,
+        default=None,
+        help="Exit after receiving this many frames",
+    )
+    default_configuration = os.path.join(
+        os.path.dirname(__file__), "example_configuration.yaml"
+    )
+    parser.add_argument(
+        "--configuration",
+        default=default_configuration,
+        help="Configuration file",
+    )
+    parser.add_argument(
+        "--hololink",
+        default="192.168.0.2",
+        help="IP address of Hololink board",
+    )
+    parser.add_argument(
+        "--log-level",
+        type=int,
+        default=20,
+        help="Logging level to display",
+    )
+    parser.add_argument("--skip-setup", action="store_true", help="Skip SerDes and Camera setup")
+    parser.add_argument("--skip-reset", action="store_true", help="Skip hololink reset")
+
+    args = parser.parse_args()
+    hololink_module.logging_level(args.log_level)
+    logging.info("Initializing.")
+    # Get a handle to the GPU
+    (cu_result,) = cuda.cuInit(0)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+    cu_device_ordinal = 0
+    cu_result, cu_device = cuda.cuDeviceGet(cu_device_ordinal)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+    cu_result, cu_context = cuda.cuDevicePrimaryCtxRetain(cu_device)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+    # Get a handle to the data source
+    channel_metadata = hololink_module.Enumerator.find_channel(channel_ip=args.hololink)
+    channel_metadata_list = []
+    camera_list = []
+    hololink_channel_list = []
+    CAMERA_COUNT = args.camera_count
+    for sensor_id in range(CAMERA_COUNT): # Quad camera
+        channel_metadata_list.append(hololink_module.Metadata(channel_metadata))
+        hololink_module.DataChannel.use_sensor(
+                channel_metadata_list[sensor_id], sensor_id)
+        logging.debug(f"{channel_metadata=}")
+        #
+        hololink_channel = hololink_module.DataChannel(
+                channel_metadata_list[sensor_id])
+        hololink_channel_list.append(hololink_channel)
+
+        # Get a handle to the camera
+        camera = hololink_module.sensors.imx219.imx219.Imx219(hololink_channel, i2c_id=sensor_id)
+        camera_list.append(camera)
+
+    camera_mode = hololink_module.sensors.imx219.imx219_mode.Imx219_Mode(
+        args.camera_mode
+    )
+
+    def configure_fpga():
+        for sensor_id in range(CAMERA_COUNT): # Quad camera
+            boards.configure_fpga_datatype(
+                hololink_channel,
+                channel_metadata["board_description"],
+                sensor_id,
+                camera.pixel_format(),
+            )
+
+    # Set up the application
+    application = HoloscanApplication(
+        args.headless,
+        args.fullscreen,
+        cu_context,
+        cu_device_ordinal,
+        hololink_channel_list,
+        camera_list,
+        camera_mode,
+        args.frame_limit,
+        configure_fpga,
+    )
+    application.config(args.configuration)
+    # Run it.
+    hololink = hololink_channel.hololink()
+    hololink.start()
+
+    # Init GPIO
+    _GPIO = hololink.get_gpio(channel_metadata)
+
+    if not args.skip_setup:
+        if not args.skip_reset:
+            hololink.reset()
+
+        # Cycle camera power
+        board_name = channel_metadata["board_description"]
+        power_enable_gpio_list = []
+        for sensor_id in range(len(channel_metadata_list)):
+            power_enable_gpio = gpio.GPIO_PIN_MAP.get(board_name, {}).get(
+                    gpio.GPIO_CAM0_PWR_EN_L + sensor_id)
+            power_enable_gpio_list.append(power_enable_gpio)
+
+        for power_enable_gpio in power_enable_gpio_list:
+            if power_enable_gpio is not None:
+                utils.enable_camera_power(_GPIO, enable=False, pin=power_enable_gpio)
+            else:
+                logging.error(f"Invalid sensor ID ({sensor_id}) for board {board_name}. Camera power cycle skipped")
+        time.sleep(1)
+
+        for power_enable_gpio in power_enable_gpio_list:
+            if power_enable_gpio is not None:
+                utils.enable_camera_power(_GPIO, enable=True, pin=power_enable_gpio)
+            else:
+                logging.error(f"Invalid sensor ID ({sensor_id}) for board {board_name}. Camera power cycle skipped")
+        time.sleep(1)
+
+        # Configure Camera
+        camera = camera_list[0]
+        if not args.skip_reset:
+            camera.setup_clock()
+        for camera in camera_list:
+            camera.configure()
+
+    logging.info("Calling run")
+    application.run()
+    hololink.stop()
+
+    (cu_result,) = cuda.cuDevicePrimaryCtxRelease(cu_device)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+
+
+if __name__ == "__main__":
+    main()
