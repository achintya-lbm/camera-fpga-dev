+from collections import OrderedDict, namedtuple
+from enum import Enum
+
+import hololink
+
+# values are on hex number system to be consistent with rest of the list
+MPSB_TABLE_WAIT_MS = "mpsb-table-wait-ms"
+
+# MAX929x I2C address
+MAX9295E_SER_ADDR_DEF = 0x40  # MAX9295E default i2c address
+MAX9295E_SER_ADDR_A = 0x40
+MAX96716A_DESER_ADDR = 0x28
+
+
+class GmslLink(Enum):
+    LINK_A = 0
+    LINK_B = 1
+
+
+GMSL_LINK = GmslLink.LINK_A
+
+
+def get_max929x_serdes_mpsb():
+    return [
+        (MAX96716A_DESER_ADDR, 0x0010, 0x80),  # Reset link oneshot, auto link a channel only
+        (MAX96716A_DESER_ADDR, MPSB_TABLE_WAIT_MS, 100),
+        (MAX96716A_DESER_ADDR, 0x0010, 0x21),  # Reset link oneshot, auto link a channel only
+        (MAX96716A_DESER_ADDR, MPSB_TABLE_WAIT_MS, 100),
+
+        (MAX96716A_DESER_ADDR, 0x0313, 0x00),  # CSI output disable
+        
+        # --- Serializer (MAX9295E) Configuration ---
+        (MAX9295E_SER_ADDR_A, 0x0010, 0x21),  # reset
+        (MAX9295E_SER_ADDR_A, MPSB_TABLE_WAIT_MS, 100),
+
+        (MAX9295E_SER_ADDR_A, 0x0002, 0x03),  # disable video output
+
+        (MAX9295E_SER_ADDR_A, 0x0005, 0x00),  # Disable LOCK_EN and ERRB_EN
+
+        (MAX9295E_SER_ADDR_A, 0x0330, 0x84),  # Enable CSI,  Phy Conf A
+        (MAX9295E_SER_ADDR_A, 0x0331, 0x33),  #
+        (MAX9295E_SER_ADDR_A, 0x0332, 0x4E),  # Lane Mapping
+        (MAX9295E_SER_ADDR_A, 0x0334, 0x00),  #
+        
+        (MAX9295E_SER_ADDR_A, 0x0311, 0x03),  # start video
+        (MAX9295E_SER_ADDR_A, 0x0314, 0x5E),  # Data Type Pipe X YUV422_8B
+        (MAX9295E_SER_ADDR_A, 0x0316, 0x5E),  # Data Type Pipe Y YUV422_8B
+        (MAX9295E_SER_ADDR_A, 0x0309, 0x01),  # vcsel x l
+        (MAX9295E_SER_ADDR_A, 0x030b, 0x02),  # vcsel y l
+        
+        (MAX9295E_SER_ADDR_A, 0x0053, 0x10),  # Pipe X: Stream ID 0
+        (MAX9295E_SER_ADDR_A, 0x0057, 0x11),  # Pipe Y: Stream ID 1
+        
+        # --- Deserializer (MAX96716A) Configuration ---
+        (MAX96716A_DESER_ADDR, 0x0003, 0x03),  # UART disable
+        (MAX96716A_DESER_ADDR, 0x0005, 0x00),  # LOCK_EN/ERRB_EN disable
+        
+        (MAX96716A_DESER_ADDR, 0x0161, 0x08),  # Pipe Y Rx stream ID: 0, Link A, Pipe Z: 1, Link A
+
+        (MAX96716A_DESER_ADDR, 0x044B, 0x07),
+        (MAX96716A_DESER_ADDR, 0x044D, 0x1E),
+        (MAX96716A_DESER_ADDR, 0x044E, 0x1E),
+        (MAX96716A_DESER_ADDR, 0x044F, 0x00),
+        (MAX96716A_DESER_ADDR, 0x0450, 0x00),
+        (MAX96716A_DESER_ADDR, 0x0451, 0x01),
+        (MAX96716A_DESER_ADDR, 0x0452, 0x01),
+        (MAX96716A_DESER_ADDR, 0x046D, 0x15),
+        
+        (MAX96716A_DESER_ADDR, 0x048B, 0x07),
+        (MAX96716A_DESER_ADDR, 0x048D, 0x5E),
+        (MAX96716A_DESER_ADDR, 0x048E, 0x5E),
+        (MAX96716A_DESER_ADDR, 0x048F, 0x40),
+        (MAX96716A_DESER_ADDR, 0x0490, 0x40),
+        (MAX96716A_DESER_ADDR, 0x0491, 0x41),
+        (MAX96716A_DESER_ADDR, 0x0492, 0x41),
+        (MAX96716A_DESER_ADDR, 0x04AD, 0x2A),
+        
+        (MAX96716A_DESER_ADDR, 0x0330, 0x04),  # Set MIPI Phy Mode: 2x(1x4)
+        (MAX96716A_DESER_ADDR, 0x0333, 0x4E),  # lane mapping
+        (MAX96716A_DESER_ADDR, 0x0334, 0xE4),  # lane mapping
+        #(MAX96716A_DESER_ADDR, 0x030B, 0x05),  # Enable VC0 for pipe Y
