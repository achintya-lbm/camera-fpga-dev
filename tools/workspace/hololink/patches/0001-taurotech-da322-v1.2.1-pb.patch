diff --git a/src/hololink/core/mpsb/dtof/dtof_ctrl.cpp b/src/hololink/core/mpsb/dtof/dtof_ctrl.cpp
new file mode 100644
index 0000000..06c240e
--- /dev/null
+++ b/src/hololink/core/mpsb/dtof/dtof_ctrl.cpp
@@ -0,0 +1,227 @@
+// Boston Dynamics, Inc. Confidential Information.
+// Copyright 2025. All Rights Reserved.
+
+#include "dtof_ctrl.h"
+#include "platform.h"
+#include "vl53l8cx_api.h"
+#include <cstdint>
+#include <cstring>
+#include <hololink/core/serializer.hpp>
+#include <memory>
+#include <stdio.h>
+#include <vector>
+
+namespace hololink::core {
+namespace {
+void write_i2c_reg8(std::shared_ptr<hololink::Hololink::I2c> i2c, uint32_t i2c_addr, uint32_t reg,
+    uint8_t to_write) {
+    std::vector<uint8_t> write_bytes(16);
+    hololink::core::Serializer serializer(write_bytes.data(), write_bytes.size());
+    serializer.append_uint16_be(reg);
+    serializer.append_uint8(to_write);
+    write_bytes.resize(serializer.length());
+    i2c->i2c_transaction(i2c_addr, write_bytes, 0);
+}
+
+uint8_t read_i2c_reg8(std::shared_ptr<hololink::Hololink::I2c> i2c, const uint32_t i2c_addr,
+                      const uint32_t reg) {
+    std::vector<uint8_t> write_bytes(2);
+    hololink::core::Serializer serializer(write_bytes.data(), write_bytes.size());
+    serializer.append_uint16_be(reg);
+    std::vector<uint8_t> read_byte = i2c->i2c_transaction(i2c_addr, write_bytes, 1);
+    return read_byte[0];
+}
+
+void hold_dtof_reset(std::shared_ptr<hololink::Hololink::I2c> i2c, bool reset,
+    uint32_t reset_hold_time_ms) {
+    if (reset) {
+        write_i2c_reg8(i2c, 0x40, 0x02E5, 0x80);
+        write_i2c_reg8(i2c, 0x40, 0x02E5, 0x90);
+    } else {
+        write_i2c_reg8(i2c, 0x40, 0x02E5, 0x80);
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(reset_hold_time_ms));
+    printf("set dtof reset to %s. \n", reset ? "true" : "false");
+}
+
+VL53L8CX_Configuration get_dtof_dev_init_state(std::shared_ptr<hololink::Hololink::I2c> i2c) {
+    VL53L8CX_Configuration dtof_dev;
+    dtof_dev.platform.address = VL53L8CX_DFLT_I2C_ADDR;
+    dtof_dev.platform.ser_addr = 0x40;
+    dtof_dev.platform.hololink_i2c = i2c.get();
+    return dtof_dev;
+}
+
+bool wait_dtof_data_ready(std::shared_ptr<hololink::Hololink::I2c> i2c, uint16_t timeout_ms = 200) {
+    uint8_t poll_interval_ms = 5;
+    for (uint8_t i = 0; i < timeout_ms / poll_interval_ms; i++) {
+        if (!(read_i2c_reg8(i2c, 0x40, 0x02E2) & (1 << 3))) {
+            return true;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(poll_interval_ms));
+    }
+    return false;
+}
+} // namespace
+
+DtofCtrl::DtofCtrl(std::shared_ptr<hololink::Hololink::I2c> i2c, bool debug)
+    : m_i2c(i2c), m_debug(debug) {
+    printf("DtofCtrl constructor called. \n");
+    m_dtof_dev = get_dtof_dev_init_state(m_i2c);
+}
+
+bool DtofCtrl::init() {
+    printf("DtofCtrl init called. \n");
+    hold_dtof_reset(m_i2c, true, 50);
+    hold_dtof_reset(m_i2c, false, 50);
+    printf("Finished resetting dtof. \n");
+
+    set_debug_state(m_debug);
+
+    uint8_t status = 0;
+    uint8_t is_alive = 0;
+
+    printf("Checking if VL53L8CX sensor is alive at address 0x%02X. \n",
+        m_dtof_dev.platform.address);
+    status = vl53l8cx_is_alive(&m_dtof_dev, &is_alive);
+    if (status != 0 || is_alive == 0) {
+        fprintf(stderr, "Sensor not detected, status %u. \n", status);
+        return false;
+    }
+    printf("Dtof sensor found and alive\n");
+
+    printf("Init dtof start. \n");
+    status = vl53l8cx_init(&m_dtof_dev);
+    if (status != 0) {
+        fprintf(stderr, "Failed to initialize VL53L8CX sensor (status: %u). \n", status);
+        return false;
+    }
+    printf("Dtof sensor initialized. \n");
+
+    printf("Configuring sensor to 8x8 resolution and 15Hz. \n");
+    status = vl53l8cx_set_resolution(&m_dtof_dev, VL53L8CX_RESOLUTION_8X8);
+    if (status != 0) {
+        fprintf(stderr, "Failed to set resolution (status: %u). \n", status);
+        return false;
+    }
+
+    status = vl53l8cx_set_ranging_frequency_hz(&m_dtof_dev, 15);
+    if (status != 0) {
+        fprintf(stderr, "Failed to set ranging frequency (status: %u). \n", status);
+        return false;
+    }
+
+    status = vl53l8cx_set_ranging_mode(&m_dtof_dev, VL53L8CX_RANGING_MODE_AUTONOMOUS);
+    if (status != 0) {
+        fprintf(stderr, "Failed to set ranging mode (status: %u). \n", status);
+        return false;
+    }
+    printf("Finished setting resolution to 8x8 at 15Hz, mode to autonomous. \n");
+
+    status = vl53l8cx_set_integration_time_ms(&m_dtof_dev, 5);
+    if (status != 0) {
+        fprintf(stderr, "Failed to set integration time (status: %u). \n", status);
+        return false;
+    }
+    printf("Finished setting integration time to 5ms. \n");
+
+    status = vl53l8cx_set_external_sync_pin_enable(&m_dtof_dev, 1);
+    if (status != 0) {
+        fprintf(stderr, "Failed to set external sync pin enable (status: %u). \n", status);
+        return false;
+    }
+    printf("Finished setting external sync pin enable. \n");
+
+    uint32_t integration_time_ms = 0;
+    status = vl53l8cx_get_integration_time_ms(&m_dtof_dev, &integration_time_ms);
+    if (status != 0) {
+        fprintf(stderr, "Failed to get integration time (status: %u). \n", status);
+        return false;
+    }
+    printf("Current integration time: %u. \n", integration_time_ms);
+
+    return true;
+}
+
+bool DtofCtrl::start() {
+    printf("Starting ranging. \n");
+    uint8_t status = 0;
+    status = vl53l8cx_start_ranging(&m_dtof_dev);
+    if (status != 0) {
+        fprintf(stderr, "Failed to start ranging (status: %u). \n", status);
+        return false;
+    }
+    printf("Ranging started. \n");
+    return true;
+}
+
+bool DtofCtrl::stop() {
+    printf("Stopping ranging...\n");
+    uint8_t status = 0;
+    status = vl53l8cx_stop_ranging(&m_dtof_dev);
+    if (status != 0) {
+        fprintf(stderr, "Failed to stop ranging (status: %u). \n", status);
+        return false;
+    }
+    return true;
+}
+
+bool DtofCtrl::wait_for_next_frame() {
+    VL53L8CX_ResultsData results;
+    uint8_t status = 0;
+    uint8_t is_ready = 0;
+    // To be replaced by DMA backed receiver
+    // Poll for data ready for up to 200ms
+    // if (!wait_dtof_data_ready(m_i2c)) {
+    //     fprintf(stderr, "DToF ready failed to go high after 200ms \n");
+    //     return false;
+    // }
+    for (int i = 0; i < 40; i ++) {
+        status = vl53l8cx_check_data_ready(&m_dtof_dev, &is_ready);
+        if (is_ready && (status == 0)) {
+            break;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    }
+    if ((status != 0) || (is_ready != 1)) {
+        fprintf(stderr, "DToF new data not found\n (status: %u)", status);
+        return false;
+    }
+    printf("DToF indicates data ready \n");
+
+    uint8_t raw_data[VL53L8CX_TEMPORARY_BUFFER_SIZE] = {0};
+    status |= vl53l8cx_get_raw_ranging_data(&m_dtof_dev, raw_data);
+    // end of code to be replaced by DMA backed receiver
+    // store raw vector from DMA in raw_data
+
+    status = vl53l8cx_parse_ranging_data(&m_dtof_dev, raw_data, sizeof(raw_data), &results);
+
+    if (status != 0) {
+        fprintf(stderr, "Failed to get ranging data (status: %u). \n", status);
+        return false;
+    }
+
+    m_cur_dtof_frame.results = results;
+
+    return true;
+}
+
+DtofFrame DtofCtrl::parse_frame(const std::vector<uint8_t>& raw_data) {
+    DtofFrame dtof_frame;
+    VL53L8CX_ResultsData results;
+    uint8_t status = 0;
+
+    std::vector<uint8_t> data_to_parse = raw_data;
+    status = vl53l8cx_parse_ranging_data(&m_dtof_dev, data_to_parse.data(), data_to_parse.size(), &results);
+
+    if (status != 0) {
+        fprintf(stderr, "Failed to parse ranging data (status: %u). \n", status);
+        return dtof_frame;
+    }
+
+    dtof_frame.results = results;
+    return dtof_frame;
+}
+
+const DtofFrame& DtofCtrl::get_frame() { return m_cur_dtof_frame; }
+} // namespace hololink::core
