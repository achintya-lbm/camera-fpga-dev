+++ b/examples/i2c.py
@@ -0,0 +1,171 @@
+import argparse
+import logging
+import os
+import time
+
+import holoscan
+
+import hololink as hololink_module
+
+import utils
+
+
+class I2c:
+    def __init__(
+        self,
+        hololink_channel,
+        i2c_bus=hololink_module.CAM_I2C_BUS,
+    ):
+        self._i2c_bus = i2c_bus
+        self._hololink = hololink_channel.hololink()
+        self._i2c = self._hololink.get_i2c(self._i2c_bus)
+
+    def i2c_get_register(self, i2c_address, register, reg_size=2, size=2):
+        write_bytes = bytearray(100)
+        serializer = hololink_module.Serializer(write_bytes)
+        for i in range(reg_size):
+            serializer.append_uint8((register >> ((reg_size - i - 1) * 8)) & 0xFF)
+        read_byte_count = size
+        reply = self._i2c.i2c_transaction(
+            i2c_address, write_bytes[: serializer.length()], read_byte_count
+        )
+        deserializer = hololink_module.Deserializer(reply)
+        r = 0
+        for i in range(size):
+            r |= deserializer.next_uint8() << ((size - i - 1) * 8)
+        logging.info(
+            "get_register(i2c_addr=%d(0x%X), register=%d(0x%X),value=%d(0x%X))" % (i2c_address, i2c_address, register, register, r, r)
+        )
+        return r
+
+    def i2c_scan(self):
+        for i2c_address in range(7, 128):
+            write_bytes = bytearray(100)
+            serializer = hololink_module.Serializer(write_bytes)
+            read_byte_count = 0
+            try:
+                reply = self._i2c.i2c_transaction(
+                    i2c_address, write_bytes[: serializer.length()], read_byte_count
+                )
+                logging.info(
+                    "i2c_scan(i2c_addr=%d(0x%X))" % (i2c_address, i2c_address)
+                )
+            except Exception as e:
+                logging.error("%s: NAK at %d(0x%X)" % (e, i2c_address, i2c_address))
+
+    def i2c_set_register(self, i2c_address, register, value, reg_size=2, size=1, timeout=None):
+        logging.info(
+            "set_register(i2c address=%d(0x%X), register=%d(0x%X), value=%d(0x%X))"
+            % (i2c_address, i2c_address, register, register, value, value)
+        )
+        write_bytes = bytearray(100)
+        serializer = hololink_module.Serializer(write_bytes)
+        for i in range(reg_size):
+            serializer.append_uint8((register >> ((reg_size - i - 1) * 8)) & 0xFF)
+        for i in range(size):
+            serializer.append_uint8((value >> ((size - i - 1) * 8)) & 0xFF)
+        read_byte_count = 0
+        self._i2c.i2c_transaction(
+            i2c_address,
+            write_bytes[: serializer.length()],
+            read_byte_count,
+            timeout=timeout,
+        )
+
+
+def main():
+    parser = argparse.ArgumentParser()
+
+    parser.add_argument(
+        "address",
+        type=utils.auto_int,
+        default=0,
+        help="Device address",
+    )
+    parser.add_argument(
+        "register",
+        type=utils.auto_int,
+        default=0,
+        help="Register address",
+    )
+    parser.add_argument(
+        "--set",
+        type=utils.auto_int,
+        help="Set register value",
+    )
+    parser.add_argument(
+        "--get",
+        action="store_true",
+        help="Get register value",
+    )
+    parser.add_argument(
+        "--scan",
+        action="store_true",
+        help="Scan I2C bus",
+    )
+    parser.add_argument(
+        "--bus",
+        type=int,
+        default=hololink_module.CAM_I2C_BUS,
+        help="I2C bus to run on",
+    )
+    parser.add_argument(
+        "-b", "--bytes",
+        type=int,
+        default=1,
+        help="Size of the register in bytes",
+    )
+    parser.add_argument(
+        "--hololink",
+        default="192.168.0.2",
+        help="IP address of Hololink board",
+    )
+    parser.add_argument(
+        "--no-setup-clock",
+        action="store_true",
+        help="Don't setup hololink clock",
+    )
+    parser.add_argument(
+        "--reset",
+        action="store_true",
+        help="Reset the hololink before action",
+    )
+    parser.add_argument(
+        "--log-level",
+        type=int,
+        default=20,
+        help="Logging level to display",
+    )
+
+    args = parser.parse_args()
+    hololink_module.logging_level(args.log_level)
+    logging.info("Initializing.")
+
+    # Get a handle to the Hololink device
+    channel_metadata = hololink_module.Enumerator.find_channel(channel_ip=args.hololink)
+    hololink_channel = hololink_module.DataChannel(channel_metadata)
+
+    hololink = hololink_channel.hololink()
+    hololink.start()
+    if not args.no_setup_clock:
+        hololink.setup_clock(
+                []
+        )
+    if args.reset:
+        hololink.reset()
+    i2c = I2c(
+        hololink_channel,
+        i2c_bus=args.bus,
+    )
+    if args.scan:
+        i2c.i2c_scan()
+    else:
+        if args.set is not None:
+            i2c.i2c_set_register(args.address, args.register, args.set, reg_size=2, size=args.bytes)
+        if args.get:
+            val = i2c.i2c_get_register(args.address, args.register, reg_size=2, size=args.bytes)
+    hololink.stop()
+
+
+if __name__ == "__main__":
+    main()
