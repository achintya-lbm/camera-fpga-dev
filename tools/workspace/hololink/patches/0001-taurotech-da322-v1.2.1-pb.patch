+
+import argparse
+import logging
+
+import hololink as hololink_module
+import holoscan
+import cuda.bindings.driver as cuda
+from hololink.sensors import mpsb
+import cupy as cp
+import numpy as np
+
+def print_dtof_frame(frame):
+    """Prints the distance data from a DToF frame in an 8x8 grid."""
+    if not frame or not frame.results:
+        print("Invalid DToF frame.")
+        return
+
+    distances = frame.results.distance_mm.T
+    print("--- DToF Frame ---")
+    for r in range(distances.shape[0]):
+        row_str = " ".join([f"{dist:5d}" for dist in distances[r, :]])
+        print(row_str)
+    print("---------------------\n")
+
+class DtofParserOperator(holoscan.core.Operator):
+    """Custom Holoscan operator to parse and print DToF data."""
+
+    def __init__(self, fragment, dtof_ctrl, *args, **kwargs):
+        """Initializes the DtofParserOperator.
+        
+        Args:
+            fragment: The fragment that this operator belongs to.
+            dtof_ctrl: An instance of the C++ DtofCtrl class for parsing.
+        """
+        self.dtof_ctrl = dtof_ctrl
+        super().__init__(fragment, *args, **kwargs)
+
+    def setup(self, spec: holoscan.core.OperatorSpec):
+        spec.input("receiver_in")
+
+    def compute(self, op_input, op_output, context):
+        message = op_input.receive("receiver_in")
+        if message is None:
+            return
+
+        data_tensor = message.get("")
+        if data_tensor is None:
+            logging.warning("Received message without tensor.")
+            return
+
+        # Convert the cupy GPU tensor to a Python list of integers to pass to C++.
+        raw_data = cp.asarray(data_tensor, dtype=cp.uint8).get().tolist()
+
+        try:
+            # Call the refactored C++ method to parse the raw data
+            frame = self.dtof_ctrl.parse_frame(raw_data)
+            print_dtof_frame(frame)
+
+        except Exception as e:
+            logging.error(f"Error parsing DToF frame: {e}")
+
+class HoloscanApplication(holoscan.core.Application):
+    """Holoscan Application for DToF data processing."""
+    def __init__(
+        self,
+        headless,
+        cuda_context,
+        cuda_device_ordinal,
+        hololink_channel_dtof,
+        dtof_dev,
+        dtof_ctrl,
+        frame_limit,
+    ):
+        logging.info("__init__")
+        super().__init__()
+        self._headless = headless
+        self._cuda_context = cuda_context
+        self._cuda_device_ordinal = cuda_device_ordinal
+        self._hololink_channel_dtof = hololink_channel_dtof
+        self._dtof_dev = dtof_dev
+        self._dtof_ctrl = dtof_ctrl
+        self._frame_limit = frame_limit
+
+    def compose(self):
+        logging.info("compose")
+
+        if self._frame_limit:
+            condition_dtof = holoscan.conditions.CountCondition(
+                self, name="ok_dtof", count=self._frame_limit
+            )
+        else:
+            condition_dtof = holoscan.conditions.BooleanCondition(
+                self, name="ok_dtof", enable_tick=True
+            )
+
+        receiver_operator_dtof = hololink_module.operators.LinuxReceiverOperator(
+            self,
+            condition_dtof,
+            name="receiver_dtof",
+            frame_size=1444,  # Set a safe frame size for DToF data
+            frame_context=self._cuda_context,
+            hololink_channel=self._hololink_channel_dtof,
+            device=self._dtof_dev,
+        )
+
+        parser_op = DtofParserOperator(self, name="dtof_parser", dtof_ctrl=self._dtof_ctrl)
+
+        self.add_flow(receiver_operator_dtof, parser_op, {("output", "receiver_in")})
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--headless", action="store_true", help="Run in headless mode")
+    parser.add_argument(
+        "--frame-limit",
+        type=int,
+        default=None,
+        help="Exit after receiving this many frames",
+    )
+    parser.add_argument(
+        "--hololink",
+        default="192.168.0.2",
+        help="IP address of Hololink board",
+    )
+    # log level of 1 shows info and debug prints
+    parser.add_argument(
+        "--log-level",
+        type=int,
+        default=1,
+        help="Logging level to display",
+    )
+    parser.add_argument(
+        "--debug",
+        action="store_true",
+        help="Enable DToF debug mode",
+    )
+
+    args = parser.parse_args()
+    hololink_module.logging_level(args.log_level) #args.log_level)
+    logging.info("Initializing.")
+    # Get a handle to the GPU
+    (cu_result,) = cuda.cuInit(0)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+    cu_device_ordinal = 0
+    cu_result, cu_device = cuda.cuDeviceGet(cu_device_ordinal)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+    cu_result, cu_context = cuda.cuDevicePrimaryCtxRetain(cu_device)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+    # Get a handle to the Hololink device
+    channel_metadata = hololink_module.Enumerator.find_channel(channel_ip=args.hololink)
+    logging.info(f"{channel_metadata=}")
+
+    hololink_module.DataChannel.use_sensor(channel_metadata, 3)
+    
+    hololink_channel_dtof = hololink_module.DataChannel(channel_metadata)
+
+    hololink = hololink_channel_dtof.hololink()
+
+    # using MpsbCam for now since radar in theory doesn't need any specific elements in mpsb
+    dtof_dev = mpsb.mpsb.MpsbCam(
+        hololink_channel_dtof
+        )
+    
+    i2c = hololink.get_i2c(1)
+    DtofCtrl = hololink_module.DtofCtrl
+    dtof_ctrl = DtofCtrl(i2c, args.debug)
+    logging.info(f"{dtof_ctrl}")
+
+    application = HoloscanApplication(
+        args.headless,
+        cu_context,
+        cu_device_ordinal,
+        hololink_channel_dtof,
+        dtof_dev,
+        dtof_ctrl,
+        args.frame_limit,
+    )
+
+    # Run it.
+    hololink = hololink_channel_dtof.hololink()
+    #assert hololink is hololink_channel_right.hololink()
+    hololink.start()
+    hololink.reset()
+    
+    dtof_dev.setup_clock()
+    camera_mode = mpsb.mpsb_mode.Mpsb_Mode.MODE_1920X1080_30FPS
+    dtof_dev.configure(camera_mode)
+
+    if not dtof_ctrl.init():
+        raise RuntimeError("Failed to initialize DToF controller.")
+    logging.info("DtofCtrl Init completed")
+
+    if not dtof_ctrl.start():
+            raise RuntimeError("Failed to start DToF ranging.")
+    logging.info("DtofCtrl Start completed")
+
+    # Enable dtof trigger forwarding after initialization and ranging started
+    dtof_dev.configure_gpio_fwd()
+    logging.info("GPIO forwarding configured.")
+
+    logging.info("Streaming DToF data via DMA. Press Ctrl+C to stop.")
+    application.run()
+
+    hololink.stop()
+    (cu_result,) = cuda.cuDevicePrimaryCtxRelease(cu_device)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+
+
+if __name__ == "__main__":
+    main()
