+    def set_pll(self):
+        link_frequencies = 486_000_000
+        bps_pr_lane = 2 * link_frequencies
+        self._pll_fbd = bps_pr_lane // self._refclk_hz * self._pll_prd
+
+        pllctl0 = self.get_register(tc358743_reg.PLLCTL0, size=2)
+        pllctl1 = self.get_register(tc358743_reg.PLLCTL1, size=2)
+        pllctl0_new = tc358743_reg.SET_PLL_PRD(self._pll_prd) | tc358743_reg.SET_PLL_FBD(self._pll_fbd)
+        hsck = (self._refclk_hz / self._pll_prd) * self._pll_fbd
+
+        logging.debug("Setting pll")
+
+        """Only rewrite when needed (new value or disabled), since rewriting
+           triggers another format change event."""
+        if ((pllctl0 != pllctl0_new) or ((pllctl1 & tc358743_reg.MASK_PLL_EN) == 0)):
+            pll_frs = 0
+
+            if (hsck > 500000000):
+                pll_frs = 0x0
+            elif (hsck > 250000000):
+                pll_frs = 0x1
+            elif (hsck > 125000000):
+                pll_frs = 0x2
+            else:
+                pll_frs = 0x3
+
+            logging.debug("Updating PLL clock")
+            self.sleep_mode(True)
+            self.set_register(tc358743_reg.PLLCTL0, pllctl0_new, size=2)
+            self._i2c_wr16_and_or(tc358743_reg.PLLCTL1,
+                    ~(tc358743_reg.MASK_PLL_FRS | tc358743_reg.MASK_RESETB | tc358743_reg.MASK_PLL_EN), \
+                    (tc358743_reg.SET_PLL_FRS(pll_frs) | tc358743_reg.MASK_RESETB | \
+                    tc358743_reg.MASK_PLL_EN))
+            time.sleep(10 / 1000000) # REF_02, Sheet "Source HDMI"
+            self._i2c_wr16_and_or(tc358743_reg.PLLCTL1, ~tc358743_reg.MASK_CKEN, tc358743_reg.MASK_CKEN)
+            self.sleep_mode(False)
+
+
+    def initial_setup(self):
+        """Initial setup of the bridge"""
+        self._i2c_wr16_and_or(tc358743_reg.SYSCTL, ~(tc358743_reg.MASK_IRRST | tc358743_reg.MASK_CECRST), \
+                            (tc358743_reg.MASK_IRRST | tc358743_reg.MASK_CECRST))
+
+        # Reset the bridge
+        self.reset(tc358743_reg.MASK_CTXRST | tc358743_reg.MASK_HDMIRST)
+
+        self.sleep_mode(False)
+
+        self.set_register(tc358743_reg.FIFOCTL, 0x176, size=2)
+
+        self.set_ref_clk()
+
+        self._i2c_wr8_and_or(tc358743_reg.DDC_CTL, ~tc358743_reg.MASK_DDC5V_MODE, \
+                            tc358743_reg.DDC5V_DELAY_100_MS & tc358743_reg.MASK_DDC5V_MODE)
+        self._i2c_wr8_and_or(tc358743_reg.EDID_MODE, ~tc358743_reg.MASK_EDID_MODE, tc358743_reg.MASK_EDID_MODE_E_DDC)
+
+        self.set_hdmi_phy()
+        self.set_hdmi_hdcp(enable=False)
+        self.set_hdmi_audio()
+        self.set_hdmi_info_frame_mode()
+
+        """All CE and IT formats are detected as RGB full range in DVI mode"""
+        self._i2c_wr8_and_or(tc358743_reg.VI_MODE, ~tc358743_reg.MASK_RGB_DVI, 0)
+
