index 0000000..49fc018
--- /dev/null
+++ b/tools/holoscan_control.py
@@ -0,0 +1,101 @@
+import os
+import argparse
+import sys
+import logging
+
+from pathlib import Path
+
+BIN_DIR = '/usr/local/lib/python3.12/dist-packages/hololink/bin/'
+
+PREFIXES = [
+    'hololink-',
+]
+
+BLACKLIST = [
+    'signal_generator',
+]
+
+logging.basicConfig(level=logging.INFO)
+
+class HoloscanControl:
+    def __init__(self):
+        self._bin_dir = BIN_DIR
+        self._init_binaries()
+
+    def _init_binaries(self):
+        directory = Path(self._bin_dir)
+        binaries = []
+
+        for file in directory.iterdir():
+            if file.is_file() and os.access(file, os.X_OK):
+                binaries.append(file)
+
+        self._binaries = dict()
+
+        for file in binaries:
+            basename = os.path.basename(str(file))
+            if basename in BLACKLIST:
+                continue
+            # Remove unwanted prefixes
+            for prefix in PREFIXES:
+                if prefix in basename:
+                    basename = basename.removeprefix(prefix)
+                    break
+            self._binaries[basename] = file
+
+    def get_cmds(self):
+        return list(self._binaries.keys())
+
+    def run(self, cmd: str, extra_args):
+        """Execute the selected binary with the remaining arguments"""
+        if cmd not in self._binaries:
+            logging.info(f"Unknown command: {cmd}", file=sys.stderr)
+            sys.exit(1)
+
+        binary_path = str(self._binaries[cmd])
+        full_command = [binary_path] + extra_args
+
+        logging.debug(f"Executing: {''.join(full_command)}")  # optional debug line
+        try:
+            # Use execve-style replacement so signals (Ctrl-C) work correctly
+            os.execvp(binary_path, full_command)
+        except FileNotFoundError:
+            logging.info(f"Binary not found: {binary_path}", file=sys.stderr)
+            sys.exit(127)
+        except PermissionError:
+            logging.info(f"Permission denied executing {binary_path}", file=sys.stderr)
+            sys.exit(126)
+
+
+def main():
+    holoscan_control = HoloscanControl()
+    available_cmds = holoscan_control.get_cmds()
+
+    if not available_cmds:
+        logging.info("No hololink binaries found in", BIN_DIR, file=sys.stderr)
+        sys.exit(1)
+
+    parser = argparse.ArgumentParser(
+        description="Unified wrapper for hololink tools",
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog=f"Available commands: {', '.join(available_cmds)}"
+    )
+    parser.add_argument(
+        "cmd",
+        choices=available_cmds,
+        help="Sub-command to run",
+        metavar='CMD'
+    )
+    parser.add_argument(
+        "extra_args",
+        nargs=argparse.REMAINDER,
+        help="Arguments to pass to the underlying binary"
+    )
+
+    args = parser.parse_args()
+
+    # Run the selected binary with all remaining arguments
+    holoscan_control.run(args.cmd, args.extra_args)
+
+if __name__ == '__main__':
+    main()
