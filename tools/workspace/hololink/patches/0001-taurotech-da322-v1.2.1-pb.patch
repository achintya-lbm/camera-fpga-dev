diff --git a/examples/multi_player.py b/examples/multi_player.py
new file mode 100644
index 0000000..02936da
--- /dev/null
+++ b/examples/multi_player.py
@@ -0,0 +1,89 @@
+import json
+import os
+import argparse
+import logging
+import subprocess
+import time
+import threading
+
+import hololink as hololink_module
+
+DEFAULT_CONFIGURATION = "multi_camera_config/example.json"
+
+EXECUTION_DELAY_SEC = 15
+
+AUX_DELAY_TABLE = {
+    "linux_tc358743_player.py": 10,
+}
+
+def reset_hololink(channel_ip, log_level):
+    hololink_module.logging_level(log_level)
+    channel_metadata = hololink_module.Enumerator.find_channel(channel_ip=channel_ip)
+    hololink_channel = hololink_module.DataChannel(channel_metadata)
+    hololink = hololink_channel.hololink()
+    hololink.start()
+    hololink.reset()
+    hololink.setup_clock(hololink_module.renesas_bajoran_lite_ts1.device_configuration())
+    hololink.stop()
+    time.sleep(2)
+
+def execute_app(command, env):
+    logging.debug(f"Running command: {' '.join(command)}")
+    result = subprocess.run(command, env=env)
+    if result.returncode != 0:
+        logging.error(f"Application exited with code {result.returncode}")
+
+def main():
+    parser = argparse.ArgumentParser()
+    default_configuration = os.path.join(
+        os.path.dirname(__file__), DEFAULT_CONFIGURATION
+    )
+    parser.add_argument(
+        "--configuration",
+        default=default_configuration,
+        help="Configuration file",
+    )
+    parser.add_argument(
+        "--hololink",
+        default="192.168.0.2",
+        help="IP address of Hololink board",
+    )
+    parser.add_argument(
+        "--log-level",
+        type=int,
+        default=20,
+        help="Logging level to display",
+    )
+
+    args = parser.parse_args()
+
+    logging.basicConfig(level=args.log_level)
+
+    config = {}
+    with open(args.configuration, "r") as f:
+        config = json.load(f)
+
+    reset_hololink(args.hololink, args.log_level)
+    apps = []
+
+    for i, value in enumerate(config.values()):
+        app = value["app"]
+        args_list = value.get("args", [])
+        # Pass the IP address to the applications
+        args_list.extend(["--hololink", args.hololink])
+        # Avoid resetting hololink multiple times
+        if "--skip-reset" not in args_list:
+            args_list.append("--skip-reset")
+        env = os.environ.copy()
+        cmd = ["python3", os.path.join(os.path.dirname(__file__), app), *args_list]
+        apps.append(threading.Thread(target=execute_app, args=(cmd, env)))
+
+    for app in apps:
+        app.start()
+        time.sleep(EXECUTION_DELAY_SEC + AUX_DELAY_TABLE.get(app.name, 0))
+
+    for app in apps:
+        app.join()
+
+if __name__ == "__main__":
+    main()
