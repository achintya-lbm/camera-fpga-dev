index 0000000..5a281e4
--- /dev/null
+++ b/python/hololink/sensors/imx219/imx219_mode.py
@@ -0,0 +1,240 @@
+import hololink as hololink_module
+from enum import Enum
+from dataclasses import dataclass
+
+# Camera default mode
+IMX219_WAIT_MS = 1
+
+IMX219_CHIP_ID_REG = 0x0000
+IMX219_CHIP_ID = 0x0219
+
+############## 8Bit Registers ##############
+MODE_SELECT_REG = 0x0100
+MODE_STREAMING = 0x01
+MODE_STANDBY   = 0x00
+
+IMX219_REG_CSI_LANE_MODE = 0x0114
+IMX219_CSI_2_LANE_MODE = 0x01
+IMX219_CSI_4_LANE_MODE = 0x03
+IMX219_CSI_LANE_MODE_DEFAULT = IMX219_CSI_4_LANE_MODE
+
+IMX219_REG_DPHY_CTRL            = 0x0128
+IMX219_DPHY_CTRL_TIMING_AUTO    = 0
+IMX219_DPHY_CTRL_TIMING_MANUAL  = 1
+
+IMX219_REG_X_ODD_INC_A = 0x0170
+IMX219_REG_Y_ODD_INC_A = 0x0171
+IMX219_REG_ORIENTATION = 0x0172
+
+# Binning  Mode
+IMX219_REG_BINNING_MODE_H = 0x0174
+IMX219_REG_BINNING_MODE_V = 0x0175
+IMX219_BINNING_NONE       = 0x00
+IMX219_BINNING_X2         = 0x01
+IMX219_BINNING_X4         = 0x02
+IMX219_BINNING_X2_ANALOG  = 0x03
+
+# PLL Settings
+IMX219_REG_VTPXCK_DIV       = 0x0301
+IMX219_REG_VTSYCK_DIV       = 0x0303
+IMX219_REG_PREPLLCK_VT_DIV  = 0x0304
+IMX219_REG_PREPLLCK_OP_DIV  = 0x0305
+IMX219_REG_OPPXCK_DIV       = 0x0309
+IMX219_REG_OPSYCK_DIV       = 0x030b
+
+############## 16Bit Registers ##############
+IMX219_REG_EXCK_FREQ  = 0x012A
+IMX219_EXCK_FREQ      = lambda n: int(n * 256)  # n expressed in MHz
+
+IMX219_REG_FRM_LENGTH_A  = 0x0160
+IMX219_REG_LINE_LENGTH_A = 0x0162
+IMX219_REG_X_ADD_STA_A   = 0x0164
+IMX219_REG_X_ADD_END_A   = 0x0166
+IMX219_REG_Y_ADD_STA_A   = 0x0168
+IMX219_REG_Y_ADD_END_A   = 0x016a
+IMX219_REG_X_OUTPUT_SIZE = 0x016c
+IMX219_REG_Y_OUTPUT_SIZE = 0x016e
+
+IMX219_REG_CSI_DATA_FORMAT_A = 0x018c
+DATA_FORMAT_RAW8             = 0x08
+DATA_FORMAT_RAW10            = 0x0A
+DATA_FORMAT_RAW12            = 0x0C
+
+# PLL Settings
+IMX219_REG_PLL_VT_MPY    = 0x0306
+IMX219_REG_PLL_OP_MPY    = 0x030c
+
+IMX219_REG_TP_WINDOW_WIDTH  = 0x0624
+IMX219_REG_TP_WINDOW_HEIGHT = 0x0626
+
+# External clock frequency is 24MHz
+IMX219_XCLK_FREQ      = 24
+
+# IMX219 native and active pixel array size
+IMX219_NATIVE_WIDTH       = 3296
+IMX219_NATIVE_HEIGHT      = 2480
+IMX219_PIXEL_ARRAY_LEFT   = 8
+IMX219_PIXEL_ARRAY_TOP    = 8
+IMX219_PIXEL_ARRAY_WIDTH  = 3280
+IMX219_PIXEL_ARRAY_HEIGHT = 2464
+
+# Test Pattern Control
+TEST_PATTERN_REG         = 0x0600
+TEST_PATTERN_DISABLE     = 0x0
+TEST_PATTERN_SOLID_COLOR = 0x1
+TEST_PATTERN_COLOR_BARS  = 0x2
+TEST_PATTERN_GREY_COLOR  = 0x3
+TEST_PATTERN_PN9         = 0x4
+
+TEST_PATTERN_RED         = 0x602
+TEST_PATTERN_GREENR      = 0x604
+TEST_PATTERN_BLUE        = 0x606
+TEST_PATTERN_GREENB      = 0x608
+
+EXPOSURE_REG             = 0x015A
+ANALOG_GAIN_REG          = 0x0157
+DIGITAL_GAIN_REG         = 0x0158
+
+imx219_start = [
+    (MODE_SELECT_REG, MODE_STANDBY),
+]
+
+imx219_stop = [
+    (MODE_SELECT_REG, MODE_STANDBY),
+]
+
+imx219_mode_common_regs = [
+    (MODE_SELECT_REG, 0x00),    # Mode Select
+
+    # To Access Addresses 3000-5fff, send the following commands
+    (0x30eb, 0x05),
+    (0x30eb, 0x0c),
+    (0x300a, 0xff),
+    (0x300b, 0xff),
+    (0x30eb, 0x05),
+    (0x30eb, 0x09),
+
+    # Undocumented registers
+    (0x455e, 0x00),
+    (0x471e, 0x4b),
+    (0x4767, 0x0f),
+    (0x4750, 0x14),
+    (0x4540, 0x00),
+    (0x47b4, 0x14),
+    (0x4713, 0x30),
+    (0x478b, 0x10),
+    (0x478f, 0x10),
+    (0x4793, 0x10),
+    (0x4797, 0x0e),
+    (0x479b, 0x0e),
+
+    # Frame Bank Register Group "A"
+    (IMX219_REG_LINE_LENGTH_A,     3448 >> 8),
+    (IMX219_REG_LINE_LENGTH_A + 1, 3448 & 0xFF), # 0xD78
+    (IMX219_REG_X_ODD_INC_A, 1),
+    (IMX219_REG_Y_ODD_INC_A, 1),
+
+    # Output setup registers
+    (IMX219_REG_DPHY_CTRL,     IMX219_DPHY_CTRL_TIMING_AUTO),
+    (IMX219_REG_EXCK_FREQ,     IMX219_EXCK_FREQ(IMX219_XCLK_FREQ) >> 8),
+    (IMX219_REG_EXCK_FREQ + 1, IMX219_EXCK_FREQ(IMX219_XCLK_FREQ) & 0xFF),
+]
+
+imx219_2lane_regs = (
+    # PLL Clock Table
+    (IMX219_REG_VTPXCK_DIV, 5),
+    (IMX219_REG_VTSYCK_DIV, 1),
+    (IMX219_REG_PREPLLCK_VT_DIV, 3),   # 0x03 = AUTO set
+    (IMX219_REG_PREPLLCK_OP_DIV, 3),   # 0x03 = AUTO set
+    (IMX219_REG_PLL_VT_MPY,     57 >> 8),
+    (IMX219_REG_PLL_VT_MPY + 1, 57 & 0xFF),
+    (IMX219_REG_OPSYCK_DIV, 1),
+    (IMX219_REG_PLL_OP_MPY,     114 >> 8),
+    (IMX219_REG_PLL_OP_MPY + 1, 114 & 0xFF),
+
+    # 2-Lane CSI Mode
+    (IMX219_REG_CSI_LANE_MODE, IMX219_CSI_2_LANE_MODE),
+)
+
+imx219_4lane_regs = (
+    # PLL Clock Table
+    (IMX219_REG_VTPXCK_DIV, 5),
+    (IMX219_REG_VTSYCK_DIV, 1),
+    (IMX219_REG_PREPLLCK_VT_DIV, 3),   # 0x03 = AUTO set
+    (IMX219_REG_PREPLLCK_OP_DIV, 3),   # 0x03 = AUTO set
+    (IMX219_REG_PLL_VT_MPY,     88 >> 8),
+    (IMX219_REG_PLL_VT_MPY + 1, 88 & 0xFF),
+    (IMX219_REG_OPSYCK_DIV, 1),
+    (IMX219_REG_PLL_OP_MPY,     91 >> 8),
+    (IMX219_REG_PLL_OP_MPY + 1, 91 & 0xFF),
+
+    # 4-Lane CSI Mode
+    (IMX219_REG_CSI_LANE_MODE, IMX219_CSI_4_LANE_MODE),
+)
+
+class Imx219_Mode(Enum):
+    IMX219_MODE_3280X2464_15FPS = 0
+    IMX219_MODE_1640X1232_30FPS = 1
+    IMX219_MODE_1920X1080_30FPS = 2
+    IMX219_MODE_640X480_30FPS   = 3
+    UNKNOWN                     = 4
+
+@dataclass
+class frame_format:
