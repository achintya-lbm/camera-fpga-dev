+// Boston Dynamics, Inc. Confidential Information.
+// Copyright 2025. All Rights Reserved.
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include <hololink/core/hololink.hpp>
+
+/**
+ * Defines a library for controlling a radar sensor via I2C interface and interpreting the returned
+ * data from the DMA receiver.
+ */
+
+namespace hololink::core {
+struct RadarGpioPinMap {
+    uint8_t bne, ro;
+};
+
+struct TotalPktHeader {
+    std::vector<uint8_t> magic_num;
+    uint8_t data_format;
+    uint8_t header_crc;
+    uint32_t length;
+};
+
+struct FrameHeader {
+    uint16_t magic_word[4];
+    uint32_t version;
+    uint32_t total_packet_len;
+    uint32_t platform;
+    uint32_t frame_number;
+    uint32_t time_cpu_cycles;
+    uint32_t num_detected_obj;
+    uint32_t num_tlvs;
+    uint32_t sub_frame_number;
+};
+
+struct PointCloudHeader {
+    float xyz_unit;
+    float doppler_unit;
+    float snr_unit;
+    float noise_unit;
+    float num_detected_point;
+    float range_unit;
+    float azimuth_unit;
+    float elevation_unit;
+};
+
+struct PointCloudData {
+    int16_t doppler;
+    uint8_t snr;
+    uint8_t noise;
+    uint16_t range;
+    int16_t azimuth;
+    int16_t elevation;
+};
+
+struct PointCloud {
+    PointCloudHeader pc_header;
+    std::vector<PointCloudData> points;
+};
+
+struct RangeProfile {
+    std::vector<uint16_t> profile;
+};
+
+struct StatsInformation {
+    uint32_t inter_frame_processing_time;
+    uint32_t transmit_output_time;
+    uint16_t power_measured[4];
+    int16_t temp_reading[4];
+};
+
+struct RadarFrame {
+    FrameHeader header;
+    std::optional<PointCloud> point_cloud;
+    std::optional<RangeProfile> range_profile;
+    std::optional<StatsInformation> stats;
+};
+
+enum TlvType { kPointCloud = 301,
+    kRangeProfile = 302,
+    kStatsInfo = 306 };
+
+class RadarCtrl {
+public:
+    RadarCtrl(std::shared_ptr<hololink::Hololink::I2c> i2c, std::shared_ptr<hololink::Hololink::Spi> spi, std::shared_ptr<hololink::Hololink::GPIO> gpio, bool debug);
+
+    void init_radar();
+
+    bool start_radar();
+
+    void stop_radar();
+
+    std::optional<RadarFrame> get_radar_frame();
+
+private:
+    std::shared_ptr<hololink::Hololink::I2c> m_i2c;
+    std::shared_ptr<hololink::Hololink::Spi> m_spi;
+    std::shared_ptr<hololink::Hololink::GPIO> m_gpio;
+    bool m_debug;
+    const RadarGpioPinMap m_pin_map = { .bne = 4, .ro = 5 };
+    
+    std::optional<RadarFrame> format_radar_raw_frame(const std::vector<uint8_t>& raw_data);
+};
+
+} // namespace hololink::core
