+RadarCtrl::RadarCtrl(std::shared_ptr<hololink::Hololink::I2c> i2c, std::shared_ptr<hololink::Hololink::Spi> spi, std::shared_ptr<hololink::Hololink::GPIO> gpio, bool debug)
+    : m_i2c(i2c)
+    , m_spi(spi)
+    , m_gpio(gpio)
+    , m_debug(debug)
+{
+    printf("RadarCtrl constructor called. \n");
+}
+
+void RadarCtrl::init_radar()
+{
+    hold_radar_reset(m_i2c, true, 50);
+    hold_radar_reset(m_i2c, false, 50);
+
+    m_gpio->set_direction(m_pin_map.bne, hololink::Hololink::GPIO::IN);
+    m_gpio->set_direction(m_pin_map.ro, hololink::Hololink::GPIO::OUT);
+
+    if (!wait_for_ready(m_i2c, 1000, m_debug)) {
+        printf("Ready low for at least 1 sec immediately after reset. \n");
+    }
+}
+
+bool RadarCtrl::start_radar()
+{
+    std::this_thread::sleep_for(std::chrono::milliseconds(1000));
+
+    if (!wait_for_ready(m_i2c, 1000, m_debug)) {
+        fprintf(stderr, "Timed out waiting for ready after trigger. \n");
+        // return false;
+    }
+    printf("Radar indicates ready for transmission. \n");
+    return true;
+}
+
+void RadarCtrl::stop_radar()
+{
+    // Disable radar trigger forwarding at ser once stop is called
+    write_i2c_reg8(m_i2c, 0x40, 0x02C1, 0x80, true);
+    printf("Radar stopped. \n");
+}
