+        self.set_register(tc358743_reg.PK_INT_MODE, tc358743_reg.MASK_ISRC2_INT_MODE | tc358743_reg.MASK_ISRC_INT_MODE
+                            | tc358743_reg.MASK_ACP_INT_MODE | tc358743_reg.MASK_VS_INT_MODE | tc358743_reg.MASK_SPD_INT_MODE
+                            | tc358743_reg.MASK_MS_INT_MODE | tc358743_reg.MASK_AUD_INT_MODE
+                            | tc358743_reg.MASK_AVI_INT_MODE, size=1)
