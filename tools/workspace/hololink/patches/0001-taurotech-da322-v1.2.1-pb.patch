+
+
+class RegisterCtl:
+    def __init__(
+        self,
+        hololink_channel,
+    ):
+        self._hololink = hololink_channel.hololink()
+
+    def get_register(self, address):
+        r = self._hololink.read_uint32(address)
+        logging.info(
+            "get_register(address=%d(0x%X), value=%d(0x%X))"
+            % (address, address, r, r)
+        )
+        return r
+
+    def set_register(self, address, value):
+        logging.info(
+            "set_register(address=%d(0x%X), value=%d(0x%X))"
+            % (address, address, value, value)
+        )
+        self._hololink.write_uint32(address, value)
+
+
+def main():
