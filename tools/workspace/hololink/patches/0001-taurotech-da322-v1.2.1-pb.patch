index 0000000..a463705
--- /dev/null
+++ b/python/hololink/sensors/imx219/imx219.py
@@ -0,0 +1,278 @@
+# SPDX-FileCopyrightText: Copyright (c) 2024 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+# http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+# See README.md for detailed information.
+
+import logging
+import time
+
+import hololink as hololink_module
+
+from . import imx219_mode
+
+# Camera info
+DRIVER_NAME = "IMX219"
+
+# Camera I2C address.
+CAM_I2C_ADDRESS = 0x10
+
+I2C_RETRIES = 5
+
+class Imx219:
+    def __init__(
+        self,
+        hololink_channel,
+        i2c_bus=hololink_module.CAM_I2C_BUS,
+        i2c_id=0,
+        exposure=0x03E8,
+    ):
+        self._hololink = hololink_channel.hololink()
+        self._i2c_bus = i2c_bus + i2c_id
+        self._i2c = self._hololink.get_i2c(self._i2c_bus)
+        self._exposure = exposure
+
+    def setup_clock(self):
+        # set the clock driver.
+        logging.debug("setup_clock")
+        self._hololink.setup_clock(
+            hololink_module.renesas_bajoran_lite_ts1.device_configuration()
+        )
+
+    def configure(self):
+        logging.info("Configuring IMX219 on I2C bus %d" % self._i2c_bus)
+        chip_id = self.get_register(imx219_mode.IMX219_CHIP_ID_REG, size=2)
+        if chip_id != imx219_mode.IMX219_CHIP_ID:
+            raise RuntimeError(
+                "IMX219 not found on I2C bus %d. Read chip id 0x%X, expected 0x%X"
+                % (self._i2c_bus, chip_id, imx219_mode.IMX219_CHIP_ID)
+            )
+        else:
+            logging.info(
+                "IMX219 found on I2C bus %d. Read chip id 0x%X"
+                % (self._i2c_bus, chip_id)
+            )
+
+        # Sensor doesn't enter LP-11 state upon power up until and unless
+        # streaming is started, so upon power up switch the modes to:
+        # streaming -> standby
+        self.set_register(imx219_mode.MODE_SELECT_REG, imx219_mode.MODE_STREAMING, size=1)
+        time.sleep(100 / 1000 / 1000);  # 100 us
+
+        # Put sensor back to standby mode
+        self.set_register(imx219_mode.MODE_SELECT_REG, imx219_mode.MODE_STANDBY, size=1)
+        time.sleep(100 / 1000 / 1000);  # 100 us
+
+    def set_frame_fmt(self):
+        full_width  = imx219_mode.IMX219_PIXEL_ARRAY_WIDTH
+        full_height = imx219_mode.IMX219_PIXEL_ARRAY_HEIGHT
+
+        crop_width  = self._mode.width
+        crop_height = self._mode.height
+
+        crop_left   = (full_width  - crop_width)  // 2
+        crop_top    = (full_height - crop_height) // 2
+
+        crop_right  = crop_left + crop_width  - 1
+        crop_bottom = crop_top  + crop_height - 1
+
+        format_width  = self._mode.width
+        format_height = self._mode.height
+
+        bpp = imx219_mode.DATA_FORMAT_RAW10
+        if self._mode.pixel_format == hololink_module.sensors.csi.PixelFormat.RAW_8:
+            bpp = imx219_mode.DATA_FORMAT_RAW8
+        elif self._mode.pixel_format == hololink_module.sensors.csi.PixelFormat.RAW_10:
+            bpp = imx219_mode.DATA_FORMAT_RAW10
+
+        self.set_register(imx219_mode.IMX219_REG_X_ADD_STA_A, crop_left, size=2)
+        self.set_register(imx219_mode.IMX219_REG_X_ADD_END_A, crop_right, size=2)
+
+        self.set_register(imx219_mode.IMX219_REG_Y_ADD_STA_A, crop_top, size=2)
+        self.set_register(imx219_mode.IMX219_REG_Y_ADD_END_A, crop_bottom, size=2)
+
+        if (crop_width // format_width) == 2:
+            bin_h = imx219_mode.IMX219_BINNING_X2_ANALOG if (bpp == 8) \
+                    else imx219_mode.IMX219_BINNING_X2
+        else:
+            bin_h = imx219_mode.IMX219_BINNING_NONE
+
+        if (crop_height // format_height) == 2:
+            bin_v = imx219_mode.IMX219_BINNING_X2_ANALOG if (bpp == 8) \
+                    else imx219_mode.IMX219_BINNING_X2
+        else:
+            bin_v = imx219_mode.IMX219_BINNING_NONE
+
+        self.set_register(imx219_mode.IMX219_REG_BINNING_MODE_H, bin_h, size=1)
+        self.set_register(imx219_mode.IMX219_REG_BINNING_MODE_V, bin_v, size=1)
+
+        self.set_register(imx219_mode.IMX219_REG_X_OUTPUT_SIZE, format_width, size=2)
+        self.set_register(imx219_mode.IMX219_REG_Y_OUTPUT_SIZE, format_height, size=2)
+
+        self.set_register(imx219_mode.IMX219_REG_TP_WINDOW_WIDTH,  format_width, size=2)
+        self.set_register(imx219_mode.IMX219_REG_TP_WINDOW_HEIGHT, format_height, size=2)
+
+        self.set_register(imx219_mode.IMX219_REG_CSI_DATA_FORMAT_A,     bpp, size=1)
+        self.set_register(imx219_mode.IMX219_REG_CSI_DATA_FORMAT_A + 1, bpp, size=1)
+        self.set_register(imx219_mode.IMX219_REG_OPPXCK_DIV,            bpp, size=1)
+
+    def start(self):
+        """Start Streaming"""
+        logging.info("Start IMX219 streaming")
+
+        if self._mode is None:
+            logging.error("Cannot start IMX219 streaming. Mode is not set.")
+            return
+
+        for reg, val in imx219_mode.imx219_mode_common_regs:
+           self.set_register(reg, val, size=1)
+
+        for reg, val in self._mode.lane_regs:
+           self.set_register(reg, val, size=1)
+
+        self.set_frame_fmt()
+
+        for reg, val in self._mode.regs:
+            self.set_register(reg, val, size=1)
+
+        self.set_register(imx219_mode.MODE_SELECT_REG, imx219_mode.MODE_STREAMING, size=1)
+
+        # Streaming should start at this point
+
+        self.set_exposure_reg(self._exposure)
+        self.set_analog_gain(0xE8)
+
+    def stop(self):
+        """Stop Streaming"""
+        logging.info("Start IMX219 streaming")
+        self.set_register(imx219_mode.MODE_SELECT_REG, imx219_mode.MODE_STANDBY)
+
+    def get_register(self, register, size=1):
+        write_bytes = bytearray(100)
+        serializer = hololink_module.Serializer(write_bytes)
+        serializer.append_uint16_be(register)
+        read_byte_count = size
+        reply = self._i2c.i2c_transaction(
+            CAM_I2C_ADDRESS, write_bytes[: serializer.length()], read_byte_count
+        )
+        deserializer = hololink_module.Deserializer(reply)
+        r = 0
+        for i in range(size):
+            r |= deserializer.next_uint8() << ((size - i - 1) * 8)
+        logging.debug(
+            "get_register(register=%d(0x%X), size=%d)=%d(0x%X)" % (register, register, size, r, r)
+        )
+        return r
+
+    def set_register(self, register, value, size=1, timeout=None):
+        logging.debug(
+            "set_register(register=%d(0x%X), value=%d(0x%X), size=%d)"
+            % (register, register, value, value, size)
+        )
+        write_bytes = bytearray(100)
+        serializer = hololink_module.Serializer(write_bytes)
+        serializer.append_uint16_be(register)
+        for i in range(size):
+            serializer.append_uint8((value >> ((size - i - 1) * 8)) & 0xFF)
+        read_byte_count = 0
+        self._i2c.i2c_transaction(
+            CAM_I2C_ADDRESS,
+            write_bytes[: serializer.length()],
+            read_byte_count,
+            timeout=timeout,
+        )
+
+    def set_mode(self, imx219_mode_set):
+        if imx219_mode_set.value < len(imx219_mode.Imx219_Mode):
+            self._mode = imx219_mode.imx_frame_format[imx219_mode_set.value]
+            self._height = self._mode.height
+            self._width = self._mode.width
+            self._pixel_format = self._mode.pixel_format
+        else:
+            logging.error("Incorrect mode for IMX219")
+            self._mode = None
+
+    def configure_converter(self, converter):
+        # where do we find the first received byte?
+        start_byte = converter.receiver_start_byte()
+        transmitted_line_bytes = converter.transmitted_line_bytes(
+            self._pixel_format, self._width
+        )
+        received_line_bytes = converter.received_line_bytes(transmitted_line_bytes)
+        converter.configure(
+            start_byte,
+            received_line_bytes,
+            self._width,
+            self._height,
+            self._pixel_format,
+        )
+
+    def pixel_format(self):
+        return self._pixel_format
+
+    def bayer_format(self):
+        return hololink_module.sensors.csi.BayerFormat.RGGB
+
+    def set_analog_gain(self, value=0xE8):
+        """
+        Sets Analog Gain (Register 0x0157).
+        Value range: 0 to 232 (Dec).
+        Gain formula: 256 / (256 - value)
+        0 = 1x Gain
+        232 = ~10x Gain
+        """
+        if value > 232 or value < 0:
+            logging.warn(f"AG value {value} should be in range 0 to 231")
+            value = 0xE8
+        self.set_register(imx219_mode.ANALOG_GAIN_REG, value, size=1)
+
+    def set_exposure_reg(self, value=0x05):
+        """
+        IMX219 has the minimum limit of 5 to be set for the exposure.
+        """
+        if value < 0x05:
+            logging.warn(f"Exposure value {value} is lower than the minimum.")
+            value = 0x05
+        self.set_register(imx219_mode.EXPOSURE_REG, value, size=2)
+
+    def set_digital_gain_reg(self, value=0x40):
+        if value < 0x40:
+            value = 0x40
+        elif value > 0xFFFF:
+            value = 0xFFFF
+        self.set_register(imx219_mode.DIGITAL_GAIN_REG, value, size=2)
+
+    def test_pattern(self, mode=imx219_mode.TEST_PATTERN_COLOR_BARS):
+        self.set_register(imx219_mode.TEST_PATTERN_REG, mode, size=2)
+
+    def test_color(self, r, g, b):
+        self.set_register(imx219_mode.TEST_PATTERN_RED,    r, size=2)
+        self.set_register(imx219_mode.TEST_PATTERN_GREENR, g, size=2)
+        self.set_register(imx219_mode.TEST_PATTERN_BLUE,   b, size=2)
+        self.set_register(imx219_mode.TEST_PATTERN_GREENB, g, size=2)
+        self.set_register(imx219_mode.TEST_PATTERN_REG, imx219_mode.TEST_PATTERN_SOLID_COLOR, size=2)
+
+    def width(self):
+        if self._width is None:
+            raise RuntimeError(
+                "Image width is unavailable; call configure_camera first."
+            )
+        return self._width
+
+    def height(self):
+        if self._height is None:
+            raise RuntimeError(
+                "Image height is unavailable; call configure_camera first."
+            )
+        return self._height
diff --git a/python/hololink/sensors/imx219/imx219_mode.py b/python/hololink/sensors/imx219/imx219_mode.py
