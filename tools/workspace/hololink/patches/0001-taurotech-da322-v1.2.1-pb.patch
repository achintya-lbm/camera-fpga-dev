+        (MAX96716A_DESER_ADDR, 0x0170, 0x09),  # SPI Enable, SPI subordinate, bridge disable, accept all packets
+        (MAX96716A_DESER_ADDR, 0x0171, 0x1D),  # Packet Size 15 bytes, SPI base 0b01
+        (MAX96716A_DESER_ADDR, 0x0172, 0x00),  # CS Active Low, SPI Mode 0
+        (MAX96716A_DESER_ADDR, 0x0173, 0x1E),
+        (MAX96716A_DESER_ADDR, 0x0174, 0x0A),  # SCK low time: 10 clocks
+        (MAX96716A_DESER_ADDR, 0x0175, 0x0A),  # SCK high time: 10 clocks
+        (MAX96716A_DESER_ADDR, 0x0176, 0x03),  # DES RO used, BNE not used
+        (MAX96716A_DESER_ADDR, 0x0178, 0x00),
+        (MAX96716A_DESER_ADDR, MPSB_TABLE_WAIT_MS, 50),
+
+        # SER MAX9295E SPI setting
+        (MAX9295E_SER_ADDR_A, 0x0170, 0x0B),  # SPI Enable, SPI main, bridge disable, accept all packets
+        (MAX9295E_SER_ADDR_A, 0x0171, 0x1D),  # Packet Size 15 bytes, SPI base 0b01
+        (MAX9295E_SER_ADDR_A, 0x0172, 0x00),  # Chip Select Active Low, SPI Mode 0
+        (MAX9295E_SER_ADDR_A, 0x0173, 0x1E),  # Delay between SS and SCK Pulse = 30(0x1E)*300MHz
+        (MAX9295E_SER_ADDR_A, 0x0174, 255),   # SCK low time: 10 clocks
+        (MAX9295E_SER_ADDR_A, 0x0175, 255),   # SCK high time: 10 clocks
+        (MAX9295E_SER_ADDR_A, 0x0176, 0x04),  # Ser SS1 is used
+        (MAX9295E_SER_ADDR_A, 0x0178, 0x00),
+        (MAX9295E_SER_ADDR_A, MPSB_TABLE_WAIT_MS, 50),
+
+        (MAX9295E_SER_ADDR_A, 0x02BF, 0x60),
+        # DES MAX96716A GPIO Tx setting
+        # StereoCM FSYNC (DES MFP1 -> SER MFP0)
+        (MAX96716A_DESER_ADDR, 0x02B3, 0x83),  # TX Enable (DES MFP1)
+        (MAX96716A_DESER_ADDR, 0x02B4, 0x40),  # TX ID 0
+        (MAX9295E_SER_ADDR_A, 0x02BE, 0x84),   # RX Enable (SER MFP0)
+        (MAX9295E_SER_ADDR_A, 0x02C0, 0x40),   # RX ID 0
+        # RADAR-A READY (SER MFP14 -> DES MFP3)
+        (MAX9295E_SER_ADDR_A, 0x02E8, 0x83),   # TX Enable (SER MFP14)
+        (MAX9295E_SER_ADDR_A, 0x02E9, 0x43),   # TX ID 3
+        (MAX96716A_DESER_ADDR, 0x02B9, 0x84),  # RX Enable (DES MFP3)
+        (MAX96716A_DESER_ADDR, 0x02BB, 0xC3),  # RX ID 3
+        # dToF-A READY (SER MFP12 -> DES MFP4)
+        (MAX9295E_SER_ADDR_A, 0x02E2, 0x83),   # TX Enable (SER MFP12)
+        (MAX9295E_SER_ADDR_A, 0x02E3, 0x44),   # TX ID 4
+        (MAX96716A_DESER_ADDR, 0x02BC, 0x84),  # RX Enable (DES MFP4)
+        (MAX96716A_DESER_ADDR, 0x02BE, 0x44),  # RX ID 4
+
+        (MAX9295E_SER_ADDR_A, MPSB_TABLE_WAIT_MS, 50),
+
+        (MAX9295E_SER_ADDR_A, 0x02C7, 0x80),   # hold radar reset high
+        (MAX9295E_SER_ADDR_A, MPSB_TABLE_WAIT_MS, 50),
+        (MAX9295E_SER_ADDR_A, 0x02C7, 0x90),   # hold radar reset low
+        (MAX9295E_SER_ADDR_A, MPSB_TABLE_WAIT_MS, 50),
+    ]
+
+def get_gpio_fwd_sequence():
+    return [
+        # dToF FSYNC (DES MFP10 -> SER MFP9)
+        (MAX96716A_DESER_ADDR, 0x02CE, 0x83),  # TX Enable (DES MFP10)
+        (MAX96716A_DESER_ADDR, 0x02CF, 0x42),  # TX ID 2
+        (MAX9295E_SER_ADDR_A, 0x02D9, 0x84),    # RX enable (SER MFP9)
+        (MAX9295E_SER_ADDR_A, 0x02DB, 0x42),    # RX ID 2
+        # RADAR FSYNC (DES MFP9 -> SER MFP1)
+        (MAX96716A_DESER_ADDR, 0x02CB, 0x83),  # TX Enable (DES MFP9)
+        (MAX96716A_DESER_ADDR, 0x02CC, 0x41),  # TX ID 1
+        (MAX9295E_SER_ADDR_A, 0x02C1, 0x84),    # RX Enable (SER MFP1)
+        (MAX9295E_SER_ADDR_A, 0x02C3, 0x41),    # RX ID 1
+
+        (MAX9295E_SER_ADDR_A, MPSB_TABLE_WAIT_MS, 500),
+    ]
+
+
+stream_start_seq = [
+]
+
+stream_stop_seq = [
+    (MAX9295E_SER_ADDR_A, 0x02D3, 0x80),  # Set GPIO7A: RES_1M (Reset Low)
+    (MAX9295E_SER_ADDR_A, MPSB_TABLE_WAIT_MS, 50),
+]
+
+
+class Mpsb_Mode(Enum):
+    MODE_1920X1080_30FPS = 0
+    Unknown = 1
+
+
+frame_format = namedtuple("FrameFormat", ["width", "height", "framerate", "pixel_format"])
