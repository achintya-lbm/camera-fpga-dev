+"""
+SPDX-FileCopyrightText: Copyright (c) 2023-2024 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+SPDX-License-Identifier: Apache-2.0
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+"""
+
+import logging
+import time
+
+import hololink as hololink_module
+
+from . import spi_mode
+
+# Camera info
+DRIVER_NAME = "SPI"
+VERSION = 1
+
+
+class SensorSpi:
+    def __init__(
+        self,
+        hololink_channel,
+        i2c_bus=hololink_module.CAM_I2C_BUS,
+        ser_addr=spi_mode.SER_ADDR,
+        des_addr=spi_mode.DES_ADDR,
+        spi_clk_delay=spi_mode.SPI_CLK_DELAY_VAL,
+    ):
+        self._i2c_bus = i2c_bus
+        self._hololink = hololink_channel.hololink()
+        self._i2c = self._hololink.get_i2c(self._i2c_bus)
+        self._mode = spi_mode.Spi_Mode.Unknown
+
+        spi_mode.set_ser_i2c_address(ser_addr)
+        spi_mode.set_des_i2c_address(des_addr)
+        spi_mode.set_spi_clock_delay(spi_clk_delay)
+
+    def setup_clock(self):
+        # set the clock driver.
+        logging.debug("setup_clock")
+        self._hololink.setup_clock([])
+
+    def configure(self, spi_mode_set, with_gmsl=False, link=spi_mode.GmslLink.LINK_B):
+        # Make sure this is a version we know about.
+        version = self.get_version()
+        logging.info("version=%s" % (version,))
+        assert version == VERSION
+
+        # Select GMSL link
+        spi_mode.set_gmsl_link(link)
+
+        # configure the sensor based on the mode
+        self.configure_sensor(spi_mode_set, with_gmsl)
+
+    def start(self):
+        """Start Streaming"""
+        self._running = True
+        #logging.debug("SPI start stream")
+
+    def stop(self):
+        """Stop Streaming"""
+        #logging.debug("SPI stop stream")
+        self._running = False
+
+    def get_version(self):
+        # TODO: get the version or the name of the sensor from the sensor
+        return VERSION
+
+    def get_max929x_register(self, i2c_address, register, timeout=None):
+        write_bytes = bytearray(100)
+        serializer = hololink_module.Serializer(write_bytes)
+        serializer.append_uint16_be(register)
+        read_byte_count = 1
+        reply = self._i2c.i2c_transaction(
+            i2c_address, write_bytes[: serializer.length()], read_byte_count
+        )
+        deserializer = hololink_module.Deserializer(reply)
+        r = deserializer.next_uint8()
+        logging.debug(
+            "get_max929x_register(i2c_addr=%d(0x%X), register=%d(0x%X),value=%d(0x%X))" % (i2c_address, i2c_address, register, register, r, r)
+        )
+        return r
+
+    def set_max929x_register(self, i2c_address, register, value, timeout=None):
+        logging.debug(
+            "set_max929x_register(i2c address=%d(0x%X), register=%d(0x%X), value=%d(0x%X))"
+            % (i2c_address, i2c_address, register, register, value, value)
+        )
+        write_bytes = bytearray(100)
+        serializer = hololink_module.Serializer(write_bytes)
+        serializer.append_uint16_be(register)
+        serializer.append_uint8(value)
+        read_byte_count = 0
+        try:
+            self._i2c.i2c_transaction(
+                i2c_address,
+                write_bytes[: serializer.length()],
+                read_byte_count,
+                timeout=timeout,
+            )
+        except RuntimeError as e:
+            logging.error("%s - Failed to send: address=%d(0x%X), register=%d(0x%X), value=%d(0x%X))" % (e, i2c_address, i2c_address, register, register, value, value))
+
+    def configure_sensor(self, spi_mode_set, with_gmsl=True):
+        self.set_mode(spi_mode_set)
+
+        serdes_list = []
+
+        if with_gmsl:
+            serdes_list = spi_mode.get_max_serdes_spi()
+
+        for i2c_addr, reg, val in serdes_list:
+            if reg == "sleep":
+                time.sleep(val)
+                continue
+            self.set_max929x_register(i2c_addr, reg, val)
+            #time.sleep(1/1000)
+            if (reg == 0x0010 or reg == 0x0012 or reg == 0x03e2):
+                time.sleep(250 / 1000)
+        #time.sleep(20/1000)
+
+        self.set_max929x_register(spi_mode.DES_ADDR, 0x0332, 0x00)
+        time.sleep(200 / 1000)
+        self.set_max929x_register(spi_mode.DES_ADDR, 0x0332, 0xF0)
+
+        self.set_max929x_register(spi_mode.SER_ADDR, 0x0332, 0x00)
+        time.sleep(200 / 1000)
+        self.set_max929x_register(spi_mode.SER_ADDR, 0x0332, 0xF0)
+
+    def set_mode(self, spi_mode_set):
+        if spi_mode_set.value < len(spi_mode.Spi_Mode):
+            self._mode = spi_mode_set
+            mode = spi_mode.imx_frame_format[self._mode.value]
+            self._height = mode.height
+            self._width = mode.width
+            self._pixel_format = mode.pixel_format
+        else:
+            logging.error("Incorrect mode for SPI")
+            self._mode = -1
+
+    def configure_converter(self, converter):
+        logging.debug(f"configure_converter:width={self._width},height={self._height},bpp={self._pixel_format}")
+        assert self._pixel_format == hololink_module.sensors.csi.PixelFormat.RAW_10
+
+        start_byte = converter.receiver_start_byte()
+        transmitted_line_bytes = converter.transmitted_line_bytes(
+            self._pixel_format, self._width
+        )
+        received_line_bytes = converter.received_line_bytes(transmitted_line_bytes)
+
+        converter.configure(
+            start_byte,
+            received_line_bytes,
+            self._width,
+            self._height,
+            self._pixel_format,
+        )
+
+    def pixel_format(self):
+        return self._pixel_format
+
+    def bayer_format(self):
+        return hololink_module.sensors.csi.BayerFormat.GRBG
