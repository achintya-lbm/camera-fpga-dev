+limitations under the License.
+"""
+
+import logging
+import time
+from collections import OrderedDict
+
+import hololink as hololink_module
+
+from . import mpsb_mode
+
+# Camera info
+DRIVER_NAME = "MPSB"
+VERSION = 1
+
+
+class MpsbCam(hololink_module.Synchronizable):
+
+    def __init__(
+        self,
+        hololink_channel,
+        i2c_bus=hololink_module.CAM_I2C_BUS,
+        expander_configuration=0,
+        skip_i2c=False,
+        vsync=hololink_module.Synchronizer.null_synchronizer(),
+    ):
+        super().__init__()
+        self._i2c_bus = i2c_bus
+        self._hololink = hololink_channel.hololink()
+        self._i2c = self._hololink.get_i2c(self._i2c_bus)
+        self._mode = mpsb_mode.Mpsb_Mode.Unknown
+        self._which = expander_configuration
+        self.skip_i2c = skip_i2c
+        self._vsync = vsync
+        self._running = False
+
+    def setup_clock(self):
+        # set the clock driver.
+        logging.debug("setup_clock")
+        self._hololink.setup_clock(hololink_module.renesas_bajoran_lite_ts1.device_configuration())
+
+    def configure(self, mpsb_mode_set):
+        # Make sure this is a version we know about.
+        version = self.get_version()
+        logging.info("version=%s" % (version,))
+        assert version == VERSION
+
+        # configure the camera based on the mode
+        self.configure_camera(mpsb_mode_set)
+
+    def configure_gpio_fwd(self):
+        logging.info("Configuring GPIO forwarding of DToF and Radar FYSNC")
+        gpio_fwd_list = mpsb_mode.get_gpio_fwd_sequence()
+        for i2c_addr, reg, val in gpio_fwd_list:
+            if (reg == mpsb_mode.MPSB_TABLE_WAIT_MS):
+                time.sleep(val / 1000)
+            else:
+                self.set_max929x_register(i2c_addr, reg, val)
+
+    def start(self):
+        """Start Streaming"""
+        self._running = True
+        
+        self._hololink.write_uint32(0x50000000, 1)
+        self._hololink.write_uint32(0x60000000, 1)
+        self._hololink.write_uint32(0x70000000, 1)
+
+        for i2c_addr, reg, val in mpsb_mode.stream_start_seq:
+            if reg == mpsb_mode.MPSB_TABLE_WAIT_MS:
+                time.sleep(val / 1000)
+            else:
+                self.set_max929x_register(i2c_addr, reg, val)
+        time.sleep(0.1)
+
+        y_rx8 = self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x11a)
+        z_rx8 = self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x12c)
+
+        print(f"Y VIDEO_RX0: 0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x112):x}")
+        print(f"Y VIDEO_RX3: 0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x115):x}")
+        print(f"Y VIDEO_RX8: 0x{y_rx8:x}")
+        print(f"Z VIDEO_RX0: 0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x124):x}")
+        print(f"Z VIDEO_RX3: 0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x127):x}")
+        print(f"Z VIDEO_RX8: 0x{z_rx8:x}")
+        print()
+        print(f"MIPI_PHY18:  0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x342):x}")
+        print(f"MIPI_PHY19:  0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x343):x}")
+        print(f"MIPI_PHY20:  0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x344):x}")
+        print(f"MIPI_PHY21:  0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x345):x}")
+        print()
+        print(f"MIPI_PHY18:  0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x342):x}")
+        print(f"MIPI_PHY19:  0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x343):x}")
+        print(f"MIPI_PHY20:  0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x344):x}")
+        print(f"MIPI_PHY21:  0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x345):x}")
+        print()
+        print(f"MIPI_PHY18:  0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x342):x}")
+        print(f"MIPI_PHY19:  0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x343):x}")
+        print(f"MIPI_PHY20:  0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x344):x}")
+        print(f"MIPI_PHY21:  0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x345):x}")
+
+        print(f"VPRBS Y:  0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x1FC):x}")
+        print(f"VPRBS Z:  0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x21C):x}")
+
+        print(f"TUN Y:  0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x474):x}")
+        print(f"TUN Z:  0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x4B4):x}")
+        
+        print(f"Ser 1:   0x{self.get_max929x_register(mpsb_mode.MAX9295E_SER_ADDR_A, 0x001):x}")
+        print(f"Ser 13:  0x{self.get_max929x_register(mpsb_mode.MAX9295E_SER_ADDR_A, 0x013):x}")
+        print(f"Ser int3:0x{self.get_max929x_register(mpsb_mode.MAX9295E_SER_ADDR_A, 0x01b):x}")
+        print(f"Ser int5:0x{self.get_max929x_register(mpsb_mode.MAX9295E_SER_ADDR_A, 0x01d):x}")
+        print(f"Ser int7:0x{self.get_max929x_register(mpsb_mode.MAX9295E_SER_ADDR_A, 0x01f):x}")
+        print(f"Ser xtx2:0x{self.get_max929x_register(mpsb_mode.MAX9295E_SER_ADDR_A, 0x102):x}")
+        print(f"Ser ytx2:0x{self.get_max929x_register(mpsb_mode.MAX9295E_SER_ADDR_A, 0x10a):x}")
+        
+        print(f"Ser ext0:0x{self.get_max929x_register(mpsb_mode.MAX9295E_SER_ADDR_A, 0x580):x}")
+        print(f"Ser ext1:0x{self.get_max929x_register(mpsb_mode.MAX9295E_SER_ADDR_A, 0x581):x}")
+        print(f"Ser ext2:0x{self.get_max929x_register(mpsb_mode.MAX9295E_SER_ADDR_A, 0x582):x}")
+        print(f"Ser ext3:0x{self.get_max929x_register(mpsb_mode.MAX9295E_SER_ADDR_A, 0x583):x}")
+        
+        print(f"Ser gpi8:0x{self.get_max929x_register(mpsb_mode.MAX9295E_SER_ADDR_A, 0x2D6):x}")
+        print(f"Ser gpiF:0x{self.get_max929x_register(mpsb_mode.MAX9295E_SER_ADDR_A, 0x2EB):x}")
+
+        print(f"Des 1:   0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x001):x}")
+        print(f"Des 11:  0x{self.get_max929x_register(mpsb_mode.MAX96716A_DESER_ADDR, 0x011):x}")
+
+        channel_metadata = hololink_module.Enumerator.find_channel(channel_ip="192.168.0.2")
+        m_gpio = self._hololink.get_gpio(channel_metadata)
+        logging.info("Got GPIO")
+        m_gpio.set_value(3, m_gpio.HIGH)
+        logging.info("Set Holoscan GPIO pin 3 to output mode and pulled high")
+
+
+        if not ((y_rx8 & 0x40) or (z_rx8 & 0x40)):
+            raise Exception("no video lock")
+
+    def stop(self):
+        """Stop Streaming"""
+        # stop vsyncs
+        self._hololink.write_uint32(0x50000000, 0)
+        self._hololink.write_uint32(0x60000000, 0)
+        self._hololink.write_uint32(0x70000000, 0)
+
+        channel_metadata = hololink_module.Enumerator.find_channel(channel_ip="192.168.0.2")
+        m_gpio = self._hololink.get_gpio(channel_metadata)
+        logging.info("Got GPIO")
+        m_gpio.set_value(3, m_gpio.LOW)
+        logging.info("Set Holoscan GPIO pin 3 to output mode and pulled low")
+
+        for i2c_addr, reg, val in mpsb_mode.stream_stop_seq:
+            if reg == mpsb_mode.MPSB_TABLE_WAIT_MS:
+                time.sleep(val / 1000)
+            else:
+                self.set_max929x_register(i2c_addr, reg, val)
+        self._running = False
+
+    def get_version(self):
+        # TODO: get the version or the name of the sensor from the sensor
+        return VERSION
+
+    def set_register(self, i2c_address, register, value, timeout=None):
+        if self.skip_i2c:
+            logging.debug("Skip i2c")
+            return
+        logging.debug("set_register(i2c address=%d(0x%X), register=%d(0x%X), value=%d(0x%X))" %
+                      (i2c_address, i2c_address, register, register, value, value))
+        write_bytes = bytearray(4)
+        serializer = hololink_module.Serializer(write_bytes)
+        serializer.append_uint16_be(register)
+        serializer.append_uint16_be(value)
+        self._i2c.i2c_transaction(
+            i2c_address,
+            write_bytes[:serializer.length()],
+            0,
+            timeout=timeout,
+        )
+
+    def set_max929x_register(self, i2c_address, register, value, timeout=None):
+        if self.skip_i2c:
+            logging.debug("Skip i2c")
+            return
+        logging.debug(
+            "set_max929x_register(i2c address=%d(0x%X), register=%d(0x%X), value=%d(0x%X))" %
+            (i2c_address, i2c_address, register, register, value, value))
+        write_bytes = bytearray(3)
+        serializer = hololink_module.Serializer(write_bytes)
+        serializer.append_uint16_be(register)
+        serializer.append_uint8(value)
+        self._i2c.i2c_transaction(
+            i2c_address,
+            write_bytes[:serializer.length()],
+            0,
+            timeout=timeout,
+        )
+
+    def get_max929x_register(self, i2c_address, register, timeout=None):
+        if self.skip_i2c:
+            logging.debug("Skip i2c")
+            return
+        write_bytes = bytearray(2)
+        serializer = hololink_module.Serializer(write_bytes)
+        serializer.append_uint16_be(register)
+        read_bytes = self._i2c.i2c_transaction(
+            i2c_address,
+            write_bytes[:serializer.length()],
+            1,
+            timeout=timeout,
+        )
+        deserializer = hololink_module.Deserializer(read_bytes)
+        value = deserializer.next_uint8()
+        return value
+
+    def configure_camera(self, mpsb_mode_set):
+        channel_metadata = hololink_module.Enumerator.find_channel(channel_ip="192.168.0.2")
+        m_gpio = self._hololink.get_gpio(channel_metadata)
+        logging.info("Got GPIO")
+        m_gpio.set_direction(2, m_gpio.OUT)
+        m_gpio.set_value(2, m_gpio.HIGH)
+        logging.info("Set Holoscan GPIO pin 2 to output mode and pulled high")
+        m_gpio.set_direction(3, m_gpio.OUT)
+        m_gpio.set_value(3, m_gpio.LOW)
+        logging.info("Set Holoscan GPIO pin 3 to output mode and pulled low")
+
+        self.set_mode(mpsb_mode_set)
+
+        serdes_list = mpsb_mode.get_max929x_serdes_mpsb()
+        for i2c_addr, reg, val in serdes_list:
+            if (reg == mpsb_mode.MPSB_TABLE_WAIT_MS):
+                time.sleep(val / 1000)
+            else:
+                self.set_max929x_register(i2c_addr, reg, val)
+
+    def set_mode(self, mpsb_mode_set):
+        if mpsb_mode_set.value < len(mpsb_mode.Mpsb_Mode):
+            self._mode = mpsb_mode_set
+            mode = mpsb_mode.mpsb_frame_format[self._mode.value]
+            self._height = mode.height
+            self._width = mode.width
+            self._pixel_format = mode.pixel_format
+        else:
+            logging.error("Incorrect mode for MPSB")
+            self._mode = -1
+
+    def configure_converter(self, converter):
+        logging.debug(
+            f"configure_converter:width={self._width},height={self._height},bpp={self._pixel_format}"
+        )
+        assert self._pixel_format == hololink_module.sensors.csi.PixelFormat.RAW_8
+
+        w = self._width
+        h = self._height
+        converter.configure(
+            0,
+            w * 2,
+            w, h,
+            self._pixel_format,
+        )
+
+    def pixel_format(self):
+        return self._pixel_format
+
+    def bayer_format(self):
+        return hololink_module.sensors.csi.BayerFormat.GRBG
