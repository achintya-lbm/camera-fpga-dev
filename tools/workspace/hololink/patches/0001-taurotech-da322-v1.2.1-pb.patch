+# limitations under the License.
+
+# See README.md for detailed information.
+
+import argparse
+import ctypes
+import logging
+import time
+
+import holoscan
+import cuda.bindings.driver as cuda
+
+import hololink as hololink_module
+
+import gpio
+import utils
+import boards
+
+class App(holoscan.core.Application):
+    def __init__(
+        self,
+        cuda_context,
+        cuda_device_ordinal,
+        hololink_channels,
+        cameras,
+        camera_mode,
+        timeout,
+        headless,
+        width,
+        height,
+        frame_limit,
+        interface,
+        configure_fpga=None, # callable
+    ):
+        super().__init__()
+        self._cuda_context = cuda_context
+        self._cuda_device_ordinal = cuda_device_ordinal
+        self._hololink_channels = hololink_channels
+        self._cameras = cameras
+        self._camera_mode = camera_mode
+        self._timeout = timeout
+        self._headless = headless
+        self._width = width
+        self._height = height
+        self._frame_limit = frame_limit
+        self._interface = interface
+        self._configure_fpga = configure_fpga
+
+        # Because we have stereo camera paths going into the same visualizer, don't
+        # raise an error when each path presents metadata with the same names.
+        self.enable_metadata(True)
+        self.metadata_policy = holoscan.core.MetadataPolicy.REJECT
+
+    def compose(self):
+        metadata = self._hololink_channels[0].enumeration_metadata()
+        interface = self._interface
+        if interface is None:
+            interface = metadata.get("interface")
+        local_ip = metadata.get("interface_address")
+        hsb_ip = metadata.get("client_ip_address")
+        hsb_mac = metadata.get("mac_id")
+        hsb_mac_bytes = list(bytes.fromhex(hsb_mac.replace(":", "")))
+        logging.info("Using AR0234:")
+        logging.info(f"  Interface: {interface}")
+        logging.info(f"  Local IP:  {local_ip}")
+        logging.info(f"  HSB IP:    {hsb_ip}")
+        logging.info(f"  HSB MAC:   {hsb_mac}")
+
+        # Holoviz is used to render the image(s).
+        tensors = []
+        view_width = 1.0 / float(len(self._cameras))
+        for i in range(len(self._cameras)):
+            view = holoscan.operators.HolovizOp.InputSpec.View()
+            view.offset_x = view_width * i
+            view.offset_y = 0
+            view.width = view_width
+            view.height = 1
+            spec = holoscan.operators.HolovizOp.InputSpec(
+                f"{i}", holoscan.operators.HolovizOp.InputType.COLOR
+            )
+            spec.views = [view]
+            tensors.append(spec)
+
+        width = self._width * len(self._cameras)
+        visualizer = holoscan.operators.HolovizOp(
+            self,
+            name="holoviz",
+            headless=self._headless,
+            framebuffer_srgb=True,
+            tensors=tensors,
+            height=self._height,
+            width=width,
+        )
+
+        # Create the capture/conversion pipelines for each sensor.
+        for i in range(len(self._cameras)):
+            if self._frame_limit:
+                condition = holoscan.conditions.CountCondition(
+                    self, name="count", count=self._frame_limit
+                )
+            else:
+                condition = holoscan.conditions.BooleanCondition(
+                    self, name="ok", enable_tick=True
+                )
+
+            self._cameras[i].set_mode(self._camera_mode)
+
+        if self._configure_fpga is not None:
+            self._configure_fpga()
+
+        for i in range(len(self._cameras)):
+            pixel_format = self._cameras[i].pixel_format()
+            bayer_format = self._cameras[i].bayer_format()
+            name = f"{i}"
+
+            # Capture from Fusa.
+            fusa_coe_capture = hololink_module.operators.FusaCoeCaptureOp(
+                self,
+                condition,
+                name=f"fusa_coe_capture_{name}",
+                interface=interface,
+                mac_addr=hsb_mac_bytes,
+                hololink_channel=self._hololink_channels[i],
+                timeout=self._timeout,
+                device=self._cameras[i],
+            )
+            self._cameras[i].configure_converter(fusa_coe_capture)
+
+            # Convert RAW to 16-bit Bayer.
+            csi_to_bayer_pool = holoscan.resources.BlockMemoryPool(
+                self,
+                name=f"csi_to_bayer_pool_{name}",
+                # storage_type of 1 is device memory
+                storage_type=1,
+                block_size=self._cameras[i]._width
+                * ctypes.sizeof(ctypes.c_uint16)
+                * self._cameras[i]._height,
+                num_blocks=2,
+            )
+            csi_to_bayer_operator = hololink_module.operators.CsiToBayerOp(
+                self,
+                name=f"csi_to_bayer_{name}",
+                allocator=csi_to_bayer_pool,
+                cuda_device_ordinal=self._cuda_device_ordinal,
+            )
+            fusa_coe_capture.configure_converter(csi_to_bayer_operator)
+
+            # Perform basic ISP operations.
+            image_processor = hololink_module.operators.ImageProcessorOp(
+                self,
+                name=f"image_processor_{name}",
+                optical_black=0,
+                bayer_format=bayer_format.value,
+                pixel_format=pixel_format.value,
+            )
+
+            # Bayer demosaic to RGBA buffer.
+            rgba_components_per_pixel = 4
+            bayer_demosaic_pool = holoscan.resources.BlockMemoryPool(
+                self,
+                name=f"bayer_demosaic_pool_{name}",
+                # storage_type of 1 is device memory
+                storage_type=1,
+                block_size=self._cameras[i]._width
+                * rgba_components_per_pixel
+                * ctypes.sizeof(ctypes.c_uint16)
+                * self._cameras[i]._height,
+                num_blocks=4,
+            )
+            bayer_demosaic = holoscan.operators.BayerDemosaicOp(
+                self,
+                name=f"bayer_demosaic_{name}",
+                pool=bayer_demosaic_pool,
+                generate_alpha=True,
+                alpha_value=65535,
+                bayer_grid_pos=bayer_format.value,
+                interpolation_mode=0,
+                out_tensor_name=name,
+            )
+
+            self.add_flow(
+                fusa_coe_capture, csi_to_bayer_operator, {("output", "input")}
+            )
+            self.add_flow(
+                csi_to_bayer_operator, image_processor, {("output", "input")}
+            )
+            self.add_flow(image_processor, bayer_demosaic, {("output", "receiver")})
+            self.add_flow(bayer_demosaic, visualizer, {("transmitter", "receivers")})
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    modes = hololink_module.sensors.ar0234.ar0234_mode.Ar0234_Mode
+    mode_choices = [mode.value for mode in modes]
+    parser.add_argument(
+        "--camera-mode",
+        type=int,
+        choices=mode_choices,
+        default=mode_choices[0],
+        help=" ".join([f"{mode.value}:{mode.name}" for mode in modes]),
+    )
+    parser.add_argument(
+        "--frame-limit",
+        type=int,
+        default=None,
+        help="Number of frames to capture",
+    )
+    parser.add_argument(
+        "--timeout",
+        type=int,
+        default=1500,
+        help="Capture request timeout",
+    )
+    parser.add_argument(
+        "--hololink",
+        default="192.168.0.2",
+        help="IP address of Hololink board",
+    )
+    parser.add_argument(
+        "--log-level",
+        type=int,
+        default=20,
+        help="Logging level to display",
+    )
+    parser.add_argument("--headless", action="store_true", help="Run in headless mode")
+    parser.add_argument(
+        "--width",
+        type=int,
+        default=1920,
+        help="Window width (per sensor)",
+    )
+    parser.add_argument(
+        "--height",
+        type=int,
+        default=1080,
+        help="Window height",
+    )
+    parser.add_argument(
+        "--sensor",
+        type=int,
+        choices=[-1, 0, 1],
+        default=0,
+        help="Sensor to use (-1 for stereo)",
+    )
+    parser.add_argument(
+        "--i2c-id",
+        type=int,
+        help="I2C ID the sensor is connected to"
+    )
+    parser.add_argument(
+        "--skip-reset",
+        action="store_true",
+        help="Skip reset (only valid when using one sensor)",
+    )
+    parser.add_argument(
+        "--interface",
+        default=None,
+        help="Ethernet interface",
+    )
+    parser.add_argument("--with-gmsl", action="store_true", help="With GMSL")
+    parser.add_argument(
+        "--channel",
+        type=str,
+        default='A',
+        choices=('A', 'B'),
+        help="GMSL link to communicate with"
+    )
+    parser.add_argument(
+        "--exposure",
+        type=utils.auto_int,
+        default=0x02DC,
+        help="Camera exposure register value"
+    )
+    parser.add_argument(
+        "--pattern",
+        type=utils.auto_int,
+        help="Configure to display a test pattern.",
+    )
+    args = parser.parse_args()
+
+    hololink_module.logging_level(args.log_level)
+
+    if args.i2c_id is None:
+        args.i2c_id = max(0, args.sensor) # sensor can be -1 for stereo
+
+    # Get a handle to the GPU
+    (cu_result,) = cuda.cuInit(0)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+    cu_device_ordinal = 0
+    cu_result, cu_device = cuda.cuDeviceGet(cu_device_ordinal)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+    cu_result, cu_context = cuda.cuDevicePrimaryCtxRetain(cu_device)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+
+    # Get a handle to the Hololink device
+    channel_metadata = hololink_module.Enumerator.find_channel(channel_ip=args.hololink)
+
+    channel_metadatas = []
+    hololink_channels = []
+    if args.sensor == -1:
+        # Create separate channels for each sensor
+        channel_metadatas.append(hololink_module.Metadata(channel_metadata))
+        hololink_module.DataChannel.use_sensor(channel_metadatas[0], 0)
+        hololink_channels.append(hololink_module.DataChannel(channel_metadatas[0]))
+
+        channel_metadatas.append(hololink_module.Metadata(channel_metadata))
+        hololink_module.DataChannel.use_sensor(channel_metadatas[1], 1)
+        hololink_channels.append(hololink_module.DataChannel(channel_metadatas[1]))
+    else:
+        channel_metadatas.append(hololink_module.Metadata(channel_metadata))
+        hololink_module.DataChannel.use_sensor(channel_metadatas[0], args.sensor)
+        hololink_channels.append(hololink_module.DataChannel(channel_metadatas[0]))
+
+    for c in channel_metadatas:
+        logging.debug(f"{c=}")
+
+    # Start the HSB
+    hololink = hololink_channels[0].hololink()
+    hololink.start()
+    try:
+        # Init GPIO
+        _GPIO = hololink.get_gpio(channel_metadata)
+
+        if args.sensor == -1 or not args.skip_reset:
+            hololink.reset()
+
+            # Cycle camera power
+            board_name = channel_metadata["board_description"]
+            power_enable_gpio = gpio.GPIO_PIN_MAP.get(board_name, {}).get(gpio.GPIO_CAM0_PWR_EN_L + args.i2c_id)
+            if power_enable_gpio is not None:
+                utils.enable_camera_power(_GPIO, enable=False, pin=power_enable_gpio)
+                time.sleep(1)
+                utils.enable_camera_power(_GPIO, enable=True, pin=power_enable_gpio)
+                time.sleep(1)
+            else:
+                logging.warning(f"No camera power enable GPIO found for board {board_name} and I2C ID {args.i2c_id}. Camera power cycle skipped")
+
+        # Get handles to the cameras
+        camera_mode = hololink_module.sensors.ar0234.ar0234_mode.Ar0234_Mode(
+            args.camera_mode
+        )
+        cameras = []
+        for i in range(len(hololink_channels)):
+            camera = hololink_module.sensors.ar0234.ar0234.Ar0234Cam(
+                hololink_channels[i],
+                skip_i2c=False,
+                i2c_id=args.i2c_id,
+                expander_configuration=i,
+            )
+
+            camera_with_gmsl = args.with_gmsl
+
+            if i == 0:
+                camera.setup_clock()
+
+                # Configure Camera
+                str_to_link = {
+                    'A': hololink_module.sensors.ar0234.ar0234_mode.GmslLink.LINK_A,
+                    'B': hololink_module.sensors.ar0234.ar0234_mode.GmslLink.LINK_B
+                }
+                logging.info(f"Channel {args.channel} selected")
+
+                camera.configure(
+                    camera_mode,
+                    camera_with_gmsl,
+                    str_to_link[args.channel],
+                )
+                if args.pattern is not None:
+                    camera.test_pattern(args.pattern)
+
+                if camera_with_gmsl:
+                    #camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX96716A_DESER_ADDR, 0x0161, 0x10)
+
+                    camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x0320, 0x20) # vc override
+
+                    camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x031c, 0x00) # vc ov en
+                    camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x031d, 0x00) # vc ov en
+                    camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x031e, 0x00) # vc ov en
+                    camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x031f, 0x00) # vc ov en
+
+                    camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x0314, 0x6b) # dt sel x
+                    camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x0316, 0x40) # dt sel y
+                    camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x0318, 0x6b) # dt sel z
+                    camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x031a, 0x40) # dt sel u
+
+                    #camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x0053, 0x10)
+                    #camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x005B, 0x10)
+
+                    camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX96716A_DESER_ADDR, 0x044B, 0x03) # map_en_l
+
+                    camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX96716A_DESER_ADDR, 0x044D, 0x2b | (0 << 6)) # map_src_0
+                    camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX96716A_DESER_ADDR, 0x044E, 0x2b | (0 << 6)) # map_dst_0
+                    camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX96716A_DESER_ADDR, 0x044F, 0x2b | (2 << 6)) # map_src_1
+                    camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX96716A_DESER_ADDR, 0x0450, 0x2b | (2 << 6)) # map_dst_1
+
+                    camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX96716A_DESER_ADDR, 0x046D, 0x09) # map_dphy_dst
+
+                camera.set_exposure_reg(args.exposure)
+                #camera.set_analog_gain_reg(0x1F)
+
+            # camera.set_digital_gain_reg(4) # No such function
+            cameras.append(camera)
+
+        def configure_fpga():
+            for i in range(len(cameras)):
+                boards.configure_fpga_datatype(
+                    hololink_channels[i],
+                    channel_metadatas[i]["board_description"],
+                    channel_metadatas[i].get("sensor_number", i),
+                    cameras[i].pixel_format(),
+                )
+
+        # Set up the application
+        application = App(
+            cu_context,
+            cu_device_ordinal,
+            hololink_channels,
+            cameras,
+            camera_mode,
+            args.timeout,
+            args.headless,
+            args.width,
+            args.height,
+            args.frame_limit,
+            args.interface,
+            configure_fpga,
+        )
+
+        # Run the application
+        application.run()
+    finally:
+        hololink.stop()
+
+
+if __name__ == "__main__":
+    main()
