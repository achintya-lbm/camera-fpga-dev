+
+
+def print_radar_frame(frame):
+    """Prints the contents of a parsed RadarFrame object from RadarCtrl."""
+    if frame is None:
+        print("Invalid or empty radar frame (None).")
+        return
+
+    h = frame.header
+    print(f"--- Radar Frame #{h.frame_number} ---")
+    print(f"  - Total Packet Length: {h.total_packet_len} bytes")
+    print(f"  - Detected Objects: {h.num_detected_obj}")
+    print(f"  - Number of TLVs: {h.num_tlvs}")
+    print("---------------------------")
+
+    if frame.point_cloud:
+        pc = frame.point_cloud
+        print("  [Point Cloud TLV (Type 301)]")
+        print(f"    - Range Unit: {pc.pc_header.range_unit:.4f}")
+        for i, p in enumerate(pc.points):
+            print(
+                f"      > Point {i:2}: Range={p.range:5}, Doppler={p.doppler:5}, "
+                f"Azimuth={p.azimuth:5}, Elevation={p.elevation:5}, "
+                f"SNR={p.snr:3}"
+            )
+
+    if frame.range_profile:
+        rp = frame.range_profile
+        print("  [Range Profile TLV (Type 302)]")
+        print(f"    - Profile data points: {len(rp.profile)}")
+
+    if frame.stats:
+        stats = frame.stats
+        print("  [Statistics TLV (Type 306)]")
+        print(f"    - Inter-frame Processing Time: {stats.inter_frame_processing_time} us")
+        print(f"    - Transmit Output Time: {stats.transmit_output_time} us")
+        print(f"    - Temperature (Sensor 0): {stats.temp_reading[0]}")
+
+    print("--- End of Frame ---\n")
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument(
+        "--hololink",
+        default="192.168.0.2",
+        help="IP address of Hololink board",
+    )
+    parser.add_argument(
+        "--log-level",
+        type=int,
+        default=1,
+        help="Logging level to display",
+    )
+    parser.add_argument(
+        "--debug",
+        action="store_true",
+        help="Enable debug prints for Radar controller"
+    )
+
+    args = parser.parse_args()
+    hololink_module.logging_level(args.log_level)
+    logging.info("Initializing.")
+
+    # Get a handle to the GPU
+    (cu_result,) = cuda.cuInit(0)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+    cu_device_ordinal = 0
+    cu_result, cu_device = cuda.cuDeviceGet(cu_device_ordinal)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+    cu_result, cu_context = cuda.cuDevicePrimaryCtxRetain(cu_device)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+
+    # Get a handle to the Hololink device
+    channel_metadata = hololink_module.Enumerator.find_channel(channel_ip=args.hololink)
+    logging.info(f"{channel_metadata=}")
+
+    hololink_module.DataChannel.use_sensor(channel_metadata, 2)
+    hololink_channel_radar = hololink_module.DataChannel(channel_metadata)
+    hololink = hololink_channel_radar.hololink()
+
+    # Create MpsbCam to configure SERDES
+    radar_dev = mpsb.mpsb.MpsbCam(hololink_channel_radar)
+
+    # Run it.
+    hololink.start()
+    hololink.reset()
+
+    radar_dev.setup_clock()
+    camera_mode = mpsb.mpsb_mode.Mpsb_Mode.MODE_1920X1080_30FPS
+    radar_dev.configure(camera_mode)
+
+    # Get Hololink interfaces for RadarCtrl
+    i2c = hololink.get_i2c(1)
+    spi = hololink.get_spi(2, chip_select=0, cpol=0, cpha=0, width=1, prescaler=0xF)
+    gpio = hololink.get_gpio(channel_metadata)
+
+    # Instantiate RadarCtrl
+    RadarCtrl = hololink_module.RadarCtrl
+    radar_ctrl = RadarCtrl(i2c, spi, gpio, args.debug)
+    logging.info(f"Instantiated {radar_ctrl}")
+
+    radar_ctrl.init_radar()
+    logging.info("RadarCtrl Init completed")
+
+    if not radar_ctrl.start_radar():
+        raise RuntimeError("Failed to start Radar.")
+    logging.info("RadarCtrl Start completed")
+
+    # Enable radar trigger forwarding
+    radar_dev.configure_gpio_fwd()
+    logging.info("GPIO forwarding configured.")
+
+    # Main loop to get and print data
+    print("\nStreaming Radar data. Press Ctrl+C to stop.")
+    try:
+        while True:
+            frame = radar_ctrl.get_radar_frame()
+            if frame is not None:
+                print_radar_frame(frame)
+            else:
+                logging.warning("Failed to get radar frame (received None).")
+            # Polling delay
+            time.sleep(0.05)
+    except KeyboardInterrupt:
+        print("\nStopping...")
+    finally:
+        radar_ctrl.stop_radar()
+        radar_dev.stop()
+        hololink.stop()
+        (cu_result,) = cuda.cuDevicePrimaryCtxRelease(cu_device)
+        assert cu_result == cuda.CUresult.CUDA_SUCCESS
+        logging.info("Cleanup complete.")
+
+
+if __name__ == "__main__":
+    main()
