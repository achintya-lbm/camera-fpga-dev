@@ -0,0 +1,80 @@
+// Boston Dynamics, Inc. Confidential Information.
+// Copyright 2025. All Rights Reserved.
+#ifndef VL53L8CX_PLATFORM_H_
+#define VL53L8CX_PLATFORM_H_
+
+#include <stdint.h>
+#include "stdbool.h"
+#define VL53L8CX_NB_TARGET_PER_ZONE 1U
+#define VL53L8CX_DFLT_I2C_ADDR 0x29
+
+/**
+ * Defines the platform abstraction layer to support the VL53L8CX sensor API's I2C transactions.
+ * This file declares the low-level functions required by the core sensor driver for I2C
+ * communication, delays, and other hardware-dependent operations. The implementation of these
+ * functions is provided in vl53l8cx_platform.cpp with Holoscan I2C transactions.
+ */
+
+typedef struct {
+    void* hololink_i2c;
+    uint8_t address;
+    uint8_t ser_addr;
+} VL53L8CX_Platform;
+
+enum RetCodes { SUCCESS = 0, MISMATCHED_READ_SIZE = 244, NO_I2C = 255 };
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+void set_debug_state(bool debug_en);
+
+/**
+ * Reads a single byte from the specified register address and returns it in p_value.
+ */
+uint8_t VL53L8CX_RdByte(VL53L8CX_Platform* p_platform, uint16_t RegisterAdress, uint8_t* p_value);
+
+/**
+ * Writes a single byte to the specified register address.
+ */
+uint8_t VL53L8CX_WrByte(VL53L8CX_Platform* p_platform, uint16_t RegisterAdress, uint8_t value);
+
+/**
+ * Reads a byte string of length size starting from the specified register address and returns it in
+ * p_values. If the length of the read exceeds hololink_max_buf_size, read is broken up into chunks
+ * of size at most hololink_max_buf_size. Register addr to read from is incremented by chunk size.
+ */
+uint8_t VL53L8CX_RdMulti(VL53L8CX_Platform* p_platform, uint16_t RegisterAdress, uint8_t* p_values,
+                         uint32_t size);
+
+/**
+ * Writes a byte string of length size from p_values starting at the specified register address. If
+ * the length of the write exceeds hololink_max_buf_size - 2 (accounting for the address part of the
+ * write), write is broken up into chunks of size at most hololink_max_buf_size. Register addr to
+ * write from is incremented by chunk size.
+ */
+uint8_t VL53L8CX_WrMulti(VL53L8CX_Platform* p_platform, uint16_t RegisterAdress, uint8_t* p_values,
+                         uint32_t size);
+
+/**
+ * Resets DToF sensor via GPIO. TODO: implement this once GPIO forwarding is set up
+ */
+uint8_t VL53L8CX_Reset_Sensor(VL53L8CX_Platform* p_platform);
+
+/**
+ * Swaps the endianness of a buffer containing 32-bit words.
+ * This is used to convert data between the sensor's format (big-endian) and the host
+ * processor's format if it differs.
+ */
+void VL53L8CX_SwapBuffer(uint8_t* buffer, uint16_t size);
+
+/**
+ * Pauses full program runtime for ms using usleep(TimeMs * 1000).
+ */
+uint8_t VL53L8CX_WaitMs(VL53L8CX_Platform* p_platform, uint32_t TimeMs);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // VL53L8CX_PLATFORM_H_
diff --git a/src/hololink/core/mpsb/dtof/vl53l8cx_api.c b/src/hololink/core/mpsb/dtof/vl53l8cx_api.c
