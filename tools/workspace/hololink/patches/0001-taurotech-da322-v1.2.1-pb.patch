+std::optional<RadarFrame> RadarCtrl::format_radar_raw_frame(const std::vector<uint8_t>& raw_data)
+{
+    if (raw_data.empty()) {
+        fprintf(stderr, "Input raw_data pointer is null. \n");
+        return std::nullopt;
+    }
+    if (raw_data.size() < sizeof(FrameHeader)) {
+        fprintf(stderr, "Raw data size (%zu) is smaller than a frame header (%zu).\n", raw_data.size(),
+            sizeof(FrameHeader));
+        return std::nullopt;
+    }
+
+    FrameHeader header;
+    memcpy(&header, raw_data.data(), sizeof(FrameHeader));
+
+    RadarFrame parsed_frame = parse_radar_frame(header, raw_data, m_debug);
+    return parsed_frame;
+}
+
+std::optional<RadarFrame> RadarCtrl::get_radar_frame()
+{
+    TotalPktHeader pkt_header = get_total_header(m_spi, m_gpio, m_pin_map, m_debug);
+    printf("Packet header valid. \n");
+
+    std::vector<uint8_t> frame_data;
+    read_spi(m_spi, m_gpio, m_pin_map, pkt_header.length, &frame_data, m_debug);
+    if (frame_data.size() != pkt_header.length) {
+        fprintf(stderr, "Failed to read full frame. Expected %u bytes, recv %zu bytes. ",
+            pkt_header.length, frame_data.size());
+        return std::nullopt;
+    }
+
+    uint8_t calc_crc = calculate_crc8(frame_data.data(), pkt_header.length, 0x00);
+    if (calc_crc != pkt_header.header_crc) {
+        fprintf(stderr, "Payload CRC check failed");
+        return std::nullopt;
+    }
+
+    FrameHeader header = parse_frame_header(frame_data, m_debug);
+    if (std::memcmp(header.magic_word, frame_magic_word.data(),
+            frame_magic_word.size() * sizeof(uint16_t))) {
+        fprintf(stderr,
+            "Frame header magic word mismatch, actual: %04x %04x %04x %04x; expected: "
+            "%04x %04x %04x %04x \n",
+            header.magic_word[0], header.magic_word[1], header.magic_word[2], header.magic_word[3],
+            frame_magic_word.data()[0], frame_magic_word.data()[1], frame_magic_word.data()[2],
+            frame_magic_word.data()[3]);
+        return std::nullopt;
+    }
+
+    std::optional<RadarFrame> formatted_radar_frame = format_radar_raw_frame(frame_data);
+
+    return formatted_radar_frame;
+}
