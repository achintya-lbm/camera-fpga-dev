+    void write_i2c_reg8(std::shared_ptr<hololink::Hololink::I2c> i2c, uint32_t i2c_addr, uint32_t reg,
+        uint8_t to_write, bool debug)
+    {
+        std::vector<uint8_t> write_bytes(16);
+        hololink::core::Serializer serializer(write_bytes.data(), write_bytes.size());
+        serializer.append_uint16_be(reg);
+        serializer.append_uint8(to_write);
+        write_bytes.resize(serializer.length());
+        if (debug) {
+            printf("Write: i2c addr: %04x, reg: %04x, value: %02x \n", i2c_addr, reg, to_write);
+        }
+        i2c->i2c_transaction(i2c_addr, write_bytes, 0);
+    }
+
+    uint8_t read_i2c_reg8(std::shared_ptr<hololink::Hololink::I2c> i2c, const uint32_t i2c_addr,
+        const uint32_t reg, bool debug)
+    {
+        std::vector<uint8_t> write_bytes(2);
+        hololink::core::Serializer serializer(write_bytes.data(), write_bytes.size());
+        serializer.append_uint16_be(reg);
+        std::vector<uint8_t> read_byte = i2c->i2c_transaction(i2c_addr, write_bytes, 1);
+        if (debug) {
+            printf("Read: i2c addr: %04x, reg: %04x, value: %02x \n", i2c_addr, reg,
+                read_byte[0]);
+        }
+        return read_byte[0];
+    }
+
+    bool debouce_radar_ready(std::shared_ptr<hololink::Hololink::I2c> i2c,
+        const uint8_t poll_interval_ms = 1, uint32_t debouce_time_ms = 200, bool debug = false)
+    {
+        uint32_t debouce_time_elapsed_ms = 0;
+        while (static_cast<bool>(read_i2c_reg8(i2c, 0x40, 0x02E8, false) & (1 << 3))) {
+            // while (static_cast<bool>(read_i2c_reg8(i2c, 0x28, 0x02B9, false) & (1 << 4))) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(poll_interval_ms));
+            debouce_time_elapsed_ms += poll_interval_ms;
+            if (debouce_time_elapsed_ms >= debouce_time_ms) {
+                if (debug)
+                    printf("Radar ready stayed high for %u ms. \n", debouce_time_ms);
+                return true;
+            }
+        }
+        if (debug)
+            printf("Radar ready failed debounce, went low %u ms after going high\n", debouce_time_elapsed_ms);
+        return false;
+    }
+
+    bool wait_for_ready(std::shared_ptr<hololink::Hololink::I2c> i2c, uint32_t timeout_ms = 2000, bool debug = false)
+    {
+        uint32_t time_elapsed_ms = 1;
+        const uint32_t poll_interval_ms = 1;
+        const uint32_t debounce_duration_ms = 200;
+
+        while (time_elapsed_ms < timeout_ms) {
+            if (static_cast<bool>(read_i2c_reg8(i2c, 0x40, 0x02E8, false) & (1 << 3))) {
+                // if (static_cast<bool>(read_i2c_reg8(i2c, 0x28, 0x02B9, false) & (1 << 4))) {
+                if (debug)
+                    printf("Radar ready register value: %02x\n", read_i2c_reg8(i2c, 0x40, 0x02E8, false));
+                printf("Radar ready is high after %u ms\n", time_elapsed_ms / poll_interval_ms);
+                if (debouce_radar_ready(i2c, poll_interval_ms, debounce_duration_ms, debug))
+                    return true;
+            } else {
+                std::this_thread::sleep_for(std::chrono::milliseconds(poll_interval_ms));
+                time_elapsed_ms += poll_interval_ms;
+            }
+        }
+        fprintf(stderr, "Radar ready never went high for at least %u ms\n", debounce_duration_ms);
+        if (debug)
+            printf("Radar ready register value: %02x\n", read_i2c_reg8(i2c, 0x28, 0x02B9, false));
+        return false;
+    }
+
+    void hold_radar_reset(std::shared_ptr<hololink::Hololink::I2c> i2c, bool reset,
+        uint32_t reset_hold_time_ms)
+    {
+        if (reset) {
+            write_i2c_reg8(i2c, 0x40, 0x02C7, 0x80, false);
+        } else {
+            write_i2c_reg8(i2c, 0x40, 0x02C7, 0x90, false);
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(reset_hold_time_ms));
+    }
+
+    uint8_t transfer_spi_byte(std::shared_ptr<hololink::Hololink::Spi> spi, const uint8_t tx_byte, bool debug)
+    {
+        std::vector<uint8_t> write_command_byte { tx_byte };
+        std::vector<uint8_t> write_data_byte {};
+        uint32_t read_byte_count = 0;
+        if (debug) {
+            printf("Attempting to transfer byte 0x%02x \n", tx_byte);
+        }
+        std::vector<uint8_t> read_bytes = spi->spi_transaction(write_command_byte, write_data_byte, read_byte_count);
+        if (read_bytes.empty()) {
+            fprintf(stderr, "read_bytes was empty. \n");
+        } else {
+            if (debug) {
+                for (size_t i = 0; i < read_bytes.size(); ++i) {
+                    printf("0x%02X ", static_cast<int>(read_bytes[i]));
+                }
+                printf("\n");
+            }
+        }
+        uint8_t raw_read = read_bytes.empty() ? 0 : read_bytes[0];
+        if (debug) {
+            printf("Byte read 0x%02x \n", raw_read);
+        }
+        return raw_read;
+    }
+
+    void purge_rx_buffer(std::shared_ptr<hololink::Hololink::Spi> spi, std::shared_ptr<hololink::Hololink::GPIO> gpio, RadarGpioPinMap pin_map, bool debug)
+    {
+        const uint8_t max_purge_bytes = 32; // GMSL2 Rx FIFO is 32 bytes.
+        uint8_t purged_byte_count = 0;
+
+        while (gpio->get_value(pin_map.bne)) {
+            if (purged_byte_count >= max_purge_bytes) {
+                fprintf(stderr, "Purged %u bytes but BNE is still high. Aborting purge. \n", max_purge_bytes);
+                break;
+            }
+            transfer_spi_byte(spi, read_data_cmd, debug);
+            purged_byte_count++;
+        }
+        if (purged_byte_count > 0) {
+            printf("Purged %u byte(s) from Rx buffer. \n", purged_byte_count);
+        }
+    }
+
+    void read_spi(std::shared_ptr<hololink::Hololink::Spi> spi, std::shared_ptr<hololink::Hololink::GPIO> gpio, RadarGpioPinMap pin_map,
+        uint32_t num_bytes, std::vector<uint8_t>* result, bool debug)
+    {
+        if (!result) {
+            fprintf(stderr, "Return vector is null\n");
+            return;
+        }
+        result->clear();
+        result->reserve(num_bytes);
+        if (debug) {
+            printf("Desired total read size: %u bytes \n", num_bytes);
+        }
+
+        gpio->set_value(pin_map.ro, 1);
+        if (gpio->get_value(pin_map.bne)) {
+            printf("WARN: BNE high before starting, purging buffer now. \n");
+            purge_rx_buffer(spi, gpio, pin_map, debug);
+        }
+
+        uint32_t bytes_read = 0;
+        while (bytes_read < num_bytes) {
+            uint8_t iter_num_bytes = std::min((uint32_t)max_burst_size, num_bytes - bytes_read);
+            if (debug) {
+                printf("Attempting to read %u bytes. \n", iter_num_bytes);
+            }
+
+            gpio->set_value(pin_map.ro, 1);
+            transfer_spi_byte(spi, assert_ss1_cmd, debug);
+            gpio->set_value(pin_map.ro, 0);
+
+            for (uint8_t i = 0; i < iter_num_bytes; i++) {
+                transfer_spi_byte(spi, 0x00, debug);
+            }
+
+            gpio->set_value(pin_map.ro, 1);
+            result->push_back(transfer_spi_byte(spi, deassert_ss_cmd, debug));
+
+            for (uint8_t i = 0; i < iter_num_bytes - 1; i++) {
+                uint8_t cur_byte = transfer_spi_byte(spi, 0x00, debug);
+                result->push_back(cur_byte);
+            }
+
+            gpio->set_value(pin_map.ro, 0);
+            bytes_read += iter_num_bytes;
+            std::this_thread::sleep_for(std::chrono::microseconds(1));
+        }
+    }
+
+    TotalPktHeader parse_total_header(const std::vector<uint8_t>& header, bool debug)
+    {
+        TotalPktHeader pkt_header = {};
+        if (header.size() != header_size) {
+            fprintf(stderr, "Header is of wrong size. \n");
+            return pkt_header;
+        }
+        pkt_header.magic_num = { header[0], header[1] };
+        pkt_header.data_format = header[2];
+        pkt_header.header_crc = header[3];
+        std::memcpy(&pkt_header.length, &header[4], sizeof(uint32_t));
+        return pkt_header;
+    }
+
+    FrameHeader parse_frame_header(const std::vector<uint8_t>& frame_data, bool debug)
+    {
+        FrameHeader frame_header = {};
+        if (frame_data.size() >= frame_header_size) {
+            std::memcpy(&frame_header, frame_data.data(), sizeof(FrameHeader));
+        }
+        if (debug)
+            printf("Frame header actual magic word: %04x %04x %04x %04x\n",
+                frame_header.magic_word[0], frame_header.magic_word[1],
+                frame_header.magic_word[2], frame_header.magic_word[3]);
+        return frame_header;
+    }
+
+    RadarFrame parse_radar_frame(const FrameHeader frame_header, const std::vector<uint8_t>& frame_data, bool debug)
+    {
+        RadarFrame radar_frame;
+        radar_frame.header = frame_header;
+
+        uint32_t idx = sizeof(FrameHeader);
+
+        for (uint32_t i = 0; i < frame_header.num_tlvs; ++i) {
+            if (idx + 8 > frame_data.size()) {
+                fprintf(stderr, "Not enough data for TLV #%u header. \n", i);
+                break;
+            }
+
+            uint32_t tlv_type, tlv_len;
+            std::memcpy(&tlv_type, frame_data.data() + idx, sizeof(uint32_t));
+            std::memcpy(&tlv_len, frame_data.data() + idx + 4, sizeof(uint32_t));
+            idx += 8;
+
+            if (idx + tlv_len > frame_data.size()) {
+                fprintf(stderr, "TLV #%u claims length of %u but only %zu bytes remain.\n", i, tlv_len,
+                    frame_data.size() - idx);
+                break;
+            }
+
+            switch (tlv_type) {
+            case TlvType::kPointCloud: {
+                PointCloud point_cloud = {};
+                uint32_t pc_idx = idx;
+
+                if (tlv_len < sizeof(PointCloudHeader))
+                    break;
+
+                std::memcpy(&point_cloud.pc_header.xyz_unit, frame_data.data() + pc_idx,
+                    sizeof(float));
+                std::memcpy(&point_cloud.pc_header.doppler_unit, frame_data.data() + pc_idx + 4,
+                    sizeof(float));
+                std::memcpy(&point_cloud.pc_header.snr_unit, frame_data.data() + pc_idx + 8,
+                    sizeof(float));
+                std::memcpy(&point_cloud.pc_header.noise_unit, frame_data.data() + pc_idx + 12,
+                    sizeof(float));
+                std::memcpy(&point_cloud.pc_header.num_detected_point,
+                    frame_data.data() + pc_idx + 16, sizeof(float));
+                std::memcpy(&point_cloud.pc_header.range_unit, frame_data.data() + pc_idx + 20,
+                    sizeof(float));
+                std::memcpy(&point_cloud.pc_header.azimuth_unit, frame_data.data() + pc_idx + 24,
+                    sizeof(float));
+                std::memcpy(&point_cloud.pc_header.elevation_unit, frame_data.data() + pc_idx + 28,
+                    sizeof(float));
+                pc_idx += sizeof(PointCloudHeader);
+
+                uint32_t num_pts = frame_header.num_detected_obj;
+                point_cloud.points.resize(num_pts);
+                for (uint32_t j = 0; j < num_pts; j++) {
+                    if (pc_idx + sizeof(PointCloudData) > idx + tlv_len)
+                        break;
+                    auto& pt = point_cloud.points[j];
+                    std::memcpy(&pt.doppler, frame_data.data() + pc_idx, sizeof(int16_t));
+                    std::memcpy(&pt.snr, frame_data.data() + pc_idx + 2, sizeof(uint8_t));
+                    std::memcpy(&pt.noise, frame_data.data() + pc_idx + 3, sizeof(uint8_t));
+                    std::memcpy(&pt.range, frame_data.data() + pc_idx + 4, sizeof(uint16_t));
+                    std::memcpy(&pt.azimuth, frame_data.data() + pc_idx + 6, sizeof(int16_t));
+                    std::memcpy(&pt.elevation, frame_data.data() + pc_idx + 8, sizeof(int16_t));
+                    pc_idx += sizeof(PointCloudData);
+                }
+
+                radar_frame.point_cloud = point_cloud;
+                break;
+            }
+            case TlvType::kRangeProfile: {
+                RangeProfile range_profile = {};
+                size_t num_elements = tlv_len / sizeof(uint16_t);
+                range_profile.profile.resize(num_elements);
+                std::memcpy(range_profile.profile.data(), frame_data.data() + idx, tlv_len);
+                radar_frame.range_profile = range_profile;
+                break;
+            }
+            case TlvType::kStatsInfo: {
+                if (tlv_len < sizeof(StatsInformation))
+                    break;
+                StatsInformation stats = {};
+                uint32_t stats_idx = idx;
+
+                std::memcpy(&stats.inter_frame_processing_time, frame_data.data() + stats_idx,
+                    sizeof(uint32_t));
+                std::memcpy(&stats.transmit_output_time, frame_data.data() + stats_idx + 4,
+                    sizeof(uint32_t));
+                std::memcpy(&stats.power_measured, frame_data.data() + stats_idx + 8,
+                    sizeof(uint16_t) * 4);
+                std::memcpy(&stats.temp_reading, frame_data.data() + stats_idx + 16,
+                    sizeof(int16_t) * 4);
+
+                radar_frame.stats = stats;
+                break;
+            }
+            default: {
+                printf("WARN: Ignoring unknown TLV of type %u\n", tlv_type);
+                break;
+            }
+            }
+            idx += tlv_len;
+        }
+
+        return radar_frame;
+    }
+
+    bool check_pkt_header_magic_num(TotalPktHeader header, bool debug)
+    {
+        if (header.magic_num != spi_hd_magic_num) {
+            fprintf(stderr, "Header doesn't match magic numbers. Actual: %02x %02x; Expected: %02x %02x\n",
+                header.magic_num[0], header.magic_num[1], spi_hd_magic_num[0], spi_hd_magic_num[1]);
+            return false;
+        }
+        if (debug)
+            printf("Header matches magic numbers.  Actual: %02x %02x; Expected: %02x %02x\n",
+                header.magic_num[0], header.magic_num[1], spi_hd_magic_num[0], spi_hd_magic_num[1]);
+        return true;
+    }
+
+    TotalPktHeader get_total_header(std::shared_ptr<hololink::Hololink::Spi> spi, std::shared_ptr<hololink::Hololink::GPIO> gpio,
+        RadarGpioPinMap pin_map, bool debug)
+    {
+        std::vector<uint8_t> header;
+        read_spi(spi, gpio, pin_map, header_size, &header, debug);
+        if (header.empty()) {
+            throw std::runtime_error("Failed to receive header, erroring out. ");
+        }
+        TotalPktHeader pkt_header = parse_total_header(header, debug);
+        if (!check_pkt_header_magic_num(pkt_header, debug)) {
+            throw std::runtime_error("Total packet header doesn't match magic numbers. \n");
+        }
+        return pkt_header;
+    }
+
+    uint8_t calculate_crc8(const uint8_t* data, const uint32_t length, const uint8_t init_val)
+    {
+        uint8_t crc = init_val;
+        for (uint32_t i = 0; i < length; i++) {
+            crc = crc8_table[(crc ^ data[i]) & 0xFF];
+        }
+        return crc;
+    }
+
