+        (MAX96716A_DESER_ADDR, 0x044A, 0xD0),  # MIPI_TX 1: 4 lanes
+        (MAX96716A_DESER_ADDR, 0x048A, 0xD0),  # MIPI_TX 2: 4 lanes
+        
+        (MAX96716A_DESER_ADDR, 0x1D00, 0xF4),  # PLL2 Reset assert
+        (MAX96716A_DESER_ADDR, 0x1E00, 0xF4),  # PLL3 Reset assert
+        (MAX96716A_DESER_ADDR, 0x0320, 0x2A),  # Set Data rate to 1500Mbps/lane for PHY1
+        (MAX96716A_DESER_ADDR, 0x0323, 0x2A),  # Set Data rate to 1500Mbps/lane for PHY2
+        (MAX96716A_DESER_ADDR, 0x1D00, 0xF5),  # PLL2 Reset deassert
+        (MAX96716A_DESER_ADDR, 0x1E00, 0xF5),  # PLL3 Reset deassert
+
+        (MAX96716A_DESER_ADDR, 0x0332, 0xF4),  # Turn on all PHYs
+        (MAX96716A_DESER_ADDR, 0x0313, 0x02),  # CSI output enabled
