+DEVICE_VERSION_REG          = DEVICE_REG_BASE | 0x0001
+SENSOR_ID_REG               = DEVICE_REG_BASE | 0x0002
+DEVICE_ID_REG               = DEVICE_REG_BASE | 0x0003
+SYSTEM_IDLE_REG             = DEVICE_REG_BASE | 0x0007
