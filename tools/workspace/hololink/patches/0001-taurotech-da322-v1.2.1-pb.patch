+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+# See README.md for detailed information.
+
+#
+# This example displays live AR0234 video from one channel using
+# the Linux socket emulation layer with P1722B COE packets.
+# This program requires at least one command-line argument, which
+# is the name of the network interface to listen to for COE packets.
+# Those messages are sent using L2 messages with a VETH tag of 0xCCC,
+# so to enable reception of those messages, create a new
+# network interface that receives those veth messages:
+#
+#   N0=enP5p3s0f0np0  # Or whatever network you're attached to
+#   # this will be our new VETH specific interface
+#   E0=coe.0
+#   sudo ip link add link $N0 name $E0 type vlan id 3276
+#   sudo ifconfig $E0 up
+#
+# (Common convention is to name the VETH interface as "(device-name).(vlan-id)"
+# but e.g. "enP5p3s0f0np0.2376" exceeds the permissible length of
+# the device name, thus the choice of "coe.0" here.)
+#
+# Once the veth device is running, you can run this example:
+#
+#   python3 examples/linux_coe_ar0234_player.py --coe-interface=$E0
+#
+#
+
+import argparse
+import ctypes
+import datetime
+import logging
+import os
+import time
+
+import cuda.bindings.driver as cuda
+import holoscan
+
+import hololink as hololink_module
+
+import gpio
+import utils
+import boards
+
+MS_PER_SEC = 1000.0
+US_PER_SEC = 1000.0 * MS_PER_SEC
+NS_PER_SEC = 1000.0 * US_PER_SEC
+SEC_PER_NS = 1.0 / NS_PER_SEC
+
+
+def get_timestamp(metadata, name):
+    s = metadata[f"{name}_s"]
+    f = metadata[f"{name}_ns"]
+    f *= SEC_PER_NS
+    return s + f
+
+
+class TimingReportOperator(holoscan.core.Operator):
+    def __init__(
+        self,
+        *args,
+        skip_frames=10,  # Allow the system to settle
+        report_frames=10,  # Show this many timing reports
+        **kwargs,
+    ):
+        super().__init__(*args, **kwargs)
+        self._skip_frames = skip_frames
+        self._report_frames = report_frames
+        self._frames = 0
+
+    def setup(self, spec):
+        logging.info("setup")
+        spec.input("input")
+
+    def compute(self, op_input, op_output, context):
+        # What time is it now?
+        complete_timestamp = datetime.datetime.now(datetime.UTC)
+
+        #
+        _ = op_input.receive("input")
+        self._frames += 1
+        if self._frames < self._skip_frames:
+            return
+        if self._frames >= (self._skip_frames + self._report_frames):
+            return
+
+        # Show the timing for this frame.
+        metadata = self.metadata
+        frame_number = metadata.get("frame_number", 0)
+
+        # frame_start_s is the time that the first data arrived at the FPGA;
+        # the network receiver calls this "timestamp".
+        frame_start_s = get_timestamp(metadata, "timestamp")
+
+        # After the FPGA sends the last sensor data packet for a frame, it follows
+        # that with a 128-byte metadata packet.  This timestamp (which the network
+        # receiver calls "metadata") is the time at which the FPGA sends that
+        # packet; so it's the time immediately after the the last byte of sensor
+        # data in this window.  The difference between frame_start_s and frame_end_s
+        # is how long it took for the sensor to produce enough data for a complete
+        # frame.
+        frame_end_s = get_timestamp(metadata, "metadata")
+
+        # frame_time shows how long it takes for the data to transfer
+        # from the sensor to the FPGA.
+        frame_time = frame_end_s - frame_start_s
+
+        # overall_time is the time the entire pipeline took, from the first
+        # byte arriving at FPGA until after visualization is complete.
+        overall_time = complete_timestamp.timestamp() - frame_start_s
+        logging.info(f"{frame_number=} {frame_time=:.4f} {overall_time=:.4f}")
+
+
+class HoloscanApplication(holoscan.core.Application):
+    def __init__(
+        self,
+        headless,
+        fullscreen,
+        cuda_context,
+        cuda_device_ordinal,
+        hololink_channel,
+        camera,
+        camera_mode,
+        frame_limit,
+        coe_interface,
+        window_height,
+        window_width,
+        window_title,
+        configure_fpga=None, # callable
+    ):
+        logging.info("__init__")
+        super().__init__()
+        self._headless = headless
+        self._fullscreen = fullscreen
+        self._cuda_context = cuda_context
+        self._cuda_device_ordinal = cuda_device_ordinal
+        self._hololink_channel = hololink_channel
+        self._camera = camera
+        self._camera_mode = camera_mode
+        self._frame_limit = frame_limit
+        self._coe_interface = coe_interface
+        self._window_height = window_height
+        self._window_width = window_width
+        self._window_title = window_title
+        self._configure_fpga = configure_fpga
+        # This is a control for HSDK
+        self.is_metadata_enabled = True
+
+    def compose(self):
+        logging.info("compose")
+        if self._frame_limit:
+            self._count = holoscan.conditions.CountCondition(
+                self,
+                name="count",
+                count=self._frame_limit,
+            )
+            condition = self._count
+        else:
+            self._ok = holoscan.conditions.BooleanCondition(
+                self, name="ok", enable_tick=True
+            )
+            condition = self._ok
+        self._camera.set_mode(self._camera_mode)
+
+        if self._configure_fpga is not None:
+            self._configure_fpga()
+
+        csi_to_bayer_pool = holoscan.resources.BlockMemoryPool(
+            self,
+            name="pool",
+            # storage_type of 1 is device memory
+            storage_type=1,
+            block_size=self._camera._width
+            * ctypes.sizeof(ctypes.c_uint16)
+            * self._camera._height,
+            num_blocks=2,
+        )
+        csi_to_bayer_operator = hololink_module.operators.CsiToBayerOp(
+            self,
+            name="csi_to_bayer",
+            allocator=csi_to_bayer_pool,
+            cuda_device_ordinal=self._cuda_device_ordinal,
+        )
+        self._camera.configure_converter(csi_to_bayer_operator)
+
+        frame_size = csi_to_bayer_operator.get_csi_length()
+        frame_context = self._cuda_context
+        # Each camera sharing a network connection must use
+        # a unique channel number from 0..63.
+        coe_channel = 1
+        pixel_width = self._camera._width
+        receiver_operator = hololink_module.operators.LinuxCoeReceiverOp(
+            self,
+            condition,
+            name="receiver",
+            frame_size=frame_size,
+            frame_context=frame_context,
+            hololink_channel=self._hololink_channel,
+            device=self._camera,
+            coe_interface=self._coe_interface,
+            pixel_width=pixel_width,
+            coe_channel=coe_channel,
+        )
+
+        pixel_format = self._camera.pixel_format()
+        bayer_format = self._camera.bayer_format()
+        image_processor_operator = hololink_module.operators.ImageProcessorOp(
+            self,
+            name="image_processor",
+            # Optical black value for ar0234 is 50
+            optical_black=50,
+            bayer_format=bayer_format.value,
+            pixel_format=pixel_format.value,
+        )
+
+        rgba_components_per_pixel = 4
+        bayer_pool = holoscan.resources.BlockMemoryPool(
+            self,
+            name="pool",
+            # storage_type of 1 is device memory
+            storage_type=1,
+            block_size=self._camera._width
+            * rgba_components_per_pixel
+            * ctypes.sizeof(ctypes.c_uint16)
+            * self._camera._height,
+            num_blocks=2,
+        )
+        demosaic = holoscan.operators.BayerDemosaicOp(
+            self,
+            name="demosaic",
+            pool=bayer_pool,
+            generate_alpha=True,
+            alpha_value=65535,
+            bayer_grid_pos=bayer_format.value,
+            interpolation_mode=0,
+        )
+
+        visualizer = holoscan.operators.HolovizOp(
+            self,
+            name="holoviz",
+            framebuffer_srgb=True,
+            fullscreen=self._fullscreen,
+            headless=self._headless,
+            height=self._window_height,
+            width=self._window_width,
+            window_title=self._window_title,
+            enable_camera_pose_output=True,
+            camera_pose_output_type="extrinsics_model",
+        )
+
+        timer = TimingReportOperator(
+            self,
+            name="timer",
+        )
+
+        #
+        self.add_flow(receiver_operator, csi_to_bayer_operator, {("output", "input")})
+        self.add_flow(
+            csi_to_bayer_operator, image_processor_operator, {("output", "input")}
+        )
+        self.add_flow(image_processor_operator, demosaic, {("output", "receiver")})
+        self.add_flow(demosaic, visualizer, {("transmitter", "receivers")})
+        self.add_flow(visualizer, timer, {("camera_pose_output", "input")})
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    modes = hololink_module.sensors.ar0234.ar0234_mode.Ar0234_Mode
+    mode_choices = [mode.value for mode in modes]
+    mode_help = " ".join([f"{mode.value}:{mode.name}" for mode in modes])
+    parser.add_argument(
+        "--camera-mode",
+        type=int,
+        choices=mode_choices,
+        default=mode_choices[0],
+        help=mode_help,
+    )
+    parser.add_argument("--headless", action="store_true", help="Run in headless mode")
+    parser.add_argument(
+        "--fullscreen", action="store_true", help="Run in fullscreen mode"
+    )
+    parser.add_argument(
+        "--frame-limit",
+        type=int,
+        default=None,
+        help="Exit after receiving this many frames",
+    )
+    default_configuration = os.path.join(
+        os.path.dirname(__file__), "example_configuration.yaml"
+    )
+    parser.add_argument(
+        "--configuration",
+        default=default_configuration,
+        help="Configuration file",
+    )
+    parser.add_argument(
+        "--hololink",
+        default="192.168.0.2",
+        help="IP address of Hololink board",
+    )
+    parser.add_argument(
+        "--log-level",
+        type=int,
+        default=20,
+        help="Logging level to display",
+    )
+    parser.add_argument(
+        "--window-height",
+        type=int,
+        default=1080//2,
+        help="Set the height of the displayed window",
+    )
+    parser.add_argument(
+        "--window-width",
+        type=int,
+        default=1920//2,
+        help="Set the width of the displayed window",
+    )
+    parser.add_argument(
+        "--title",
+        default="AR0234",
+        help="Set the window title",
+    )
+    parser.add_argument(
+        "--sensor-id",
+        type=int,
+        default=0,
+        help="MIPI ID the sensor is connected to"
+    )
+    parser.add_argument(
+        "--i2c-id",
+        type=int,
+        help="I2C ID the sensor is connected to"
+    )
+    parser.add_argument("--with-gmsl", action="store_true", help="With GMSL")
+    parser.add_argument(
+        "--channel",
+        type=str,
+        default='A',
+        choices=('A', 'B'),
+        help="GMSL link to communicate with"
+    )
+    parser.add_argument(
+        "--exposure",
+        type=utils.auto_int,
+        default=0x02DC,
+        help="Camera exposure register value"
+    )
+    parser.add_argument(
+        "--coe-interface",
+        required=True,
+        help="Name of interface connected to VETH 3276 (0xCCC).",
+    )
+    parser.add_argument("--skip-setup", action="store_true", help="Skip SerDes and Camera setup")
+    parser.add_argument("--skip-reset", action="store_true", help="Skip hololink reset")
+
+    args = parser.parse_args()
+    hololink_module.logging_level(args.log_level)
+    logging.info("Initializing.")
+
+    if args.i2c_id is None:
+        args.i2c_id = args.sensor_id
+
+    # Get a handle to the GPU
+    (cu_result,) = cuda.cuInit(0)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+    cu_device_ordinal = 0
+    cu_result, cu_device = cuda.cuDeviceGet(cu_device_ordinal)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+    cu_result, cu_context = cuda.cuDevicePrimaryCtxRetain(cu_device)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+    # Get a handle to the Hololink device
+    channel_metadata = hololink_module.Enumerator.find_channel(channel_ip=args.hololink)
+    hololink_module.DataChannel.use_sensor(channel_metadata, args.sensor_id)
+    logging.debug(f"{channel_metadata=}")
+    #
+    hololink_channel = hololink_module.DataChannel(channel_metadata)
+
+    board_name = channel_metadata["board_description"]
+    board = boards.BOARDS.get(board_name)
+    if board is None:
+        logging.error(f"Unsupported board: {board_name}")
+        return
+
+    if args.i2c_id >= board.i2c_count:
+        logging.error(f"I2C ID {args.i2c_id} is invalid for board {board.name} which supports {board.i2c_count} sensors")
+        return
+
+    # Get a handle to the camera
+    camera = hololink_module.sensors.ar0234.ar0234.Ar0234Cam(
+        hololink_channel,
+        skip_i2c=args.skip_setup,
+        i2c_id=args.i2c_id,
+    )
+    camera_mode = hololink_module.sensors.ar0234.ar0234_mode.Ar0234_Mode(
+        args.camera_mode
+    )
+    camera_with_gmsl = args.with_gmsl
+
+    def configure_fpga():
+        boards.configure_fpga_datatype(
+            hololink_channel,
+            channel_metadata["board_description"],
+            args.sensor_id,
+            camera.pixel_format(),
+        )
+
+    # Set up the application
+    application = HoloscanApplication(
+        args.headless,
+        args.fullscreen,
+        cu_context,
+        cu_device_ordinal,
+        hololink_channel,
+        camera,
+        camera_mode,
+        args.frame_limit,
+        args.coe_interface,
+        args.window_height,
+        args.window_width,
+        args.title,
+        configure_fpga,
+    )
+    application.config(args.configuration)
+    # Run it.
+    hololink = hololink_channel.hololink()
+    hololink.start()
+    try:
+        # Init GPIO
+        _GPIO = hololink.get_gpio(channel_metadata)
+
+        if not args.skip_setup:
+            if not args.skip_reset:
+                hololink.reset()
+
+            # Cycle camera power
+            board_name = channel_metadata["board_description"]
+            power_enable_gpio = gpio.GPIO_PIN_MAP.get(board_name, {}).get(gpio.GPIO_CAM0_PWR_EN_L + args.i2c_id)
+            if power_enable_gpio is not None:
+                utils.enable_camera_power(_GPIO, enable=False, pin=power_enable_gpio)
+                time.sleep(1)
+                utils.enable_camera_power(_GPIO, enable=True, pin=power_enable_gpio)
+                time.sleep(1)
+            else:
+                logging.warning(f"No camera power enable GPIO found for board {board_name} and I2C ID {args.i2c_id}. Camera power cycle skipped")
+
+            # Configure Camera
+            str_to_link = {
+                'A': hololink_module.sensors.ar0234.ar0234_mode.GmslLink.LINK_A,
+                'B': hololink_module.sensors.ar0234.ar0234_mode.GmslLink.LINK_B
+            }
+            logging.info(f"Channel {args.channel} selected")
+
+            if not args.skip_reset:
+                camera.setup_clock()
+
+            camera.configure(
+                camera_mode,
+                camera_with_gmsl,
+                str_to_link[args.channel],
+            )
+
+            if camera_with_gmsl:
+                #camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX96716A_DESER_ADDR, 0x0161, 0x10)
+
+                camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x0320, 0x20) # vc override
+
+                camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x031c, 0x00) # vc ov en
+                camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x031d, 0x00) # vc ov en
+                camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x031e, 0x00) # vc ov en
+                camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x031f, 0x00) # vc ov en
+
+                camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x0314, 0x6b) # dt sel x
+                camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x0316, 0x40) # dt sel y
+                camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x0318, 0x6b) # dt sel z
+                camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x031a, 0x40) # dt sel u
+
+                #camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x0053, 0x10)
+                #camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX9295D_SER_ADDR, 0x005B, 0x10)
+
+                camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX96716A_DESER_ADDR, 0x044B, 0x03) # map_en_l
+
+                camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX96716A_DESER_ADDR, 0x044D, 0x2b | (0 << 6)) # map_src_0
+                camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX96716A_DESER_ADDR, 0x044E, 0x2b | (0 << 6)) # map_dst_0
+                camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX96716A_DESER_ADDR, 0x044F, 0x2b | (2 << 6)) # map_src_1
+                camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX96716A_DESER_ADDR, 0x0450, 0x2b | (2 << 6)) # map_dst_1
+
+                camera.set_max929x_register(hololink_module.sensors.ar0234.ar0234_mode.MAX96716A_DESER_ADDR, 0x046D, 0x09) # map_dphy_dst
+
+            camera.set_exposure_reg(args.exposure)
+            #camera.set_analog_gain_reg(0x1F)
+        logging.info("Calling run")
+        application.run()
+    finally:
+        hololink.stop()
+
+    (cu_result,) = cuda.cuDevicePrimaryCtxRelease(cu_device)
+    assert cu_result == cuda.CUresult.CUDA_SUCCESS
+
+
+if __name__ == "__main__":
+    main()
