# -*- mode: bazel -*-
load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
)

# Standalone compiler only (no SPIRV-Tools optimizer, no HLSL front end, no tests).
cmake(
    name = "glslang",
    build_args = ["-j8"],
    cache_entries = {
        "BUILD_EXTERNAL": "OFF",
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_GLSLANG_BINARIES": "ON",
        "ENABLE_HLSL": "OFF",
        "ENABLE_OPT": "OFF",
        "ENABLE_SPVREMAPPER": "OFF",
        "GLSLANG_ENABLE_INSTALL": "ON",
        "GLSLANG_TESTS": "OFF",
    },
    lib_source = ":all_srcs",
    out_binaries = ["glslang"],
    out_static_libs = [],
)

# The compiler executable, usable as a genrule tool: $(execpath @glslang//:glslang_bin).
filegroup(
    name = "glslang_bin",
    srcs = [":glslang"],
    output_group = "glslang",
)
