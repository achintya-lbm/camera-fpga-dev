# Dev container: Holoscan SDK base (CUDA toolkit + SDK at /opt/nvidia/holoscan) plus
# the tools this repo needs. Built and run by tools/dev.sh; see docs/machines.md for
# what the host must provide (NVIDIA driver, container toolkit, ConnectX NIC).
ARG BASE_IMAGE=nvcr.io/nvidia/clara-holoscan/holoscan:v3.9.0-cuda13
FROM ${BASE_IMAGE}

ARG BAZELISK_VERSION=v1.28.1
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git git-lfs patch zip unzip \
        libibverbs-dev rdma-core ibverbs-providers ibverbs-utils librdmacm-dev \
        linuxptp ffmpeg \
        python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /usr/local/bin/bazelisk \
        "https://github.com/bazelbuild/bazelisk/releases/download/${BAZELISK_VERSION}/bazelisk-linux-amd64" \
    && chmod +x /usr/local/bin/bazelisk \
    && ln -sf bazelisk /usr/local/bin/bazel

# Video (NVENC) and compute driver libraries are injected by the container toolkit.
ENV NVIDIA_DRIVER_CAPABILITIES=all
WORKDIR /workspace
