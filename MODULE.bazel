"""camera-fpga-dev: Holoscan Sensor Bridge camera ingest on the Tauro DA322 (see DESIGN.md §11).

Everything builds on the host with `bazel build //...`: the CUDA toolkit, the
Holoscan SDK and all other third-party code are fetched by Bazel. The host only
provides gcc-13, the NVIDIA driver and a few runtime .so packages
(docs/machines.md).
"""

module(
    name = "camera_fpga_dev",
    version = "0.1.0",
    bazel_compatibility = [">=8.0.1"],
)

# NOTE: Keep this list sorted.
bazel_dep(name = "bazel_skylib", version = "1.9.2")

bazel_dep(name = "buildifier_prebuilt", version = "10.0.1", dev_dependency = True)

bazel_dep(name = "cli11", version = "2.5.0")
bazel_dep(name = "concurrentqueue", version = "1.0.4")
bazel_dep(name = "fmt", version = "11.2.0")
bazel_dep(name = "glfw", version = "3.4.0.bcr.3")

bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)

bazel_dep(name = "grpc", version = "1.84.0")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_cuda", version = "0.3.0")
single_version_override(
    module_name = "rules_cuda",
    patch_strip = 1,
    patches = [
        "//tools/workspace/rules_cuda/patches:0001-nvcc-wrapper-device-link-feature.patch",
        "//tools/workspace/rules_cuda/patches:0002-wrapper-device-link-header-inputs.patch",
    ],
    version = "0.3.0",
)

bazel_dep(name = "rules_foreign_cc", version = "0.16.0")
bazel_dep(name = "rules_python", version = "2.3.3")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "spdlog", version = "1.15.3")
bazel_dep(name = "tl-expected", version = "1.1.0")
bazel_dep(name = "vulkan_headers", version = "1.4.349")
bazel_dep(name = "yaml-cpp", version = "0.8.0")

# compile_commands.json for clangd. Upstream hedronvision does not load on
# Bazel 9; this fork does.
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "078ba7675c05bea2666c92d9a8abe200d8547655",
    remote = "https://github.com/helly25/bazel-compile-commands-extractor.git",
)

# --- CUDA (hermetic) ----------------------------------------------------------
# rules_cuda downloads the CUDA redistributable, so machines without a system
# CUDA install still compile .cu files. rules_cuda requires the toolkit repo to
# be named `cuda`. Target architectures are selected in .bazelrc.
cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.redist_json(
    name = "cuda_redist",
    version = "13.0.2",
)
cuda.toolkit(name = "cuda")
use_repo(cuda, "cuda")

# --- Python (tooling and analysis scripts only) -------------------------------
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "py_deps",
    python_version = "3.12",
    requirements_lock = "//tools/py:requirements.lock.txt",
)
use_repo(pip, "py_deps")

# --- Non-BCR dependencies (tools/workspace/<name>/repository.bzl) -------------
camera_fpga_dev_repositories = use_extension(
    "//tools/workspace:default.bzl",
    "camera_fpga_dev_repositories",
)
use_repo(
    camera_fpga_dev_repositories,
    # NOTE: Keep these in alphabetical order.
    "dlpack",
    "eigen",
    "glslang",
    "gxf",
    "holoscan_sdk",
    "hwloc",
    "imgui",
    "magic_enum",
    "nv_codec_headers",
    "nvtx3",
    "rapids_logger",
    "rmm",
    "ucx",
    "ucxx",
)
