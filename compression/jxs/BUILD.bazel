load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Bit-exact JPEG XS (ISO/IEC 21122-1:2024) reference codec, written from the standard
# (compression/docs/jpegxs_part1_notes.md). Golden model for the CUDA decoder and the FPGA encoder.

cc_library(
    name = "bitio",
    hdrs = ["bitio.hpp"],
)

# Annex A marker segments, Annex C precinct/packet headers, Annex B band/precinct/packet geometry.
cc_library(
    name = "codestream",
    srcs = [
        "geometry.cc",
        "headers.cc",
    ],
    hdrs = [
        "geometry.hpp",
        "headers.hpp",
    ],
    deps = [
        ":bitio",
        "@fmt",
    ],
)

# Sample planes and the coefficient containers shared by the entropy and transform layers.
cc_library(
    name = "image",
    hdrs = [
        "coefficients.hpp",
        "image.hpp",
    ],
    deps = [":codestream"],
)

# --- entropy layer (Annex C, D): compression/jxs/entropy.{hpp,cc} ---------------------------------
cc_library(
    name = "entropy",
    srcs = ["entropy.cc"],
    hdrs = ["entropy.hpp"],
    deps = [
        ":bitio",
        ":codestream",
        ":image",
        "@fmt",
    ],
)

cc_test(
    name = "entropy_test",
    size = "small",
    srcs = ["entropy_test.cc"],
    deps = [
        ":entropy",
        "@googletest//:gtest_main",
    ],
)

# --- transform layer (Annex E, F, G): compression/jxs/transform.{hpp,cc} ---------------------------
cc_library(
    name = "transform",
    srcs = ["transform.cc"],
    hdrs = ["transform.hpp"],
    deps = [
        ":codestream",
        ":image",
        "@fmt",
    ],
)

cc_test(
    name = "transform_test",
    size = "small",
    srcs = ["transform_test.cc"],
    deps = [
        ":transform",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "headers_test",
    size = "small",
    srcs = ["headers_test.cc"],
    deps = [
        ":bitio",
        ":codestream",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "geometry_test",
    size = "small",
    srcs = ["geometry_test.cc"],
    deps = [
        ":codestream",
        "@googletest//:gtest_main",
    ],
)

# Prints headers/geometry of a codestream and walks every slice, precinct and packet (structural
# check of the parser against real streams, e.g. from the ISO reference encoder).
cc_binary(
    name = "jxs_info",
    srcs = ["jxs_info.cc"],
    deps = [
        ":codestream",
        "@fmt",
    ],
)

# --- decoder: headers + entropy + transforms -> component planes ---------------------------------
cc_library(
    name = "decoder",
    srcs = ["decoder.cc"],
    hdrs = ["decoder.hpp"],
    deps = [
        ":codestream",
        ":entropy",
        ":image",
        ":transform",
        "@fmt",
    ],
)

cc_binary(
    name = "jxs_decode",
    srcs = ["jxs_decode.cc"],
    deps = [
        ":decoder",
        "@fmt",
    ],
)

# --- encoder: component planes -> codestream, with constant-bit-rate (Q, R) search ------------------
cc_library(
    name = "encoder",
    srcs = ["encoder.cc"],
    hdrs = ["encoder.hpp"],
    deps = [
        ":codestream",
        ":entropy",
        ":image",
        ":transform",
        "@fmt",
    ],
)

cc_test(
    name = "encoder_test",
    size = "medium",
    srcs = ["encoder_test.cc"],
    deps = [
        ":decoder",
        ":encoder",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "jxs_encode",
    srcs = ["jxs_encode.cc"],
    deps = [
        ":decoder",
        ":encoder",
        "@fmt",
    ],
)
